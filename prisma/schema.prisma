  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkRecordStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

/// One global NESTO identity. Role, company and department live on the
/// membership, never here (PRD #8 §13).
model User {
  id        String @id @default(cuid())
  firstName String
  lastName  String

  /// The login identifier (PRD #50 §6, §7). Stored already normalised:
  /// trimmed, NFKC, lowercased. Unique across the platform.
  username String @unique

  /// Contact metadata, not an identifier (PRD #50 §66, §67). Nothing
  /// authenticates by it and no flow requires it to be present.
  email String? @unique

  passwordHash               String
  /// When the hash was last set, for rotation policy (PRD #50 §11, §15).
  passwordChangedAt          DateTime  @default(now())
  /// Set by an administrator's reset; the holder may do nothing else until
  /// they choose a password of their own (PRD #50 §16, §17, §270).
  mustChangePassword         Boolean   @default(false)
  /// A temporary password stops working at this moment, whether or not it
  /// was used (PRD #50 §17).
  temporaryPasswordExpiresAt DateTime?

  phone       String?
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  memberships         CompanyMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]

  /// The person this login belongs to (E-06 §26, E-08 §60). One login, one person;
  /// a person may exist long before, or without, a login.
  personProfileId String?        @unique
  personProfile   PersonProfile? @relation(fields: [personProfileId], references: [id], onDelete: Restrict)

  platformAccess          PlatformAccess?
  parentGroupMemberships  ParentGroupMember[]
  departmentAssignments   DepartmentAssignment[]
  accessGrants            AccessGrant[]             @relation("AccessGrantHolder")
  provisionedFromRequests UserProvisioningRequest[] @relation("ProvisionedUser")

  createdActivities Activity[] @relation("ActivityActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Company {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  legalName          String?
  /// A company is the employing legal entity (E-01 §7, §28; ADR 0002): its
  /// registration and tax numbers sit beside its legal name.
  registrationNumber String?
  taxNumber          String?
  logoUrl            String?
  industry           String?
  country            String?
  address            String?
  email              String?
  phone              String?
  website            String?
  status             CompanyStatus @default(ACTIVE)

  /// The business root this company belongs to (E-06 §3.1, §9). Exactly one in
  /// V0.1, and never changed: it is part of the company's isolation boundary.
  parentGroupId String
  parentGroup   ParentGroup @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)

  /// Bumped on every configuration mutation so caches and client context can
  /// be invalidated without guessing (PRD #37 §22, PRD #24 §315-§317).
  configVersion Int @default(1)

  memberships CompanyMember[]
  invites     CompanyInvite[]
  departments Department[]
  modules     CompanyModule[]
  owners      CompanyOwner[]

  projects                 Project[]
  projectMedia             ProjectMedia[]
  projectTypes             ProjectType[]
  projectUnitTypes         ProjectUnitType[]
  projectBuildings         ProjectBuilding[]
  projectFloors            ProjectFloor[]
  projectUnits             ProjectUnit[]
  project3DEntitlements    Project3DEntitlement[]
  project3DConfigs         Project3DConfig[]
  project3DModelSlots      Project3DModelSlot[]
  project3DModelVersions   Project3DModelVersion[]
  project3DUnitBindings    Project3DUnitMeshBinding[]
  project3DReleases        Project3DRelease[]
  unitPublicationApprovals UnitPublicationApproval[]
  unitSaleApprovals        UnitSaleApproval[]
  clients                  Client[]
  contacts                 Contact[]
  tasks                    Task[]
  documents                Document[]
  activities               Activity[]

  settings            CompanySettings?
  integrationSettings CompanyIntegrationSettings?
  storageQuota        CompanyStorageQuota?
  storageUsage        CompanyStorageUsage?
  uploadSessions      DocumentUploadSession[]
  numberingSchemes    CompanyNumberingScheme[]

  financeSettings            FinanceSettings?
  invoices                   Invoice[]
  expenses                   Expense[]
  payments                   Payment[]
  projectBudgets             ProjectBudget[]
  commitments                Commitment[]
  financeApprovals           FinanceApproval[]
  employeeProfiles           EmployeeProfile[]
  compensations              Compensation[]
  employmentAssignments      EmploymentAssignment[]
  employmentStatusHistory    EmploymentStatusHistory[]
  employmentChanges          EmploymentChange[]
  leaveRequests              LeaveRequest[]
  leaveBalances              LeaveBalance[]
  attendanceRecords          AttendanceRecord[]
  // E-04: the workforce — trades, crews, where people work, and people imported in bulk.
  workforceTrades            WorkforceTrade[]
  workforceCrews             WorkforceCrew[]
  workforceCrewMembers       WorkforceCrewMember[]
  employeeProjectAssignments EmployeeProjectAssignment[]
  projectSites               ProjectSite[]
  hseInductions              HseInduction[]
  employeeImportBatches      EmployeeImportBatch[]
  // E-02: employee documents as HR files them, and the qualifications recorded here.
  employeeDocumentLinks      EmployeeDocumentLink[]
  personQualifications       PersonQualification[]
  leads                      Lead[]
  opportunities              Opportunity[]
  proposals                  Proposal[]
  salesApprovals             SalesApproval[]
  contracts                  Contract[]
  contractParties            ContractParty[]
  contractObligations        ContractObligation[]
  contractAmendments         ContractAmendment[]
  contractApprovals          ContractApproval[]
  suppliers                  Supplier[]
  purchaseRequests           PurchaseRequest[]
  purchaseOrders             PurchaseOrder[]
  rfqs                       RFQ[]
  supplierQuotes             SupplierQuote[]
  goodsReceipts              GoodsReceipt[]
  procurementApprovals       ProcurementApproval[]
  inventoryItems             InventoryItem[]
  warehouses                 Warehouse[]
  inventoryLocations         InventoryLocation[]
  inventoryBalances          InventoryBalance[]
  stockMovements             StockMovement[]
  inventoryReceipts          InventoryReceipt[]
  stockIssues                StockIssue[]
  stockReturns               StockReturn[]
  stockTransfers             StockTransfer[]
  stockAdjustments           StockAdjustment[]
  stockReservations          StockReservation[]
  qualityRecords             QualityRecord[]
  hseRecords                 HseRecord[]
  supportRequests            SupportRequest[]

  inspectionRequests          InspectionRequest[]
  inspectionTemplates         InspectionTemplate[]
  qualityInspections          QualityInspection[]
  materialInspectionDecisions MaterialInspectionDecision[]
  qualityMaterialReleases     QualityMaterialRelease[]
  qualityDefects              QualityDefect[]
  nonConformanceReports       NonConformanceReport[]
  correctiveActions           CorrectiveAction[]
  qualityApprovals            QualityApproval[]

  hseInspectionTemplates    HseInspectionTemplate[]
  hseInspections            HseInspection[]
  hseHazards                HseHazard[]
  hseIncidents              HseIncident[]
  hseRiskAssessments        HseRiskAssessment[]
  hseActions                HseAction[]
  toolboxTalks              ToolboxTalk[]
  hseWorkPermits            HseWorkPermit[]
  ppeChecks                 PpeCheck[]
  environmentalObservations EnvironmentalObservation[]
  stopWorkRecords           StopWorkRecord[]
  hseApprovals              HseApproval[]

  sessions            Session[]
  authEvents          AuthEvent[]
  auditEvents         AuditEvent[]
  integrationLinks    IntegrationLink[]
  integrationAttempts IntegrationAttempt[]

  notifications      Notification[]
  attentionItems     AttentionItem[]
  notificationOutbox NotificationEventOutbox[]
  jobIdempotencyKeys JobIdempotencyKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents             CalendarEvent[]
  calendarEventParticipants  CalendarEventParticipant[]
  calendarReminders          CalendarReminder[]
  calendarReminderDeliveries CalendarReminderDelivery[]
  meetings                   Meeting[]
  meetingSeries              MeetingSeries[]
  meetingParticipants        MeetingParticipant[]
  meetingAgendaItems         MeetingAgendaItem[]
  meetingMinutesSections     MeetingMinutesSection[]
  meetingDecisions           MeetingDecision[]
  meetingActionItems         MeetingActionItem[]
  approvalSteps              ApprovalStep[]
  approvalDelegations        ApprovalDelegation[]
  approvalDecisionReceipts   ApprovalDecisionReceipt[]
  timesheets                 Timesheet[]
  workLogs                   WorkLog[]
  timesheetApprovals         TimesheetApproval[]
  timesheetSettings          TimesheetSettings?
  timesheetApprovers         TimesheetApproverAssignment[]
  procurementApprovalPolicy  ProcurementApprovalPolicy?
  dailyLogs                  DailyLog[]
  dailyLogSettings           DailyLogSettings?
  projectPhases              ProjectPhase[]
  projectMilestones          ProjectMilestone[]
  projectPlanningSettings    ProjectPlanningSettings?
  announcements              Announcement[]
  userFavorites              UserFavorite[]
  recentItems                RecentItem[]
  productivitySettings       ProductivitySettings?
  contractorProfiles         ContractorProfile[]
  contractorAssignments      ProjectContractorAssignment[]
  workPackages               WorkPackage[]
  engineeringDocuments       EngineeringDocument[]
  rfis                       Rfi[]
  technicalSubmittals        TechnicalSubmittal[]
  documentTransmittals       DocumentTransmittal[]
  engineeringSettings        EngineeringSettings?

  departmentAssignments DepartmentAssignment[]
  provisioningRequests  UserProvisioningRequest[]
  candidateTargets      CandidateProfile[]

  @@unique([id, parentGroupId])
  @@index([status])
  @@index([name])
  @@index([parentGroupId])
  @@map("companies")
}

model Department {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  key              String?
  description      String?
  managerMemberId  String?
  status           DepartmentStatus  @default(ACTIVE)
  /// Restore returns the department to the status it held (PRD #14 §125).
  preArchiveStatus DepartmentStatus?

  createdBy  String?
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members       CompanyMember[] @relation("DepartmentMembers")
  announcements Announcement[]

  managerMember CompanyMember? @relation("DepartmentManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  /// The group department this is the company's branch of (E-06 §12, §36). Every
  /// department created from E-06 on has one; the service refuses a branch whose
  /// group department belongs to another parent group (§12 invariant).
  groupDepartmentId String?
  groupDepartment   GroupDepartment? @relation(fields: [groupDepartmentId], references: [id], onDelete: Restrict)

  assignments           DepartmentAssignment[]
  provisioningRequests  UserProvisioningRequest[]
  candidateTargets      CandidateProfile[]
  /// Employments whose current department this is, and the history rows that name it (E-03).
  employeeProfiles      EmployeeProfile[]         @relation("EmployeeProfileDepartment")
  employmentAssignments EmploymentAssignment[]    @relation("EmploymentAssignmentDepartment")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[]

  calendarEvents CalendarEvent[]
  meetings       Meeting[]

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@unique([id, companyId])
  /// One branch per group department and company (E-13 §16): activating again
  /// reuses it, deactivating keeps it.
  @@unique([groupDepartmentId, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([groupDepartmentId])
  @@index([managerMemberId])
  @@index([status])
  @@map("departments")
}

/// One of the 16 predefined V0.1 roles. Stored as a row rather than an enum so
/// company-specific roles can be added later without a migration (PRD #5 §45).
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  members      CompanyMember[]
  permissions  RolePermission[]
  moduleAccess RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  scope        DataScope?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  route       String       @unique
  status      ModuleStatus @default(ACTIVE)

  companyModules CompanyModule[]
  roleAccess     RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

/// The simplified role × module matrix. Combined with RolePermission and
/// CompanyModule it produces the final module context (PRD #6 §129A).
model RoleModuleAccess {
  id          String      @id @default(cuid())
  roleId      String
  moduleId    String
  accessLevel AccessLevel
  scope       DataScope

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
  @@map("role_module_access")
}

/// A module switched off here is unavailable regardless of role (PRD #7 §59).
model CompanyModule {
  id        String  @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

/// The centre of NESTO: user + company + role + department. This is what makes
/// the same person an Architect in one company and a PM in another (PRD #8 §14).
model CompanyMember {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  roleId       String
  departmentId String?
  jobTitle     String?
  status       MembershipStatus @default(ACTIVE)

  /// Bumped whenever role, department, project membership or status changes,
  /// so permission-sensitive caches key off it (PRD #37 §32-§34, PRD #31 §104).
  accessVersion Int @default(1)

  /// Membership lifecycle. Who invited them, when they accepted, and who
  /// removed their access — the questions asked after the fact (PRD #14 §12).
  invitedAt             DateTime?
  invitedByMemberId     String?
  joinedAt              DateTime?
  deactivatedAt         DateTime?
  deactivatedByMemberId String?

  archivedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  managedDepartments Department[]    @relation("DepartmentManager")
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]

  uploadedDocuments Document[]              @relation("DocumentUploadedBy")
  uploadSessions    DocumentUploadSession[] @relation("UploadSessionMember")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreatorMember")

  // Collaboration (PRD #38 §23-§27)
  authoredComments           Comment[]      @relation("CommentAuthor")
  mentions                   Mention[]      @relation("MentionedMember")
  collaborationSubscriptions Subscription[] @relation("SubscriptionMember")

  activityActions Activity[] @relation("ActivityActorMember")

  employeeProfile              EmployeeProfile?       @relation("EmployeeProfileMember")
  managedEmployeeProfiles      EmployeeProfile[]      @relation("EmployeeProfileManager")
  managedEmploymentAssignments EmploymentAssignment[] @relation("EmploymentAssignmentManager")
  ownedLeads                   Lead[]                 @relation("LeadOwner")
  ownedOpportunities           Opportunity[]          @relation("OpportunityOwner")
  ownedContracts               Contract[]             @relation("ContractOwner")

  responsibleContractObligations ContractObligation[] @relation("ContractObligationResponsible")

  requestedPurchases PurchaseRequest[] @relation("PurchaseRequestRequester")
  ownedPurchases     PurchaseRequest[] @relation("PurchaseRequestOwner")
  goodsReceived      GoodsReceipt[]    @relation("GoodsReceiptReceiver")
  qualityRecords     QualityRecord[]   @relation("QualityAssignee")
  hseRecords         HseRecord[]       @relation("HseAssignee")
  supportRequests    SupportRequest[]  @relation("SupportRequester")

  requestedInspections       InspectionRequest[]      @relation("InspectionRequester")
  assignedInspectionRequests InspectionRequest[]      @relation("InspectionRequestInspector")
  assignedInspections        QualityInspection[]      @relation("QualityInspector")
  executedInspections        QualityInspection[]      @relation("QualityInspectionExecutor")
  materialReleases           QualityMaterialRelease[] @relation("QualityReleaser")
  assignedDefects            QualityDefect[]          @relation("QualityDefectAssignee")
  assignedNcrs               NonConformanceReport[]   @relation("NcrAssignee")
  ownedNcrs                  NonConformanceReport[]   @relation("NcrOwner")
  assignedCorrectiveActions  CorrectiveAction[]       @relation("CorrectiveActionAssignee")
  submittedQualityApprovals  QualityApproval[]        @relation("QualityApprovalSubmitter")
  decidedQualityApprovals    QualityApproval[]        @relation("QualityApprovalDecider")

  assignedHseInspections HseInspection[]            @relation("HseInspector")
  executedHseInspections HseInspection[]            @relation("HseInspectionExecutor")
  reportedHazards        HseHazard[]                @relation("HseHazardReporter")
  assignedHazards        HseHazard[]                @relation("HseHazardAssignee")
  reportedIncidents      HseIncident[]              @relation("HseIncidentReporter")
  investigatedIncidents  HseIncident[]              @relation("HseIncidentInvestigator")
  ownedRiskAssessments   HseRiskAssessment[]        @relation("HseRiskAssessmentOwner")
  assignedHseActions     HseAction[]                @relation("HseActionAssignee")
  conductedToolboxTalks  ToolboxTalk[]              @relation("ToolboxConductor")
  toolboxAttendances     ToolboxTalkParticipant[]   @relation("ToolboxParticipant")
  requestedPermits       HseWorkPermit[]            @relation("HsePermitRequester")
  responsiblePermits     HseWorkPermit[]            @relation("HsePermitResponsible")
  performedPpeChecks     PpeCheck[]                 @relation("PpeChecker")
  subjectPpeChecks       PpeCheck[]                 @relation("PpeSubject")
  conductedInductions    HseInduction[]             @relation("HseInductionConductor")
  reportedObservations   EnvironmentalObservation[] @relation("EnvObservationReporter")
  assignedObservations   EnvironmentalObservation[] @relation("EnvObservationAssignee")
  issuedStopWorks        StopWorkRecord[]           @relation("StopWorkIssuer")
  releasedStopWorks      StopWorkRecord[]           @relation("StopWorkReleaser")
  submittedHseApprovals  HseApproval[]              @relation("HseApprovalSubmitter")
  decidedHseApprovals    HseApproval[]              @relation("HseApprovalDecider")

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEventsCreated       CalendarEvent[]               @relation("CalendarEventCreator")
  calendarParticipations      CalendarEventParticipant[]    @relation("CalendarParticipant")
  calendarReminders           CalendarReminder[]            @relation("CalendarReminderMember")
  meetingsOrganized           Meeting[]                     @relation("MeetingOrganizer")
  meetingParticipations       MeetingParticipant[]          @relation("MeetingParticipant")
  meetingActionItemsOwned     MeetingActionItem[]           @relation("MeetingActionOwner")
  meetingAgendaPresenting     MeetingAgendaItem[]           @relation("MeetingAgendaPresenter")
  approvalDelegationsGiven    ApprovalDelegation[]          @relation("ApprovalDelegationFrom")
  approvalDelegationsReceived ApprovalDelegation[]          @relation("ApprovalDelegationTo")
  timesheets                  Timesheet[]                   @relation("TimesheetMember")
  workLogs                    WorkLog[]                     @relation("WorkLogMember")
  timesheetApproverFor        TimesheetApproverAssignment[] @relation("TimesheetApproverMember")
  timesheetApprover           TimesheetApproverAssignment?  @relation("TimesheetApproverSubject")

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// Parent group, organization and people (E-06)
//
// The parent group is the business root; companies stay the hard data-isolation
// boundary underneath it. CompanyMember remains the identity every
// company-owned record is written by (E-06 §15, §160) — what is added here sits
// above it: who belongs to the group, which department position they hold, what
// was delegated to them, and the person behind a login.
// ---------------------------------------------------------------------------

model ParentGroup {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  legalName          String?
  /// The group's own registration number (the NIPT in Albania) and city (D-01
  /// §4), beside its companies' own (E-01, ADR 0002).
  registrationNumber String?
  city               String?
  country            String?
  timezone           String?
  currency           String?
  logoUrl            String?
  status             ParentGroupStatus @default(IMPLEMENTING)
  /// A deterministic test tenant: kept out of the Platform Admin's group list and
  /// the demo sign-in screen (E-06 §45, §150). Never set outside the seed.
  isTestFixture      Boolean           @default(false)
  /// A demonstration tenant (D-01 §68, §69): real public facts beside synthetic
  /// operational data, so every page says so. Set by a demo seed, never a form.
  isDemo             Boolean           @default(false)

  activatedAt       DateTime?
  activatedByUserId String?

  companies             Company[]
  members               ParentGroupMember[]
  departments           GroupDepartment[]
  departmentAssignments DepartmentAssignment[]
  accessGrants          AccessGrant[]
  people                PersonProfile[]
  candidates            CandidateProfile[]
  provisioningRequests  UserProvisioningRequest[]
  auditEvents           AuditEvent[]
  companyHoldings       CompanyOwner[]
  demoRecords           DemoRecord[]
  qualifications        PersonQualification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("parent_groups")
}

/// A person who belongs to the group itself (E-06 §10): the Owner, Group IT,
/// group department heads and anyone working across companies.
model ParentGroupMember {
  id            String           @id @default(cuid())
  parentGroupId String
  userId        String
  status        MembershipStatus @default(ACTIVE)
  joinedAt      DateTime?

  parentGroup ParentGroup @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentGroupId, userId])
  @@index([userId])
  @@map("parent_group_members")
}

/// Who owns a company, and how much (D-01 §6): the parent group itself, or
/// anybody else by name. Kept on the company, read in its settings; not a
/// governance module. Shares are percentages, each above 0 and at most 100.
model CompanyOwner {
  id                  String    @id @default(cuid())
  companyId           String
  /// Set when the holder is a parent group — normally the company's own.
  holderParentGroupId String?
  holderName          String
  holderTaxNumber     String?
  sharePercent        Decimal   @db.Decimal(5, 2)
  since               DateTime? @db.Date

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  holderParentGroup ParentGroup? @relation(fields: [holderParentGroupId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([holderParentGroupId])
  @@map("company_owners")
}

/// Where a demonstration tenant's facts come from (D-01 §2, §3, §73, §107).
///
/// A demo seed writes one row per record it seeds under a stable key
/// (`ARMAAR:PROJECT:TIRANA_LAKE`): the key makes a rerun reuse the record rather
/// than duplicate it, and the source says whether the record is public fact,
/// synthetic demo data or inferred — per field where it is mixed. Nothing in the
/// product reads it to decide anything; `verify:demo` does, and nothing is
/// shown as verified that is not.
model DemoRecord {
  id               String         @id @default(cuid())
  key              String         @unique
  parentGroupId    String
  entityType       String
  entityId         String
  sourceType       DemoSourceType
  /// Field → source, for a record mixing public and synthetic values.
  fieldSources     Json?
  sourceLabel      String?
  sourceUrl        String?
  sourceVerifiedAt DateTime?
  note             String?

  parentGroup ParentGroup @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([parentGroupId, sourceType])
  @@map("demo_records")
}

/// One of the group's functions — Finance, Architecture, HR (E-06 §11). Defined
/// once per group; each company's `Department` is a branch of one (§12), made by
/// activating the function in that company (E-13 §17).
///
/// `key` is the function's permanent identity: the chart in
/// `config/group-departments.ts` binds a key to the roles that may hold its
/// positions and the modules it owns. A department the group adds itself gets a
/// `custom-` key, binds no role, and its positions widen nothing (E-13 ADR 0003).
/// `code` is the short name people read (FIN, HR), unique in the group (E-13 §10).
model GroupDepartment {
  id              String           @id @default(cuid())
  parentGroupId   String
  key             String
  code            String
  name            String
  description     String?
  status          DepartmentStatus @default(ACTIVE)
  createdByUserId String?

  parentGroup ParentGroup            @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  branches    Department[]
  assignments DepartmentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentGroupId, key])
  @@unique([parentGroupId, code])
  @@unique([parentGroupId, name])
  @@unique([id, parentGroupId])
  @@index([parentGroupId, status])
  @@map("group_departments")
}

/// A person's position in a department (E-06 §13, §14). A group head has no
/// company; a company manager or member names the company and its branch. One
/// user may hold several at once — head of Group Finance and manager of Company
/// C Finance is two rows for the same user, never two users (§14, §51).
///
/// The composite keys make the database refuse an assignment whose company or
/// group department belongs to another parent group, and a branch that belongs
/// to another company.
///
/// Since E-13 the row is the whole of a person's organizational participation:
/// a MEMBER row per branch they work in (several companies = several rows), a
/// COMPANY_MANAGER row for the one manager a branch may have, a GROUP_HEAD row
/// for the one head a group department may have — the last two enforced by
/// partial unique indexes (migration `20260918160000_department_management_e13`).
/// A membership's home branch (`CompanyMember.departmentId`) always has its
/// MEMBER row. Ending an assignment keeps it as history.
model DepartmentAssignment {
  id                  String                  @id @default(cuid())
  parentGroupId       String
  userId              String
  groupDepartmentId   String
  companyId           String?
  companyDepartmentId String?
  /// The role this position is held with (E-06 §6.5): a Finance head is FINANCE
  /// + GROUP_HEAD. Position elevation applies only where the membership's role is
  /// this role.
  functionalRoleKey   String
  positionLevel       DepartmentPositionLevel
  accessLevel         AccessLevel
  status              MembershipStatus        @default(ACTIVE)
  startsAt            DateTime?
  endsAt              DateTime?
  endedByUserId       String?
  createdByUserId     String?

  parentGroup       ParentGroup     @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupDepartment   GroupDepartment @relation(fields: [groupDepartmentId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  company           Company?        @relation(fields: [companyId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  companyDepartment Department?     @relation(fields: [companyDepartmentId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([parentGroupId, groupDepartmentId, positionLevel])
  @@index([companyId, positionLevel])
  @@index([companyDepartmentId])
  @@map("department_assignments")
}

/// Access delegated to one person beyond their role (E-06 §18). Nobody may grant
/// more than they hold (the grant ceiling, checked when it is made). Revoked or
/// expired grants stay as history.
model AccessGrant {
  id              String          @id @default(cuid())
  userId          String
  parentGroupId   String
  /// The module the grant is about, as a module key (`finance`, `contracts`).
  functionKey     String?
  scopeType       AccessScopeType
  scopeId         String?
  accessLevel     AccessLevel
  grantedByUserId String
  startsAt        DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  reason          String?

  user        User        @relation("AccessGrantHolder", fields: [userId], references: [id], onDelete: Restrict)
  parentGroup ParentGroup @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentGroupId])
  @@index([parentGroupId, scopeType, scopeId])
  @@map("access_grants")
}

/// Platform-level access, outside every parent group (E-06 §19). Never a company
/// membership: the Platform Admin implements a group without becoming part of it.
model PlatformAccess {
  id      String           @id @default(cuid())
  userId  String           @unique
  roleKey String
  status  MembershipStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_access")
}

/// A named capability whose effective state can be narrowed at platform,
/// group, company or user level. Tenant code resolves this registry; it never
/// reads a client-provided switch (Platform Admin PRD §39-§40, §94).
model FeatureFlag {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String?
  defaultState    FeatureFlagState @default(OFF)
  archivedAt      DateTime?
  createdByUserId String
  updatedByUserId String

  overrides FeatureFlagOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
  @@map("feature_flags")
}

/// `scopeId` is `platform` for PLATFORM and the canonical record id for every
/// other level. The service verifies the target before writing the override.
model FeatureFlagOverride {
  id              String               @id @default(cuid())
  featureFlagId   String
  scopeType       FeatureFlagScopeType
  scopeId         String
  state           FeatureFlagState
  reason          String?
  updatedByUserId String

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([featureFlagId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("feature_flag_overrides")
}

/// Platform-wide configuration. Values are typed and validated by the service
/// for their category; JSON keeps the registry extensible without tenant copy
/// tables (Platform Admin PRD §74-§80, §90).
model PlatformSetting {
  key             String  @id
  category        String
  value           Json
  updatedByUserId String
  reason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("platform_settings")
}

/// Explicit, expiring permission to inspect sensitive tenant data for a stated
/// support reason. It is separate from ordinary platform authority (§5, §67).
model SupportAccessSession {
  id              String    @id @default(cuid())
  actorUserId     String
  parentGroupId   String?
  companyId       String?
  projectId       String?
  targetUserId    String?
  reason          String
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorUserId, expiresAt])
  @@index([parentGroupId])
  @@index([companyId])
  @@map("support_access_sessions")
}

/// Platform-owned authoring configuration bound to the one canonical Project.
/// Tenant users receive only the published projection, never this record.
model ThreeDProjectConfiguration {
  id                 String              @id @default(cuid())
  projectId          String              @unique
  status             ThreeDProjectStatus @default(DRAFT)
  sceneConfiguration Json?
  publishedVersionId String?
  createdByUserId    String
  updatedByUserId    String
  publishedAt        DateTime?

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions ThreeDModelVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("three_d_project_configurations")
}

model ThreeDModelVersion {
  id              String            @id @default(cuid())
  configurationId String
  version         Int
  name            String
  sourceFileName  String?
  storageKey      String?
  checksum        String?
  status          ThreeDModelStatus @default(UPLOADED)
  diagnostics     Json?
  createdByUserId String
  publishedAt     DateTime?

  configuration ThreeDProjectConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configurationId, version])
  @@index([status])
  @@map("three_d_model_versions")
}

/// Platform-granted access to the 3D capability for one canonical Project.
/// It does not make the Company viewer available without an active release.
model Project3DEntitlement {
  id                  String                     @id @default(cuid())
  companyId           String
  projectId           String                     @unique
  status              Project3DEntitlementStatus @default(INACTIVE)
  planKey             String?
  viewerEnabled       Boolean                    @default(true)
  activatedAt         DateTime?
  expiresAt           DateTime?
  provisionedByUserId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, companyId])
  @@index([companyId, status])
  @@index([status, expiresAt])
  @@map("project_3d_entitlements")
}

/// The one versioned authoring document for a Project. `activeReleaseId` is
/// the only pointer the Company viewer follows; draft edits never change it.
model Project3DConfig {
  id                String  @id @default(cuid())
  companyId         String
  projectId         String  @unique
  schemaVersion     Int     @default(1)
  authoringDocument Json
  activeReleaseId   String? @unique
  updatedByUserId   String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)

  activeRelease Project3DRelease?    @relation("Project3DActiveRelease", fields: [activeReleaseId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  slots         Project3DModelSlot[]
  releases      Project3DRelease[]   @relation("Project3DConfigReleases")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, projectId, companyId])
  @@unique([projectId, companyId])
  @@unique([activeReleaseId, projectId, companyId])
  @@index([companyId])
  @@map("project_3d_configs")
}

/// A named model role in a Project. Detail slots may be transformed relative
/// to another slot, but both stay within the same Project configuration.
model Project3DModelSlot {
  id                    String                 @id @default(cuid())
  companyId             String
  projectId             String
  configId              String
  kind                  Project3DModelSlotKind @default(DETAIL)
  role                  Project3DModelSlotRole
  slotKey               String
  displayName           String
  sortOrder             Int                    @default(0)
  isActive              Boolean                @default(true)
  transformParentSlotId String?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  config  Project3DConfig @relation(fields: [configId, projectId, companyId], references: [id, projectId, companyId], onDelete: Cascade)

  transformParent   Project3DModelSlot?     @relation("Project3DSlotTransformParent", fields: [transformParentSlotId], references: [id], onDelete: Restrict)
  transformChildren Project3DModelSlot[]    @relation("Project3DSlotTransformParent")
  versions          Project3DModelVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slotKey])
  @@unique([id, projectId, companyId])
  @@index([companyId, projectId, isActive])
  @@index([configId, sortOrder])
  @@map("project_3d_model_slots")
}

/// One immutable source upload and its separately generated runtime object.
/// Processing may advance state and diagnostics; source bytes are never overwritten.
model Project3DModelVersion {
  id                    String                      @id @default(cuid())
  companyId             String
  projectId             String
  slotId                String
  version               Int
  originalFileName      String
  sourceStorageKey      String                      @unique
  runtimeStorageKey     String?                     @unique
  storageProvider       String
  sourceSizeBytes       BigInt
  runtimeSizeBytes      BigInt?
  sourceContentType     String
  runtimeContentType    String?
  sourceChecksum        String?
  runtimeChecksum       String?
  scale                 Float                       @default(1)
  rotationDeg           Float                       @default(0)
  altitudeOffset        Float                       @default(0)
  positionX             Float                       @default(0)
  positionZ             Float                       @default(0)
  rotationXDeg          Float                       @default(0)
  rotationZDeg          Float                       @default(0)
  visible               Boolean                     @default(true)
  castShadow            Boolean                     @default(true)
  receiveShadow         Boolean                     @default(true)
  selectable            Boolean                     @default(true)
  transformLocked       Boolean                     @default(false)
  validationStatus      Project3DValidationStatus   @default(PENDING)
  validationIssues      Json?
  processingDiagnostics Json?
  triangleCount         Int?
  meshCount             Int?
  materialCount         Int?
  textureCount          Int?
  unitNodeNames         Json?
  sceneManifest         Json?
  nodeOverrides         Json?
  experienceSnapshot    Json?
  status                Project3DModelVersionStatus @default(DRAFT)
  uploadedByUserId      String
  publishedByUserId     String?
  publishedAt           DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?

  company Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  slot    Project3DModelSlot @relation(fields: [slotId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  unitBindings Project3DUnitMeshBinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, version])
  @@unique([id, projectId, companyId])
  @@index([companyId, projectId, status])
  @@index([slotId, status])
  @@index([validationStatus])
  @@map("project_3d_model_versions")
}

/// A mesh in one model version mapped to the one canonical NESTO ProjectUnit.
/// Composite foreign keys make cross-Project and cross-Company binding invalid.
model Project3DUnitMeshBinding {
  id                  String                     @id @default(cuid())
  companyId           String
  projectId           String
  modelVersionId      String
  projectUnitId       String
  meshName            String
  mappingStatus       Project3DUnitMappingStatus @default(MAPPED)
  poiYawDeg           Float                      @default(0)
  poiEnabled          Boolean                    @default(true)
  poiDistanceOverride Float?
  poiHeightOverride   Float?
  mappedByUserId      String
  mappedAt            DateTime                   @default(now())

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      Project               @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  modelVersion Project3DModelVersion @relation(fields: [modelVersionId, projectId, companyId], references: [id, projectId, companyId], onDelete: Cascade)
  projectUnit  ProjectUnit           @relation(fields: [projectUnitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelVersionId, meshName])
  @@unique([modelVersionId, projectUnitId])
  @@index([companyId, projectId])
  @@index([projectUnitId])
  @@map("project_3d_unit_mesh_bindings")
}

/// An immutable Company-viewer snapshot. Activating or rolling back only moves
/// Project3DConfig.activeReleaseId; it never rewrites this manifest or snapshot.
model Project3DRelease {
  id                 String                 @id @default(cuid())
  companyId          String
  projectId          String
  configId           String
  releaseNumber      Int
  schemaVersion      Int                    @default(1)
  experienceSnapshot Json
  manifest           Json
  manifestHash       String
  status             Project3DReleaseStatus @default(PUBLISHED)
  publishedByUserId  String
  publishedAt        DateTime               @default(now())
  activatedAt        DateTime               @default(now())
  supersededAt       DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  config          Project3DConfig  @relation("Project3DConfigReleases", fields: [configId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  activeForConfig Project3DConfig? @relation("Project3DActiveRelease")

  createdAt DateTime @default(now())

  @@unique([projectId, releaseNumber])
  @@unique([id, projectId, companyId])
  @@index([companyId, projectId, publishedAt])
  @@index([configId])
  @@map("project_3d_releases")
}

/// Reusable, Platform-global environment values used by the Experience Editor.
model Platform3DEnvironmentPreset {
  id              String  @id @default(cuid())
  key             String  @unique
  name            String
  schemaVersion   Int     @default(1)
  configuration   Json
  isActive        Boolean @default(true)
  createdByUserId String
  updatedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
  @@map("platform_3d_environment_presets")
}

/// The person, before and apart from any login (E-06 §22, E-08 §3, §57). HR's
/// record of a human being in the group: a candidate is one, an employee is one,
/// and so is someone who never signs in. A login links to exactly one.
///
/// Work contact is what colleagues may see; personal contact, birth date and
/// address are HR-private (E-08 §30).
model PersonProfile {
  id                 String                @id @default(cuid())
  parentGroupId      String
  firstName          String
  lastName           String
  preferredName      String?
  jobTitle           String?
  workEmail          String?
  workPhone          String?
  /// The work profile a colleague reads (E-01 §14, §18; ADR 0002). The person
  /// keeps the bio, the extension and where to find them; HR keeps the rest.
  workPhoneExtension String?
  officeLocation     String?
  professionalBio    String?
  personalEmail      String?
  personalPhone      String?
  dateOfBirth        DateTime?
  address            String?
  city               String?
  country            String?
  lifecycleStatus    PersonLifecycleStatus @default(CANDIDATE)
  createdByUserId    String?
  /// The profile photo (E-08 §43, §93): the person's, across the group, so it is
  /// not a company document. The object sits under `people/<group>/<person>/`;
  /// the checksum names the version, so a changed photo is a new URL.
  photoStorageKey    String?
  photoContentType   String?
  photoChecksum      String?
  photoSizeBytes     Int?
  photoUpdatedAt     DateTime?

  parentGroup          ParentGroup               @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  user                 User?
  candidacies          CandidateProfile[]
  employments          EmployeeProfile[]
  provisioningRequests UserProvisioningRequest[]
  /// Skills, diplomas, licences and certificates — the person's, across the group (E-02).
  qualifications       PersonQualification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, parentGroupId])
  @@index([parentGroupId, lastName, firstName])
  @@index([parentGroupId, lifecycleStatus])
  @@index([workEmail])
  @@map("person_profiles")
}

/// One recruitment of a person (E-06 §23). The person record is kept when the
/// candidate is selected or rejected; a later application is another candidacy.
model CandidateProfile {
  id                  String          @id @default(cuid())
  parentGroupId       String
  personProfileId     String
  targetCompanyId     String?
  targetDepartmentId  String?
  targetRoleKey       String?
  targetJobTitle      String?
  hiringManagerUserId String?
  status              CandidateStatus @default(INTERVIEWING)
  interviewStage      String?
  /// Recruitment notes are HR-private (E-08 §30).
  notes               String?
  decidedAt           DateTime?
  decidedByUserId     String?
  createdByUserId     String

  parentGroup      ParentGroup   @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  person           PersonProfile @relation(fields: [personProfileId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  targetCompany    Company?      @relation(fields: [targetCompanyId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  targetDepartment Department?   @relation(fields: [targetDepartmentId, targetCompanyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentGroupId, status])
  @@index([personProfileId])
  @@index([targetCompanyId, status])
  @@map("candidate_profiles")
}

/// HR asking Group IT for a NESTO account for somebody HR already knows
/// (E-06 §27-§29). Everything Group IT needs is read from here and from the
/// person; Group IT enters only technical account fields.
model UserProvisioningRequest {
  id                      String             @id @default(cuid())
  parentGroupId           String
  personProfileId         String
  employeeProfileId       String?
  companyId               String
  companyDepartmentId     String
  functionalRoleKey       String
  jobTitle                String?
  managerUserId           String?
  requestedUsername       String?
  requestedActivationDate DateTime?
  notes                   String?
  status                  ProvisioningStatus @default(DRAFT)

  requestedByUserId   String
  submittedAt         DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  startedByUserId     String?
  startedAt           DateTime?
  returnedByUserId    String?
  returnedAt          DateTime?
  returnReason        String?
  rejectedByUserId    String?
  rejectedAt          DateTime?
  /// Why the request was refused, shown to HR on the request (E-06 §28).
  rejectionReason     String?
  cancelledAt         DateTime?
  provisionedUserId   String?
  provisionedByUserId String?
  provisionedAt       DateTime?

  parentGroup       ParentGroup      @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  person            PersonProfile    @relation(fields: [personProfileId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  employeeProfile   EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)
  company           Company          @relation(fields: [companyId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  companyDepartment Department       @relation(fields: [companyDepartmentId, companyId], references: [id, companyId], onDelete: Restrict)
  provisionedUser   User?            @relation("ProvisionedUser", fields: [provisionedUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentGroupId, status])
  @@index([companyId, status])
  @@index([personProfileId])
  @@map("user_provisioning_requests")
}

// ---------------------------------------------------------------------------
// Core business objects
// ---------------------------------------------------------------------------

model Project {
  id                     String           @id @default(cuid())
  companyId              String
  code                   String
  name                   String
  description            String?
  clientId               String?
  projectManagerMemberId String?
  status                 ProjectStatus    @default(PENDING)
  /// Status the project held before archiving, so Restore returns it there
  /// rather than always to ACTIVE (PRD #10 §68).
  preArchiveStatus       ProjectStatus?
  priority               ProjectPriority?
  startDate              DateTime?
  endDate                DateTime?
  address                String?
  city                   String?
  country                String?
  /// One of the company's own project types (E-05A §30, §62).
  projectTypeId          String?
  /// The built area the project publishes, in m² (D-01 §16, §18) — a fact about
  /// the project, not the sum of its units' areas.
  builtArea              Decimal?         @db.Decimal(12, 2)
  /// Shown among the key projects on the group's dashboard (D-01 §31).
  isKeyProject           Boolean          @default(false)
  /// The one canonical cover render. The document keeps its own file and its own
  /// access rules; the project only points at it (E-05A §8).
  coverImageDocumentId   String?
  /// When meaningful work last touched the project — any activity recorded
  /// against it — as opposed to `updatedAt`, which an administrative edit also
  /// moves (E-05A §15). Written by the activity recorder, never by a form.
  lastActivityAt         DateTime         @default(now())

  /// Planning (PRD #44 §76, §310): a locked baseline moves only with the company's planning authority.
  planningBaselineLocked Boolean @default(false)
  /// The planning template this project's plan was started from, if any.
  planningTemplateKey    String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  coverImage Document? @relation("ProjectCoverImage", fields: [coverImageDocumentId], references: [id], onDelete: SetNull)

  /// A type in use cannot be deleted, only deactivated (E-05A §62).
  projectType ProjectType? @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)

  projectManager CompanyMember? @relation("ProjectManager", fields: [projectManagerMemberId], references: [id], onDelete: SetNull)

  members   ProjectMember[]
  tasks     Task[]
  documents Document[]      @relation("DocumentProject")
  media     ProjectMedia[]

  invoices          Invoice[]
  expenses          Expense[]
  payments          Payment[]          @relation("PaymentProject")
  budgets           ProjectBudget[]
  commitments       Commitment[]
  contracts         Contract[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  rfqs              RFQ[]
  goodsReceipts     GoodsReceipt[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  stockIssues       StockIssue[]
  stockReturns      StockReturn[]
  stockReservations StockReservation[]
  qualityRecords    QualityRecord[]
  hseRecords        HseRecord[]

  inspectionRequests InspectionRequest[]
  qualityInspections QualityInspection[]
  qualityDefects     QualityDefect[]

  hseInspections            HseInspection[]
  hseHazards                HseHazard[]
  hseIncidents              HseIncident[]
  hseRiskAssessments        HseRiskAssessment[]
  hseActions                HseAction[]
  toolboxTalks              ToolboxTalk[]
  hseWorkPermits            HseWorkPermit[]
  ppeChecks                 PpeCheck[]
  environmentalObservations EnvironmentalObservation[]
  stopWorkRecords           StopWorkRecord[]
  nonConformanceReports     NonConformanceReport[]
  correctiveActions         CorrectiveAction[]

  sourceOpportunities Opportunity[] @relation("OpportunityConvertedProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents         CalendarEvent[]
  meetings               Meeting[]
  meetingSeries          MeetingSeries[]
  workLogs               WorkLog[]
  dailyLogs              DailyLog[]
  threeDConfiguration    ThreeDProjectConfiguration?
  project3DEntitlement   Project3DEntitlement?
  project3DConfig        Project3DConfig?
  project3DModelSlots    Project3DModelSlot[]
  project3DModelVersions Project3DModelVersion[]
  project3DUnitBindings  Project3DUnitMeshBinding[]
  project3DReleases      Project3DRelease[]
  dailyLogSettings       ProjectDailyLogSettings?
  phases                 ProjectPhase[]
  milestones             ProjectMilestone[]
  /// The physical structure: buildings, their floors, the units on them (E-05B §3).
  buildings              ProjectBuilding[]
  /// Where on the ground the work happens (E-04 §38): a project with none is its own single site.
  sites                  ProjectSite[]
  // E-04: who works here, in which crews, and what was recorded on site.
  workforceCrews         WorkforceCrew[]
  workforceAssignments   EmployeeProjectAssignment[]
  attendanceRecords      AttendanceRecord[]
  hseInductions          HseInduction[]
  floors                 ProjectFloor[]
  units                  ProjectUnit[]
  announcements          Announcement[]

  contractorAssignments ProjectContractorAssignment[]
  workPackages          WorkPackage[]
  engineeringDocuments  EngineeringDocument[]
  rfis                  Rfi[]
  technicalSubmittals   TechnicalSubmittal[]
  documentTransmittals  DocumentTransmittal[]

  @@unique([companyId, code])
  /// The target of the structure tables' composite keys (E-05B §69, §79): a
  /// building, floor or unit can only name a project of its own company.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, lastActivityAt])
  @@index([status, lastActivityAt])
  @@index([coverImageDocumentId])
  @@index([projectTypeId])
  @@index([clientId])
  @@index([projectManagerMemberId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@map("projects")
}

/// A render or animation presented by the Project workspace. Files remain in
/// Documents and are referenced here, so setting a cover, featuring, ordering
/// or removing media never duplicates or deletes the stored object.
model ProjectMedia {
  id                  String                 @id @default(cuid())
  companyId           String
  projectId           String
  documentId          String
  type                ProjectMediaType
  title               String
  description         String?
  thumbnailDocumentId String?
  durationSeconds     Int?
  sortOrder           Int                    @default(0)
  isCover             Boolean                @default(false)
  isFeatured          Boolean                @default(false)
  visibility          ProjectMediaVisibility @default(PROJECT)
  createdByMemberId   String

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project           Project   @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  document          Document  @relation("ProjectMediaDocument", fields: [documentId], references: [id], onDelete: Restrict)
  thumbnailDocument Document? @relation("ProjectMediaThumbnail", fields: [thumbnailDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, documentId])
  @@index([companyId, projectId, type, sortOrder])
  @@index([documentId])
  @@index([thumbnailDocumentId])
  @@map("project_media")
}

/// A company's project types (E-05A §30, §62).
///
/// A list the company keeps rather than a construction-only enum: NESTO is
/// meant to run more than construction firms. Every company starts with the
/// defaults in `config/project-types.ts` and renames, adds, orders and retires
/// its own. A type projects use is deactivated, never deleted, so no project
/// loses the type it was given.
model ProjectType {
  id        String  @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdBy String?
  updatedBy String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isActive, sortOrder])
  @@map("project_types")
}

/// A company's unit types (E-05B §20, §21).
///
/// A list the company keeps, like its project types, starting from the defaults
/// in `config/unit-types.ts`. The category decides which technical fields a
/// unit of the type is expected to carry. A type units use is retired, never
/// deleted: existing units keep it, new ones cannot choose it (§116).
model ProjectUnitType {
  id        String           @id @default(cuid())
  companyId String
  name      String
  /// Short, stable, upper-case identifier (`APARTMENT`) — what an import maps to (§97).
  code      String
  category  UnitTypeCategory @default(OTHER)
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)

  createdBy String?
  updatedBy String?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  units   ProjectUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  /// The target of the units' composite key: a unit's type is its own company's.
  @@unique([id, companyId])
  @@index([companyId, isActive, sortOrder])
  @@map("project_unit_types")
}

/// A building on a project (E-05B §7-§10). Every unit belongs to one, even on a
/// single-building project: there is no shortcut past this row (§7).
model ProjectBuilding {
  id          String  @id @default(cuid())
  companyId   String
  projectId   String
  name        String
  /// The name folded for comparison (trim, NFKC, upper case), unique per project (§9, §113).
  nameKey     String
  code        String?
  codeKey     String?
  description String?
  sortOrder   Int
  isActive    Boolean @default(true)
  /// Optimistic concurrency: an edit names the version it read (§95).
  version     Int     @default(1)

  createdBy String
  updatedBy String?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project        @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  floors  ProjectFloor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The target of the floors' composite key, so a floor's project is its building's.
  @@unique([id, projectId])
  @@unique([projectId, nameKey])
  @@unique([projectId, codeKey])
  @@index([companyId, projectId, sortOrder])
  @@map("project_buildings")
}

/// A floor of one building (E-05B §11-§15).
///
/// `projectId` is derived from the building and held to it by the composite
/// foreign key; nothing edits it. `floorKey` is the floor's identity inside its
/// building — level type and number, or level type and name when it has no
/// number — so Floor 9 exists once per building and once in every building (§14).
model ProjectFloor {
  id          String         @id @default(cuid())
  companyId   String
  projectId   String
  buildingId  String
  number      Int?
  name        String
  levelType   FloorLevelType
  floorKey    String
  sortOrder   Int
  /// Metres above the project datum (§11).
  elevation   Decimal?       @db.Decimal(10, 2)
  description String?
  isActive    Boolean        @default(true)
  version     Int            @default(1)

  createdBy String
  updatedBy String?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  building ProjectBuilding @relation(fields: [buildingId, projectId], references: [id, projectId], onDelete: Restrict)
  units    ProjectUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The target of the units' composite key, so a unit's project is its floor's.
  @@unique([id, projectId])
  @@unique([buildingId, floorKey])
  @@index([buildingId, sortOrder])
  @@index([companyId, projectId])
  @@map("project_floors")
}

/// A place a project's work happens (E-04 §38, §172): a plot, a compound, a
/// second building site. Optional — a project without any is its own single
/// site — and archived rather than deleted once anything refers to it.
model ProjectSite {
  id         String            @id @default(cuid())
  companyId  String
  projectId  String
  name       String
  code       String?
  address    String?
  city       String?
  notes      String?
  status     ProjectSiteStatus @default(ACTIVE)
  archivedAt DateTime?

  createdByMemberId String?
  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)

  crews             WorkforceCrew[]
  assignments       EmployeeProjectAssignment[]
  attendanceRecords AttendanceRecord[]
  inductions        HseInduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@unique([id, companyId])
  @@index([companyId, projectId, status])
  @@map("project_sites")
}

/// The one canonical unit (E-05B §2, §16-§30).
///
/// Sales, Finance, Documents and the 3D explorer reference this row by `id`;
/// none of them keeps a unit of its own. The id survives a rename, a new code
/// and a move to another floor (§83). `projectId` is derived from the floor —
/// held to it by the composite key — so the unit code can be unique per
/// project in the database (§68, §69). Areas are square metres, exact decimals (§23, §73).
model ProjectUnit {
  id          String  @id @default(cuid())
  companyId   String
  projectId   String
  floorId     String
  unitCode    String
  /// The code folded for comparison (trim, NFKC, upper case): `a-901` is `A-901` (§112).
  unitCodeKey String
  name        String?
  unitTypeId  String

  position    UnitPosition?
  orientation UnitOrientation?

  internalArea         Decimal? @db.Decimal(12, 2)
  grossArea            Decimal? @db.Decimal(12, 2)
  saleableArea         Decimal? @db.Decimal(12, 2)
  outdoorArea          Decimal? @db.Decimal(12, 2)
  balconyArea          Decimal? @db.Decimal(12, 2)
  terraceArea          Decimal? @db.Decimal(12, 2)
  gardenArea           Decimal? @db.Decimal(12, 2)
  commonAreaAllocation Decimal? @db.Decimal(12, 2)

  rooms     Int?
  bedrooms  Int?
  bathrooms Int?

  /// The few type-specific details with no column of their own — covered and
  /// EV-ready parking, a shop's frontage and ceiling height (§22, §71). A fixed
  /// schema validates it; nothing searchable lives here.
  attributes  Json?
  description String?
  sortOrder   Int
  isActive    Boolean @default(true)
  version     Int     @default(1)

  createdBy String
  updatedBy String?

  /// Publishing (E-05D §13-§31). `currentPublicationId` points at the version
  /// downstream modules read; `hasUnpublishedChanges` says the live unit has moved
  /// on from it (§27, §28). The status moves only by the `unit_publication` machine.
  publicationStatus           UnitPublicationStatus  @default(DRAFT)
  preArchivePublicationStatus UnitPublicationStatus?
  publicationStatusChangedAt  DateTime?
  currentPublicationId        String?                @unique
  hasUnpublishedChanges       Boolean                @default(false)
  /// The last "revision required" reason, until the unit is published again (§22).
  revisionReason              String?
  /// The one logical Sales Plan (§33-§36, §78): a canonical Document whose new
  /// uploads are versions of it, never a second document.
  salesPlanDocumentId         String?                @unique

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  floor    ProjectFloor    @relation(fields: [floorId, projectId], references: [id, projectId], onDelete: Restrict)
  unitType ProjectUnitType @relation(fields: [unitTypeId, companyId], references: [id, companyId], onDelete: Restrict)

  currentPublication    UnitPublication?              @relation("UnitCurrentPublication", fields: [currentPublicationId, id], references: [id, unitId], onDelete: Restrict)
  salesPlanDocument     Document?                     @relation("UnitSalesPlan", fields: [salesPlanDocumentId], references: [id], onDelete: Restrict)
  publications          UnitPublication[]             @relation("UnitPublications")
  media                 UnitMedia[]
  documentLinks         UnitDocumentLink[]
  // Sales (E-05E): its commercial profile, prices, reservations and deals — all keyed by this id.
  commercialProfile     UnitCommercialProfile?
  priceHistory          UnitPriceHistory[]
  reservations          UnitReservation[]
  opportunityLinks      OpportunityUnit[]
  commercialStatusTrail UnitCommercialStatusHistory[]
  // Legal and Finance (E-05F): the contracts holding it and Sales' requests for one.
  contractLinks         ContractUnit[]
  contractRequests      UnitContractRequest[]
  threeDMeshBindings    Project3DUnitMeshBinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, unitCodeKey])
  @@unique([id, projectId, companyId])
  @@index([floorId, sortOrder])
  @@index([companyId, projectId])
  @@index([unitTypeId])
  @@index([projectId, saleableArea])
  @@index([projectId, internalArea])
  @@index([projectId, orientation])
  @@index([projectId, publicationStatus])
  @@map("project_units")
}

/// A published version of a unit (E-05D §24-§26, §72-§74). Written once and
/// never updated: what Sales, 3D and external publishing were shown on that day,
/// with the exact Sales Plan version and primary image. Not a second unit — it
/// holds the approved facts, and `unitId` is still the identity.
model UnitPublication {
  id            String @id @default(cuid())
  companyId     String
  projectId     String
  unitId        String
  versionNumber Int

  publishedAt         DateTime @default(now())
  publishedByMemberId String

  /// Publish-relevant data only (§73): code, name, type, building and floor,
  /// areas, counts, orientation, position, attributes, technical notes.
  snapshot Json

  salesPlanDocumentId           String?
  salesPlanDocumentVersionId    String?
  primaryMediaDocumentId        String?
  primaryMediaDocumentVersionId String?

  unit      ProjectUnit   @relation("UnitPublications", fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  currentOf ProjectUnit[] @relation("UnitCurrentPublication")

  createdAt DateTime @default(now())

  @@unique([unitId, versionNumber])
  @@unique([id, unitId])
  @@index([unitId, publishedAt])
  @@index([companyId, projectId])
  @@map("unit_publications")
}

/// An image of a unit (E-05D §40-§44, §75, §76): a reference to a canonical
/// Document, ordered, at most one primary per unit (a partial unique index).
model UnitMedia {
  id         String            @id @default(cuid())
  companyId  String
  projectId  String
  unitId     String
  documentId String
  category   UnitMediaCategory
  caption    String?
  isPrimary  Boolean           @default(false)
  sortOrder  Int               @default(0)

  createdByMemberId String

  unit     ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  document Document    @relation("UnitMediaDocument", fields: [documentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, documentId])
  @@index([unitId, sortOrder])
  @@index([documentId])
  @@map("unit_media")
}

/// A canonical Document attached to a unit (E-05D §37-§39, §77). The file is
/// never copied: one document may be referenced by many units.
model UnitDocumentLink {
  id         String               @id @default(cuid())
  companyId  String
  projectId  String
  unitId     String
  documentId String
  category   UnitDocumentCategory

  createdByMemberId String

  unit     ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  document Document    @relation("UnitDocumentLinkDocument", fields: [documentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([unitId, documentId])
  @@index([unitId, category])
  @@index([documentId])
  @@map("unit_document_links")
}

/// A request to approve a unit's sale, when the company's Sold rule is Manual
/// approval (E-05F §42). One row per submission, read by the Approvals Center;
/// an approval belongs to the reservation it was asked for, so a new reservation
/// needs a new one. A partial unique index keeps one PENDING per unit.
model UnitSaleApproval {
  id            String                 @id @default(cuid())
  companyId     String
  projectId     String
  recordType    UnitApprovalRecordType @default(UNIT)
  recordId      String
  reservationId String

  status UnitApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())
  submissionNote      String?

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservation UnitReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([reservationId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("unit_sale_approvals")
}

/// A request to publish a unit, one row per submission (E-05D §21, §47; PRD #41 §48).
model UnitPublicationApproval {
  id         String                 @id @default(cuid())
  companyId  String
  projectId  String
  recordType UnitApprovalRecordType @default(UNIT)
  recordId   String

  status UnitApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("unit_publication_approvals")
}

/// Sales' side of a unit (E-05E §9, §40): its commercial status, asking price and
/// hold. Not a second unit — one row per unit, created the first time Sales acts
/// on it; a unit without one is Not For Sale (§58). The status moves only by the
/// `unit_commercial` machine.
model UnitCommercialProfile {
  id        String @id @default(cuid())
  companyId String
  projectId String
  unitId    String @unique

  status UnitCommercialStatus @default(NOT_FOR_SALE)

  askingPrice Decimal?       @db.Decimal(18, 2)
  currency    String?        @db.VarChar(3)
  priceBasis  UnitPriceBasis @default(SALEABLE_AREA)

  holdReason     String?
  holdUntil      DateTime?
  heldByMemberId String?
  salesNotes     String?

  statusChangedAt   DateTime?
  version           Int       @default(1)
  updatedByMemberId String?

  unit ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, projectId, companyId])
  @@index([companyId, projectId, status])
  @@index([projectId, askingPrice])
  @@map("unit_commercial_profiles")
}

/// Every change to a unit's asking price, currency or basis (E-05E §12, §41).
model UnitPriceHistory {
  id        String @id @default(cuid())
  companyId String
  projectId String
  unitId    String

  oldPrice      Decimal?        @db.Decimal(18, 2)
  newPrice      Decimal?        @db.Decimal(18, 2)
  oldCurrency   String?         @db.VarChar(3)
  currency      String?         @db.VarChar(3)
  oldPriceBasis UnitPriceBasis?
  priceBasis    UnitPriceBasis
  reason        String?

  changedByMemberId String
  changedAt         DateTime @default(now())

  unit ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  @@index([unitId, changedAt])
  @@map("unit_price_history")
}

/// A unit allocated to a client and a deal until a date (E-05E §19-§31, §42).
/// Never deleted: released, expired, cancelled and converted reservations are the
/// unit's commercial history. A partial unique index allows one ACTIVE per unit.
model UnitReservation {
  id            String @id @default(cuid())
  companyId     String
  projectId     String
  unitId        String
  clientId      String
  opportunityId String

  status UnitReservationStatus @default(ACTIVE)

  reservedAt     DateTime  @default(now())
  expiresAt      DateTime
  /// When the "expires in 24 hours" notice went out, so it goes out once per expiry.
  expiryWarnedAt DateTime?
  closedAt       DateTime?

  closedByMemberId String?
  closeReason      String?

  agreedPrice Decimal? @db.Decimal(18, 2)
  currency    String?  @db.VarChar(3)
  notes       String?

  createdByMemberId String
  version           Int    @default(1)

  unit             ProjectUnit                @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  client           Client                     @relation("UnitReservationClient", fields: [clientId], references: [id], onDelete: Restrict)
  opportunity      Opportunity                @relation("UnitReservationOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict)
  extensions       UnitReservationExtension[]
  // What depends on this reservation in Legal and Sales (E-05F).
  contractRequests UnitContractRequest[]
  saleApprovals    UnitSaleApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, status])
  @@index([clientId])
  @@index([opportunityId])
  @@index([status, expiresAt])
  @@index([companyId, projectId, status])
  @@map("unit_reservations")
}

/// A reservation's expiry moved (E-05E §26): old and new date, who and why.
model UnitReservationExtension {
  id            String   @id @default(cuid())
  companyId     String
  reservationId String
  oldExpiresAt  DateTime
  newExpiresAt  DateTime
  reason        String

  extendedByMemberId String
  extendedAt         DateTime @default(now())

  reservation UnitReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, extendedAt])
  @@map("unit_reservation_extensions")
}

/// A unit in a deal (E-05E §17, §18, §43): the CRM Opportunity is this codebase's
/// Deal. One deal may hold an apartment, its parking and its storage; each stays
/// independently reservable.
model OpportunityUnit {
  id            String @id @default(cuid())
  companyId     String
  projectId     String
  opportunityId String
  unitId        String

  agreedPrice Decimal? @db.Decimal(18, 2)
  currency    String?  @db.VarChar(3)

  createdByMemberId String

  unit        ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  opportunity Opportunity @relation("OpportunityUnits", fields: [opportunityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([opportunityId, unitId])
  @@index([unitId])
  @@map("opportunity_units")
}

/// Every commercial status change of a unit, whoever or whatever made it (E-05E §44).
model UnitCommercialStatusHistory {
  id        String @id @default(cuid())
  companyId String
  projectId String
  unitId    String

  fromStatus UnitCommercialStatus?
  toStatus   UnitCommercialStatus
  reason     String?
  source     UnitCommercialChangeSource @default(USER)

  actorMemberId String?
  reservationId String?
  opportunityId String?

  changedAt DateTime @default(now())

  unit ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  @@index([unitId, changedAt])
  @@map("unit_commercial_status_history")
}

/// How PROJECT and ASSIGNED scope are resolved: user → member → project
/// membership → project (PRD #8 §28).
model ProjectMember {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  companyMemberId String
  projectRole     String?
  isPrimary       Boolean             @default(false)
  status          ProjectMemberStatus @default(ACTIVE)
  joinedAt        DateTime?
  leftAt          DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, companyMemberId])
  @@index([companyId])
  @@index([projectId])
  @@index([companyMemberId])
  @@index([companyId, companyMemberId])
  @@index([status])
  @@map("project_members")
}

model Client {
  id               String        @id @default(cuid())
  companyId        String
  code             String?
  name             String
  legalName        String?
  type             ClientType    @default(COMPANY)
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?
  status           ClientStatus  @default(ACTIVE)
  /// The status to return to on restore, so an archived client comes back
  /// INACTIVE if that is what it was (PRD #12 §70, §75).
  preArchiveStatus ClientStatus?

  /// Lower-cased, punctuation-stripped `name`, maintained by the service and
  /// never edited directly. It exists so duplicate detection is an indexed
  /// lookup rather than a scan (PRD #12 §55, §162).
  normalizedName String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  contacts             Contact[]
  projects             Project[]
  documents            Document[]
  invoices             Invoice[]
  opportunities        Opportunity[]
  proposals            Proposal[]
  convertedLeads       Lead[]                @relation("LeadConvertedClient")
  contracts            Contract[]
  contractParties      ContractParty[]       @relation("ContractPartyClient")
  unitReservations     UnitReservation[]     @relation("UnitReservationClient")
  unitContractRequests UnitContractRequest[] @relation("UnitContractRequestClient")
  payments             Payment[]             @relation("PaymentClient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, normalizedName])
  @@index([name])
  @@index([email])
  @@index([country])
  @@index([updatedAt])
  @@map("clients")
}

model Contact {
  id               String         @id @default(cuid())
  companyId        String
  clientId         String
  firstName        String
  lastName         String
  jobTitle         String?
  email            String?
  phone            String?
  isPrimary        Boolean        @default(false)
  status           ContactStatus  @default(ACTIVE)
  /// As on Client: restore returns the contact to the status it held
  /// (PRD #12 §77, §88).
  preArchiveStatus ContactStatus?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([companyId, clientId, status])
  @@index([lastName, firstName])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model Task {
  id                String       @id @default(cuid())
  companyId         String
  projectId         String?
  title             String
  description       String?
  assigneeMemberId  String?
  createdByMemberId String
  status            TaskStatus   @default(TODO)
  /// The status to return to on restore, so an archived task remembers where it
  /// was rather than always coming back as TODO (PRD #11 §73).
  preArchiveStatus  TaskStatus?
  priority          TaskPriority @default(MEDIUM)
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  /// Why the task cannot move, set by the block action and cleared by the
  /// next transition out of BLOCKED (PRD #38 §44). Never set by a status edit.
  blockedAt         DateTime?
  blockedReason     String?
  blockedByMemberId String?

  /// Generic parent context, so a later module can hang work off its own record
  /// without inventing a second task table (PRD #11 §171, §252).
  module     String?
  entityType String?
  entityId   String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignee CompanyMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  creator  CompanyMember  @relation("TaskCreatorMember", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingActionItem MeetingActionItem?
  workLogs          WorkLog[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, dueDate])
  @@index([companyId, assigneeMemberId, status])
  @@index([companyId, projectId, status])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([module])
  @@index([entityType, entityId])
  @@map("tasks")
}

/// File metadata plus the business context that governs who may see it.
/// A document is reachable only through its parent's permissions (PRD #8 §43).
model Document {
  id                  String  @id @default(cuid())
  companyId           String
  name                String
  description         String?
  /// The name the file was uploaded under, kept for display. The storage key
  /// is sanitised separately and never derived from it (PRD #13 §23, §154).
  originalFileName    String?
  fileName            String?
  extension           String?
  storageProvider     String?
  /// Deployment metadata only, kept so a bucket rename is a migration rather
  /// than an archaeology exercise. The key stays provider-neutral and the
  /// live bucket comes from configuration (PRD #29 §354, §356, §358).
  storageBucket       String?
  storageKey          String?
  mimeType            String?
  /// What the bytes actually are, read from the object's leading magic bytes
  /// after upload. The browser's declared type is advisory; this is not
  /// (PRD #29 §29, §31, §270).
  detectedMimeType    String?
  sizeBytes           BigInt?
  /// SHA-256 of the stored object. Integrity and duplicate diagnostics only —
  /// never authorisation (PRD #13 §32, PRD #29 §88).
  checksum            String?
  /// The version downloads and previews serve (PRD #38 §57). The file
  /// columns on this row mirror that version, so every existing read path
  /// keeps working; the version rows are the immutable history.
  currentVersionId    String? @unique
  /// Allocated by an atomic increment, so two concurrent uploads of a new
  /// version cannot both become version 3 (PRD #38 §154).
  latestVersionNumber Int     @default(0)

  /// The storage lifecycle, separate from `status`, which is the *business*
  /// visibility state. A document can be ACTIVE and still not downloadable
  /// because its object has not been verified (PRD #29 §2, §162).
  storageStatus       DocumentStorageStatus @default(PENDING_UPLOAD)
  scanStatus          DocumentScanStatus    @default(NOT_REQUIRED)
  scanProvider        String?
  scanCompletedAt     DateTime?
  /// When the scan in hand was claimed, and how many have been. A claim older
  /// than the scan lease belongs to a worker that died; past the attempt limit
  /// the file is FAILED rather than scanned forever (PRD #51 §27, §29, §34).
  scanStartedAt       DateTime?
  scanAttempts        Int                   @default(0)
  previewStatus       DocumentPreviewStatus @default(NOT_REQUIRED)
  previewMimeType     String?
  /// Derived objects live under the original's prefix and are just as private
  /// (PRD #29 §237, §238).
  previewStorageKey   String?
  thumbnailStorageKey String?

  uploadedAt       DateTime?
  verifiedAt       DateTime?
  availableAt      DateTime?
  rejectedAt       DateTime?
  /// A safe code, never scanner internals or a signature name (PRD #29 §211).
  rejectionReason  String?
  projectId        String?
  clientId         String?
  module           String?
  entityType       String?
  entityId         String?
  status           DocumentStatus  @default(ACTIVE)
  /// Archived documents return to ACTIVE, but the field keeps the shape every
  /// other module uses (PRD #13 §114).
  preArchiveStatus DocumentStatus?

  /// Metadata for a future contractor portal only — nothing is shared outside
  /// the company in V0.1, whatever this says (PRD #46 §128-§132, §255).
  sharingClassification DocumentSharingClassification @default(INTERNAL_ONLY)

  /// Where the file lives when a provider other than NESTO's own storage holds
  /// it — OneDrive or SharePoint, later (E-02 §3-§5, §161-§168). The provider's
  /// item id is the identity, never its path: a moved or renamed file keeps its
  /// Document and every reference to it. Nothing writes these in V0.1; the
  /// unique key below is what makes linking the same external item twice
  /// impossible once something does (§58, §188).
  externalProvider   String?
  externalDriveId    String?
  externalItemId     String?
  externalVersionId  String?
  externalParentId   String?
  /// Display only, never a key: paths change (§162).
  providerPath       String?
  /// Never handed to a browser: a provider link can bypass NESTO's checks (§175).
  webUrl             String?
  etag               String?
  lastProviderSyncAt DateTime?

  /// Who uploaded it. Records authorship, not ownership: access is decided by
  /// company, parent and permissions (PRD #13 §281).
  uploadedByMemberId String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation("DocumentProject", fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Projects showing this document as their cover (E-05A §8).
  coverForProjects    Project[]      @relation("ProjectCoverImage")
  projectMedia        ProjectMedia[] @relation("ProjectMediaDocument")
  projectMediaPosters ProjectMedia[] @relation("ProjectMediaThumbnail")

  uploadedBy CompanyMember? @relation("DocumentUploadedBy", fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  uploadSessions DocumentUploadSession[]
  versions       DocumentVersion[]

  engineeringRevisions      EngineeringDocumentRevision[]
  submittalRevisions        TechnicalSubmittalRevision[]
  transmittalItems          DocumentTransmittalItem[]
  contractorComplianceItems ContractorComplianceItem[]

  // E-05D: the unit's Sales Plan, its media, and documents attached to units.
  salesPlanForUnit ProjectUnit?       @relation("UnitSalesPlan")
  unitMedia        UnitMedia[]        @relation("UnitMediaDocument")
  unitLinks        UnitDocumentLink[] @relation("UnitDocumentLinkDocument")

  // E-03: the employment changes this document supports — references, never copies.
  employmentAssignments   EmploymentAssignment[]    @relation("EmploymentAssignmentDocument")
  employmentStatusHistory EmploymentStatusHistory[] @relation("EmploymentStatusDocument")
  employmentChanges       EmploymentChange[]        @relation("EmploymentChangeDocument")

  // E-02: what HR files it as, when its parent is an employment, and the qualifications it supports.
  employeeDocumentLink    EmployeeDocumentLink? @relation("EmployeeDocumentLinkDocument")
  supportedQualifications PersonQualification[] @relation("PersonQualificationDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One object, one document. An upload can never be pointed at a key another
  /// row already owns (PRD #29 §179, §180, §349).
  @@unique([storageKey])
  /// The target of composite keys that must name a document of their own company (E-03 §202).
  @@unique([id, companyId])
  /// One external item, one canonical Document, per company and provider (E-02 §58, §188).
  @@unique([companyId, externalProvider, externalDriveId, externalItemId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, projectId, status])
  @@index([companyId, clientId, status])
  @@index([companyId, module, status])
  @@index([projectId])
  @@index([clientId])
  @@index([uploadedByMemberId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([mimeType])
  @@index([extension])
  @@index([updatedAt])
  @@index([companyId, storageStatus])
  /// The scan sweep's queue, read every 15 seconds across companies (PRD #51 §133).
  @@index([storageStatus, scanStatus])
  @@index([checksum])
  @@map("documents")
}

/// One authorised upload attempt (PRD #29 §64, §68).
///
/// The session is the record of what the server agreed to accept: which key,
/// which member, how many bytes, and until when. Completion is checked against
/// it rather than against whatever the browser claims afterwards
/// (PRD #29 §65, §77, §80).
model DocumentUploadSession {
  id                String  @id @default(cuid())
  companyId         String
  documentId        String
  /// The version this upload creates. Every session has one: the first
  /// upload creates version 1 (PRD #38 §56).
  documentVersionId String?
  memberId          String

  storageKey        String
  expectedFileName  String
  expectedMimeType  String?
  expectedSizeBytes BigInt

  status DocumentUploadSessionStatus @default(CREATED)

  /// Bytes held against the company quota while this session is open, so two
  /// concurrent uploads cannot both squeeze under the same headroom
  /// (PRD #29 §149, §150).
  reservedBytes BigInt @default(0)

  expiresAt   DateTime
  completedAt DateTime?

  /// Reserved for the multipart flow the provider interface already allows
  /// (PRD #29 §124, §125). V0.1 uploads are a single PUT.
  multipartUploadId String?

  /// Repeating a create with the same key returns the same session rather than
  /// opening a second one (PRD #29 §261, §262).
  idempotencyKey String?
  attemptCount   Int     @default(0)

  failureReason String?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  member   CompanyMember @relation("UploadSessionMember", fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storageKey])
  @@unique([companyId, memberId, idempotencyKey])
  @@index([companyId])
  @@index([documentId])
  @@index([memberId])
  @@index([status, expiresAt])
  @@map("document_upload_sessions")
}

/// An immutable file revision (PRD #38 §56, §58).
///
/// Once a version is AVAILABLE its storage key, checksum and binary metadata
/// never change. A new binary is a new version, with its own key; the old
/// object stays where it is, reachable from its history.
model DocumentVersion {
  id            String @id @default(cuid())
  companyId     String
  documentId    String
  versionNumber Int

  storageProvider  String?
  storageBucket    String?
  storageKey       String  @unique
  originalFileName String?
  fileName         String?
  extension        String?
  mimeTypeDeclared String?
  mimeTypeDetected String?
  sizeBytes        BigInt?
  checksumSha256   String?

  storageStatus   DocumentStorageStatus @default(PENDING_UPLOAD)
  scanStatus      DocumentScanStatus    @default(NOT_REQUIRED)
  scanProvider    String?
  scanCompletedAt DateTime?
  /// As on Document (PRD #51 §27, §29, §34).
  scanStartedAt   DateTime?
  scanAttempts    Int                   @default(0)
  previewStatus   DocumentPreviewStatus @default(NOT_REQUIRED)
  previewMimeType String?
  rejectionReason String?

  reviewState  DocumentReviewState @default(DRAFT)
  changeNote   String?
  supersededAt DateTime?

  /// The provider's own version of the item, when one holds the file (E-02 §167).
  externalVersionId String?

  uploadedByMemberId String

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviews  DocumentReview[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  availableAt DateTime?

  @@unique([documentId, versionNumber])
  @@index([companyId, documentId, versionNumber])
  @@index([storageStatus, scanStatus])
  @@map("document_versions")
}

/// A request for one member to approve or reject one version (PRD #38 §60-§64).
///
/// Approving a document approves the document and nothing else: no invoice,
/// contract, order or safety record changes state because a file on it was
/// approved (PRD #38 §64).
model DocumentReview {
  id                  String               @id @default(cuid())
  companyId           String
  documentId          String
  documentVersionId   String
  requestedByMemberId String
  reviewerMemberId    String
  status              DocumentReviewStatus @default(PENDING)
  requestNote         String?
  decisionNote        String?
  decidedByMemberId   String?
  /// `versionId:reviewerId` while PENDING, null once decided: one open request
  /// per reviewer per version, enforced by the database rather than a race
  /// (PRD #38 §154, §155).
  pendingKey          String?              @unique
  /// When the requester needs a decision by — a business date, kept at midday
  /// UTC. It puts the review on the calendar (PRD #39 §61).
  dueAt               DateTime?

  version DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([companyId, reviewerMemberId, status])
  @@index([companyId, status, dueAt])
  @@index([documentVersionId])
  @@index([companyId, documentId])
  @@map("document_reviews")
}

/// What a company is allowed to store (PRD #29 §142, §144).
///
/// A null `maxStorageBytes` means no hard ceiling: usage is still measured and
/// shown, the deployment simply has not set one (PRD #29 §145, §151).
model CompanyStorageQuota {
  companyId String @id

  maxStorageBytes    BigInt?
  maxSingleFileBytes BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_storage_quotas")
}

/// What a company is actually storing (PRD #29 §147, §148).
///
/// A projection, maintained on successful upload and physical deletion, so the
/// quota check is one row read rather than a sum over every document. Derived
/// previews are deliberately excluded: the customer-facing number counts the
/// bytes they uploaded (PRD #29 §242, §243).
model CompanyStorageUsage {
  companyId String @id

  usedBytes BigInt @default(0)
  fileCount Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("company_storage_usage")
}

/// Business/user-visible activity. Authentication events go to AuthEvent —
/// the two are never combined (PRD #8 §48).
model Activity {
  id            String  @id @default(cuid())
  companyId     String
  module        String
  entityType    String
  entityId      String
  action        String
  message       String?
  actorMemberId String?
  actorUserId   String?
  metadata      Json?

  /// Ties every record written by one logical workflow together, across
  /// modules and background jobs (PRD #37 §47, PRD #23 §38-§40, PRD #32 §30).
  correlationId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  actorMember CompanyMember? @relation("ActivityActorMember", fields: [actorMemberId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation("ActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
  @@index([correlationId])
  @@map("activities")
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

/// An invitation to join a company (PRD #14 §64, §135).
///
/// Its lifecycle is tracked separately from `CompanyMember.status`, because
/// "this invitation was cancelled" and "this person's access was removed" are
/// different facts about different things.
///
/// Only the hash of the token is stored. The raw token exists solely inside the
/// emailed link, so a database leak cannot be replayed into a membership
/// (PRD #14 §67, §237).
model CompanyInvite {
  id                String              @id @default(cuid())
  companyId         String
  email             String
  userId            String?
  companyMemberId   String?
  roleId            String
  departmentId      String?
  jobTitle          String?
  tokenHash         String              @unique
  status            CompanyInviteStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  cancelledAt       DateTime?
  createdByMemberId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([email])
  @@index([expiresAt])
  @@index([companyMemberId])
  @@map("company_invites")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A server-side session record. The signed cookie carries only this row's id,
/// so revoking access is a delete rather than a wait for a token to expire
/// (PRD #6 §51, §113).
model Session {
  id               String   @id @default(cuid())
  sessionToken     String   @unique
  userId           String
  /// Both null for a platform session: the Platform Admin works outside every
  /// company and has no membership to point at (E-06 §6.1, §19, §116).
  membershipId     String?
  currentCompanyId String?
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership CompanyMember? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company?       @relation(fields: [currentCompanyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([membershipId])
  @@index([currentCompanyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the hash is stored; the raw token exists solely in the emailed link
/// (PRD #6 §57).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  companyId String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

/// One transactional email and what became of it (PRD #38 §13, §164).
///
/// Metadata only. The body is never stored: an invitation or a reset link is a
/// credential, and a table of them would be a table of ways into accounts. A
/// failed message is recovered by issuing a new one — resend the invitation,
/// request another reset — never by replaying an old body.
model MailDelivery {
  id                String             @id @default(cuid())
  companyId         String?
  recipient         String
  templateKey       String
  provider          String
  providerMessageId String?
  status            MailDeliveryStatus @default(QUEUED)
  errorCode         String?
  attempts          Int                @default(0)
  /// Repeating a send with the same key returns the first delivery instead of
  /// sending twice (PRD #38 §155).
  idempotencyKey    String?            @unique
  /// What the message was about, so an operator can find the failed invitation.
  entityType        String?
  entityId          String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastAttemptAt DateTime?
  sentAt        DateTime?

  @@index([status, createdAt])
  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("mail_deliveries")
}

/// A fixed-window counter every application instance shares (PRD #38 §17).
///
/// Held in PostgreSQL rather than process memory, because a limit each instance
/// counts separately is a limit multiplied by the number of instances. The key
/// is `category:subject`, and the subject is always a hash or an opaque id —
/// never an email address or a token (PRD #38 §18).
model RateLimitBucket {
  key          String   @id
  count        Int
  windowEndsAt DateTime

  updatedAt DateTime @updatedAt

  @@index([windowEndsAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Module test records (PRD #9 §67)
// ---------------------------------------------------------------------------
// Minimal shapes that make the Module Shell testable: list, detail, status,
// scope, approval. Each department module replaces its table when its own PRD
// lands; none of these is a final domain model.

/// Per-company finance configuration (PRD #15 §28).
/// Finance-specific settings only (PRD #24 §124).
///
/// Base currency, fiscal year start and payment terms were duplicated here and
/// on CompanySettings. CompanySettings owns them now, so a company cannot hold
/// two different answers to the same question (PRD #24 §41-§43, PRD #37 §320).
model FinanceSettings {
  id             String   @id @default(cuid())
  companyId      String   @unique
  invoicePrefix  String?
  defaultTaxRate Decimal? @db.Decimal(7, 4)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

/// A customer receivable (PRD #15 §38).
///
/// Totals are columns rather than derived at read time because a historical
/// invoice must keep the numbers it was issued with, whatever later happens to
/// its lines. They are recalculated by the server on every write and never
/// accepted from the browser (PRD #15 §52, §220).
model Invoice {
  id            String  @id @default(cuid())
  companyId     String
  invoiceNumber String
  clientId      String
  projectId     String?

  /// The accepted proposal this invoice was drawn from, when it came from
  /// Sales (PRD #35 §180). Nullable and SetNull: an invoice outlives the
  /// proposal that prompted it, and most invoices have no proposal at all.
  sourceProposalId String?

  /// The sale contract installment this invoice bills, when it bills one
  /// (E-05F §26). Its total is the installment's amount, and it is settled by the
  /// money allocated to that installment. The pair is one foreign key, so an
  /// invoice cannot name an installment of another contract.
  contractId    String?
  installmentId String?

  issueDate DateTime
  dueDate   DateTime
  currency  String   @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           InvoiceStatus  @default(DRAFT)
  preArchiveStatus InvoiceStatus?

  notes  String?
  sentAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sourceProposal Proposal? @relation("InvoiceSourceProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)

  contract    Contract?           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  installment PaymentInstallment? @relation(fields: [installmentId, contractId], references: [id, contractId], onDelete: Restrict)

  lineItems   InvoiceLineItem[]
  /// What has been paid against it (E-05F §31): allocations of recorded payments.
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([clientId])
  @@index([projectId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([currency])
  @@index([updatedAt])
  @@index([sourceProposalId])
  @@index([contractId, status])
  @@index([installmentId])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A cost incurred by the company, with or without a project (PRD #15 §87).
model Expense {
  id            String  @id @default(cuid())
  companyId     String
  expenseNumber String?
  projectId     String?

  expenseDate DateTime
  category    FinanceCostCategory
  description String
  payeeName   String?

  currency    String  @db.VarChar(3)
  netAmount   Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           ExpenseStatus  @default(DRAFT)
  preArchiveStatus ExpenseStatus?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// What has been paid out against it: allocations of recorded disbursements (E-05F §31).
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, expenseNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
  @@index([projectId])
  @@index([category])
  @@index([currency])
  @@index([updatedAt])
  @@map("expenses")
}

/// Actual cash received or paid out (PRD #15 §70; E-05F §29-§34). Voided rather
/// than deleted, so the trail survives.
///
/// What a payment settles is its allocations, never a column here: one transfer
/// may cover two installments, one installment may be paid in three transfers,
/// and an invoice or an expense is settled by the money allocated to it
/// (E-05F §31). A receipt names who paid; one recorded against a sale contract
/// names the contract, and money not yet allocated stays visible as unallocated
/// for Finance to review (§34). `projectId` is the project of what it settles,
/// which is how a project-scoped reader reaches it.
model Payment {
  id        String @id @default(cuid())
  companyId String

  direction  PaymentDirection
  clientId   String?
  contractId String?
  projectId  String?

  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @db.VarChar(3)
  paymentDate DateTime
  method      PaymentMethod

  reference String?
  notes     String?

  status PaymentStatus @default(RECORDED)

  /// A payment recorded to replace a voided one (E-05F §81).
  replacesPaymentId String?

  createdByMemberId String
  voidedByMemberId  String?
  voidedAt          DateTime?
  voidReason        String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client   Client?   @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Restrict)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  project  Project?  @relation("PaymentProject", fields: [projectId], references: [id], onDelete: SetNull)
  replaces Payment?  @relation("PaymentReplacement", fields: [replacesPaymentId], references: [id], onDelete: Restrict)

  replacements Payment[]           @relation("PaymentReplacement")
  allocations  PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, paymentDate])
  @@index([direction])
  @@index([currency])
  @@index([clientId, paymentDate])
  @@index([contractId, paymentDate])
  @@index([projectId])
  @@index([replacesPaymentId])
  @@map("payments")
}

/// How much of a payment settles what (E-05F §31, §72): an installment of a sale
/// contract, an invoice, both at once when the invoice bills that installment,
/// or an expense. Never edited; a correction reverses it with a reason, and only
/// unreversed allocations of recorded payments count (§81).
model PaymentAllocation {
  id            String  @id @default(cuid())
  companyId     String
  paymentId     String
  /// Set exactly when an installment is, and always its contract.
  contractId    String?
  installmentId String?
  invoiceId     String?
  expenseId     String?

  amount Decimal @db.Decimal(18, 2)

  createdByMemberId  String
  reversedAt         DateTime?
  reversedByMemberId String?
  reversalReason     String?

  payment     Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment PaymentInstallment? @relation(fields: [installmentId, contractId], references: [id, contractId], onDelete: Restrict)
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expense     Expense?            @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([contractId])
  @@index([installmentId])
  @@index([invoiceId])
  @@index([expenseId])
  @@map("payment_allocations")
}

/// A sale contract's plan of payments (E-05F §18-§25, §69). Finance turns the
/// contract's terms into installments. A draft is edited as a whole; activating
/// it checks its total and supersedes the schedule in force, which keeps its
/// installments and whatever was paid against them (§25, §84). Partial unique
/// indexes keep one ACTIVE and one DRAFT per contract.
model PaymentSchedule {
  id            String                @id @default(cuid())
  companyId     String
  contractId    String
  versionNumber Int
  status        PaymentScheduleStatus @default(DRAFT)
  currency      String                @db.VarChar(3)
  notes         String?

  /// Why its installments deliberately do not add up to what the contract still needs (§24).
  totalExceptionReason     String?
  totalExceptionByMemberId String?

  activatedAt            DateTime?
  activatedByMemberId    String?
  supersededAt           DateTime?
  supersededByScheduleId String?
  cancelledAt            DateTime?
  cancelledByMemberId    String?
  cancelReason           String?
  completedAt            DateTime?

  createdByMemberId String
  updatedByMemberId String?
  version           Int     @default(1)

  contract     Contract             @relation(fields: [contractId, companyId], references: [id, companyId], onDelete: Restrict)
  installments PaymentInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, versionNumber])
  @@unique([id, contractId])
  @@index([contractId, status])
  @@index([companyId, status])
  @@map("payment_schedules")
}

/// One payment a schedule expects (E-05F §21, §70). Its status — upcoming, due,
/// partly paid, paid, overdue — is derived from its due date and the money
/// allocated to it, never stored (§22).
model PaymentInstallment {
  id         String          @id @default(cuid())
  companyId  String
  contractId String
  scheduleId String
  sequence   Int
  label      String
  type       InstallmentType @default(INSTALLMENT)
  amount     Decimal         @db.Decimal(18, 2)
  currency   String          @db.VarChar(3)
  dueDate    DateTime
  notes      String?

  schedule    PaymentSchedule     @relation(fields: [scheduleId, contractId], references: [id, contractId], onDelete: Restrict)
  allocations PaymentAllocation[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, sequence])
  @@unique([id, contractId])
  @@index([scheduleId, dueDate])
  @@index([contractId, dueDate])
  @@index([companyId])
  @@map("payment_installments")
}

/// A versioned project budget (PRD #15 §103, §109).
///
/// An approved budget is never edited; a revision is a new version, and exactly
/// one version per project carries `isCurrent` (PRD #15 §111, §115, §201).
model ProjectBudget {
  id        String @id @default(cuid())
  companyId String
  projectId String

  version          Int
  name             String?
  currency         String        @db.VarChar(3)
  status           BudgetStatus  @default(DRAFT)
  preArchiveStatus BudgetStatus?
  isCurrent        Boolean       @default(false)

  totalAmount Decimal @db.Decimal(18, 2)
  notes       String?

  createdByMemberId  String
  updatedByMemberId  String?
  approvedByMemberId String?
  approvedAt         DateTime?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  lineItems ProjectBudgetLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([projectId, isCurrent])
  @@index([currency])
  @@map("project_budgets")
}

model ProjectBudgetLineItem {
  id       String @id @default(cuid())
  budgetId String

  category      FinanceCostCategory
  description   String
  plannedAmount Decimal             @db.Decimal(18, 2)
  sortOrder     Int                 @default(0)

  budget ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([category])
  @@map("project_budget_line_items")
}

/// Approved future spend not yet recognised as an expense (PRD #15 §124).
///
/// The source columns exist so a future Procurement purchase order can claim
/// the commitment it created rather than a second one appearing beside it
/// (PRD #15 §127).
model Commitment {
  id        String  @id @default(cuid())
  companyId String
  projectId String?

  reference        String?
  description      String
  counterpartyName String?
  category         FinanceCostCategory

  currency String  @db.VarChar(3)
  amount   Decimal @db.Decimal(18, 2)

  expectedDate     DateTime?
  status           CommitmentStatus  @default(DRAFT)
  preArchiveStatus CommitmentStatus?

  sourceModule     String?
  sourceEntityType String?
  sourceEntityId   String?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One commitment per source record. The handoff from a purchase order is
  /// idempotent because the database refuses a second one, not because the
  /// caller remembered to look (PRD #48 §41, §141, §165). A commitment raised
  /// in Finance itself carries no source, and NULLs do not collide.
  @@unique([companyId, sourceModule, sourceEntityType, sourceEntityId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([category])
  @@index([expectedDate])
  @@index([currency])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@map("commitments")
}

/// One approval cycle for one finance record (PRD #15 §137).
///
/// A resubmission creates a new row rather than reopening the old one, so the
/// record's approval history stays readable (PRD #15 §64, §145).
model FinanceApproval {
  id        String @id @default(cuid())
  companyId String

  recordType FinanceApprovalRecordType
  recordId   String

  status FinanceApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("finance_approvals")
}

/// The canonical employment record (PRD #16 §25, §26).
///
/// A person's employment by one company of the group — E-03's employment
/// record, the company its legal entity (ADR 0002, ADR 0004). It carries
/// employment facts and the current organizational state, and deliberately not
/// identity: the name belongs to the person, the NESTO role to the membership
/// (PRD #16 §2, §53; E-03 §107). Where the employee sat over time is its
/// `EmploymentAssignment` history; its status over time its
/// `EmploymentStatusHistory` (E-03 §6, §7).
model EmployeeProfile {
  id              String  @id @default(cuid())
  companyId       String
  /// The person employed (E-06 §25). Required: employment is always somebody's.
  /// Not unique with the company — a transfer or a rehire is a new employment of
  /// the same person (E-09 §122, §123).
  personProfileId String
  /// The login-side identity, once Group IT has provisioned one (E-06 §25, §28).
  /// An employee without a NESTO account has none.
  companyMemberId String? @unique

  employeeNumber   String?
  employmentStatus EmploymentStatus @default(PLANNED)
  employmentType   EmploymentType   @default(FULL_TIME)

  startDate        DateTime?
  probationEndDate DateTime?
  endDate          DateTime?

  /// The current organizational state (E-03 §6): a cache of the open
  /// `EmploymentAssignment`, written only by the employment history service in
  /// the same transaction as that row, never by a form (§180, §181, §187).
  /// The department is a branch of this company; the title is the job, not the
  /// NESTO role (§107).
  departmentId     String?
  jobTitle         String?
  managerMemberId  String?
  workLocationType WorkLocationType?
  workLocation     String?
  weeklyHours      Decimal?          @db.Decimal(6, 2)

  /// What kind of worker, and their trade (E-04 §10-§12). Workforce facts about
  /// the job, never NESTO roles (§13): somebody without a login has a trade and
  /// no role at all.
  workerCategory WorkerCategory?
  tradeId        String?

  onboardingStatus  HrProgressStatus @default(NOT_STARTED)
  offboardingStatus HrProgressStatus @default(NOT_REQUIRED)

  createdByMemberId String?
  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  companyMember        CompanyMember?            @relation("EmployeeProfileMember", fields: [companyMemberId], references: [id], onDelete: Restrict)
  personProfile        PersonProfile             @relation(fields: [personProfileId], references: [id], onDelete: Restrict)
  provisioningRequests UserProvisioningRequest[]
  managerMember        CompanyMember?            @relation("EmployeeProfileManager", fields: [managerMemberId], references: [id], onDelete: SetNull)
  department           Department?               @relation("EmployeeProfileDepartment", fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  trade                WorkforceTrade?           @relation(fields: [tradeId, companyId], references: [id, companyId], onDelete: Restrict)

  compensations     Compensation[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendanceRecords AttendanceRecord[]

  assignments      EmploymentAssignment[]
  statusHistory    EmploymentStatusHistory[]
  scheduledChanges EmploymentChange[]

  // E-04: where the employee works and with whom — none of it needs a login (§33-§42, §70-§74).
  crewMemberships          WorkforceCrewMember[]
  supervisedCrews          WorkforceCrew[]             @relation("WorkforceCrewSupervisor")
  projectAssignments       EmployeeProjectAssignment[]
  hseInductions            HseInduction[]
  toolboxParticipations    ToolboxTalkParticipant[]
  ppeChecks                PpeCheck[]                  @relation("PpeSubjectEmployee")
  hseIncidentInvolvements  HseIncidentPerson[]
  hseWorkPermitAssignments HseWorkPermitWorker[]

  // E-02: what HR keeps on file for this employment — contracts, letters, pay evidence, certificates.
  documentLinks EmployeeDocumentLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The target of the history tables' composite keys: a history row can only
  /// name an employment of its own company.
  @@unique([id, companyId])
  @@unique([companyId, employeeNumber])
  @@index([companyId, departmentId])
  @@index([companyId])
  @@index([personProfileId])
  @@index([companyId, employmentStatus])
  @@index([companyId, employmentType])
  @@index([companyId, workerCategory])
  @@index([companyId, tradeId])
  @@index([managerMemberId])
  @@index([startDate])
  @@index([endDate])
  @@map("employee_profiles")
}

/// One period of an employment's organizational state (E-03 §9-§12): where the
/// employee sat — company (the employment's, E-03's legal entity), department,
/// title, manager, work location and type — from `startDate` to `endDate`,
/// both inclusive business dates; the open row (`endDate` null) is the current
/// state the employment caches (§180).
///
/// Never edited. A change closes the open row and opens the next (§7); a
/// correction marks the rows it replaces `supersededAt` and writes corrected
/// ones that name them (§42-§44, §171). The database refuses two open rows and
/// two overlapping rows among those not superseded (§40, §41, §89).
/// Department and manager names are kept as they read on the day, so a later
/// rename does not rewrite what the history says (§19).
model EmploymentAssignment {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String

  departmentId     String?
  departmentName   String?
  jobTitle         String?
  managerMemberId  String?
  managerName      String?
  workLocationType WorkLocationType?
  workLocation     String?
  employmentType   EmploymentType

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  reason    EmploymentAssignmentReason
  /// Always true in V0.1; kept so multi-assignment can be introduced without a migration (E-03 §11).
  isPrimary Boolean                    @default(true)

  /// A canonical document the change rests on, referenced, never copied (E-03 §45-§53).
  sourceDocumentId String?
  source           EmploymentHistorySource @default(CHANGE)
  /// HR's own note; never shown to the employee or a colleague (E-03 §128).
  note             String?
  createdByUserId  String?

  supersededAt       DateTime?
  supersededByUserId String?
  /// The row this one corrects, and why (E-03 §43, §171).
  correctsId         String?
  correctionReason   String?

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile        @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Cascade)
  department      Department?            @relation("EmploymentAssignmentDepartment", fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  managerMember   CompanyMember?         @relation("EmploymentAssignmentManager", fields: [managerMemberId], references: [id], onDelete: SetNull)
  sourceDocument  Document?              @relation("EmploymentAssignmentDocument", fields: [sourceDocumentId, companyId], references: [id, companyId], onDelete: Restrict)
  corrects        EmploymentAssignment?  @relation("EmploymentAssignmentCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy     EmploymentAssignment[] @relation("EmploymentAssignmentCorrection")

  createdAt DateTime @default(now())

  @@index([companyId, employeeProfileId, endDate])
  @@index([companyId, startDate, endDate])
  @@index([companyId, departmentId, startDate, endDate])
  @@index([companyId, managerMemberId, startDate, endDate])
  @@index([employeeProfileId, startDate])
  @@index([sourceDocumentId])
  @@map("employment_assignments")
}

/// An employment's status over time (E-03 §22-§24): one row per period, both
/// dates inclusive, the open row the current status. A period's first ACTIVE
/// row carries HIRE or REHIRE, which is how employment periods are told apart
/// (E-03 §26-§28). The private reason is HR's alone (§24, §105, §137).
model EmploymentStatusHistory {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String

  status        EmploymentStatus
  effectiveFrom DateTime               @db.Date
  effectiveTo   DateTime?              @db.Date
  reason        EmploymentStatusReason
  privateReason String?

  sourceDocumentId String?
  source           EmploymentHistorySource @default(CHANGE)
  createdByUserId  String?

  supersededAt       DateTime?
  supersededByUserId String?
  correctsId         String?
  correctionReason   String?

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile           @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Cascade)
  sourceDocument  Document?                 @relation("EmploymentStatusDocument", fields: [sourceDocumentId, companyId], references: [id, companyId], onDelete: Restrict)
  corrects        EmploymentStatusHistory?  @relation("EmploymentStatusCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy     EmploymentStatusHistory[] @relation("EmploymentStatusCorrection")

  createdAt DateTime @default(now())

  @@index([companyId, employeeProfileId, effectiveTo])
  @@index([companyId, status, effectiveFrom, effectiveTo])
  @@index([employeeProfileId, effectiveFrom])
  @@index([sourceDocumentId])
  @@map("employment_status_history")
}

/// A future-dated employment change, applied once on its day by the worker
/// (E-03 §31-§34, §153-§157). The payload is the change's own typed input,
/// validated again when it applies. Cancelled only before it applies; after,
/// history is corrected instead (§157).
model EmploymentChange {
  id                String                 @id @default(cuid())
  companyId         String
  employeeProfileId String
  type              EmploymentChangeType
  effectiveDate     DateTime               @db.Date
  payload           Json
  status            EmploymentChangeStatus @default(SCHEDULED)

  sourceDocumentId  String?
  requestedByUserId String

  appliedAt         DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?
  /// Why the worker could not apply it (E-03 §226: a scheduled change never fails silently).
  failureReason     String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Cascade)
  sourceDocument  Document?       @relation("EmploymentChangeDocument", fields: [sourceDocumentId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, effectiveDate])
  @@index([employeeProfileId, status])
  @@map("employment_changes")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Workforce (E-04)
 */
/**
 * --------------------------------------------------------------------------
 */

/// A company's list of trades — masons, electricians, steel fixers (E-04 §11).
/// Configurable per company, like project types; a trade in use is retired,
/// never deleted.
model WorkforceTrade {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdByMemberId String?
  updatedByMemberId String?

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   EmployeeProfile[]
  crews       WorkforceCrew[]
  assignments EmployeeProjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId, isActive, sortOrder])
  @@map("workforce_trades")
}

/// A crew: a named team of the company's workers, usually on one project and
/// site, led by a supervisor who may themselves have no login (E-04 §28, §31).
model WorkforceCrew {
  id                   String              @id @default(cuid())
  companyId            String
  name                 String
  projectId            String?
  siteId               String?
  tradeId              String?
  /// The foreman: an employment, not a login (E-04 §31, §32).
  supervisorEmployeeId String?
  status               WorkforceCrewStatus @default(ACTIVE)
  notes                String?
  archivedAt           DateTime?

  createdByMemberId String?
  updatedByMemberId String?

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site       ProjectSite?     @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  trade      WorkforceTrade?  @relation(fields: [tradeId, companyId], references: [id, companyId], onDelete: Restrict)
  supervisor EmployeeProfile? @relation("WorkforceCrewSupervisor", fields: [supervisorEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)

  members           WorkforceCrewMember[]
  attendanceRecords AttendanceRecord[]
  dailyLogEntries   DailyLogWorkforceEntry[]
  permitAssignments HseWorkPermitWorker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([supervisorEmployeeId])
  @@map("workforce_crews")
}

/// One period of one employee in one crew (E-04 §29, §30). Never edited: a move
/// ends this row and opens another, so the crew history is the rows. Both dates
/// are inclusive business dates; the database refuses two overlapping periods
/// for the same employee.
model WorkforceCrewMember {
  id                String    @id @default(cuid())
  companyId         String
  crewId            String
  employeeProfileId String
  role              String?
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  endReason         String?

  createdByUserId String?
  endedByUserId   String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  crew            WorkforceCrew   @relation(fields: [crewId, companyId], references: [id, companyId], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, crewId, endDate])
  @@index([companyId, employeeProfileId, endDate])
  @@map("workforce_crew_members")
}

/// Where an employee actually works: a project, and a site of it (E-04 §33-§42).
/// Not `ProjectMember`, which is platform access and collaboration (§35): a
/// worker without a login is assigned here and nowhere else. A transfer ends
/// one row and opens another; the database refuses two overlapping periods on
/// the same project, and two overlapping primary ones.
model EmployeeProjectAssignment {
  id                String    @id @default(cuid())
  companyId         String
  employeeProfileId String
  projectId         String
  siteId            String?
  tradeId           String?
  role              String?
  isPrimary         Boolean   @default(false)
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  endReason         String?

  createdByUserId String?
  endedByUserId   String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)
  project         Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site            ProjectSite?    @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  trade           WorkforceTrade? @relation(fields: [tradeId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId, endDate])
  @@index([companyId, employeeProfileId, endDate])
  @@index([companyId, siteId, endDate])
  @@map("employee_project_assignments")
}

/// A bulk import of employees (E-04 §93-§98, §189): the rows as validated at
/// preview and each one's outcome. Commit applies these rows, never a copy
/// sent back by the browser.
model EmployeeImportBatch {
  id           String               @id @default(cuid())
  companyId    String
  fileName     String
  status       EmployeeImportStatus @default(PREVIEWED)
  rowCount     Int
  validCount   Int
  errorCount   Int
  warningCount Int                  @default(0)
  createdCount Int                  @default(0)
  /// Whether the file carried pay — which only somebody allowed to record it may import (§95).
  includesPay  Boolean              @default(false)
  rows         Json

  createdByUserId   String
  committedAt       DateTime?
  committedByUserId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@map("employee_import_batches")
}

/// What a document filed on an employment is to HR (E-02 §11, §27, §28): its
/// category, business title, dates, who may see it and whether it has been
/// checked. The file is the canonical Document — this row holds no bytes and
/// no copy (§12), and there is exactly one per document: the document's parent
/// is this employment, so the two can never disagree about whose file it is.
///
/// Legal and employment history is never overwritten (§63): a renewal or a
/// replacement is a new row, the old one marked not current and pointing at it.
model EmployeeDocumentLink {
  id                 String                       @id @default(cuid())
  companyId          String
  employeeProfileId  String
  documentId         String
  category           EmployeeDocumentCategory
  /// What HR calls it — "Professional Engineer Licence" — whatever the file is named (§226-§228).
  title              String
  visibility         EmployeeDocumentVisibility
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)

  issuer         String?
  documentNumber String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  effectiveFrom  DateTime? @db.Date
  effectiveTo    DateTime? @db.Date

  /// False once a later document took its place, or HR said it no longer applies (§64, §65).
  isCurrent      Boolean @default(true)
  /// The document that replaced this one, by renewal or supersession (§66, §91).
  supersededById String?
  /// For an amendment: the contract it amends. Never a new version of it (§13, §62).
  amendsId       String?

  verifiedByMemberId        String?
  /// When it was verified or rejected — the decision is the status (§76).
  verifiedAt                DateTime?
  verificationNote          String?
  /// The file version the verifier looked at. A later upload is not verified by that decision.
  verifiedDocumentVersionId String?

  createdByMemberId  String?
  archivedAt         DateTime?
  archivedByMemberId String?
  archiveReason      String?
  version            Int       @default(1)

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile        @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)
  document        Document               @relation("EmployeeDocumentLinkDocument", fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict)
  supersededBy    EmployeeDocumentLink?  @relation("EmployeeDocumentSupersession", fields: [supersededById, employeeProfileId], references: [id, employeeProfileId], onDelete: Restrict)
  supersedes      EmployeeDocumentLink?  @relation("EmployeeDocumentSupersession")
  amends          EmployeeDocumentLink?  @relation("EmployeeDocumentAmendment", fields: [amendsId, employeeProfileId], references: [id, employeeProfileId], onDelete: Restrict)
  amendments      EmployeeDocumentLink[] @relation("EmployeeDocumentAmendment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  /// One link per document: the document's parent is this employment (§12).
  @@unique([documentId, companyId])
  /// A replacement or an amended contract is always the same employment's: the
  /// history chains below cannot cross from one employee to another.
  @@unique([id, employeeProfileId])
  @@unique([supersededById, employeeProfileId])
  @@index([companyId, employeeProfileId, category])
  @@index([companyId, verificationStatus])
  @@index([companyId, expiryDate])
  @@index([amendsId])
  @@map("employee_document_links")
}

/// A skill, diploma, licence or certificate a person holds (E-02 §14, §15).
///
/// The person's, not an employment's: it stays with them through a transfer or
/// a rehire, across the group's companies (ADR 0007). `companyId` is where it
/// was recorded, and where its supporting file — a canonical Document, never a
/// copy — is filed. Whether colleagues see it is the qualification's
/// visibility; whether they may open the file is the file's own (§35).
model PersonQualification {
  id              String @id @default(cuid())
  parentGroupId   String
  personProfileId String
  companyId       String

  type               QualificationType
  title              String
  issuer             String?
  documentNumber     String?
  issueDate          DateTime?                    @db.Date
  expiryDate         DateTime?                    @db.Date
  proficiency        SkillProficiency?
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)
  visibility         QualificationVisibility      @default(EMPLOYEE_AND_HR)

  supportingDocumentId String?

  isCurrent      Boolean @default(true)
  supersededById String?

  verifiedByMemberId        String?
  verifiedAt                DateTime?
  verificationNote          String?
  verifiedDocumentVersionId String?

  createdByMemberId  String?
  archivedAt         DateTime?
  archivedByMemberId String?
  archiveReason      String?
  version            Int       @default(1)

  parentGroup        ParentGroup          @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)
  person             PersonProfile        @relation(fields: [personProfileId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  company            Company              @relation(fields: [companyId, parentGroupId], references: [id, parentGroupId], onDelete: Restrict)
  supportingDocument Document?            @relation("PersonQualificationDocument", fields: [supportingDocumentId, companyId], references: [id, companyId], onDelete: Restrict)
  supersededBy       PersonQualification? @relation("PersonQualificationSupersession", fields: [supersededById, personProfileId], references: [id, personProfileId], onDelete: Restrict)
  supersedes         PersonQualification? @relation("PersonQualificationSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A renewal is always the same person's (§91).
  @@unique([id, personProfileId])
  @@unique([supersededById, personProfileId])
  @@index([parentGroupId, personProfileId])
  @@index([companyId, verificationStatus])
  @@index([companyId, expiryDate])
  @@index([supportingDocumentId])
  @@index([parentGroupId, type, verificationStatus])
  @@map("person_qualifications")
}

/// Pay, behind its own permission (PRD #16 §17, §58).
///
/// Effective-dated rather than overwritten: a raise opens a new record and
/// closes the previous one, so what somebody was paid last year survives
/// (PRD #16 §64, §65).
model Compensation {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String

  currency   String              @db.VarChar(3)
  payType    CompensationPayType
  baseAmount Decimal             @db.Decimal(18, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  notes String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeProfileId])
  @@index([employeeProfileId, effectiveFrom])
  @@index([currency])
  @@map("compensations")
}

model LeaveRequest {
  id                String  @id @default(cuid())
  companyId         String
  employeeProfileId String
  /// The login the employee had, if any: leave is the employment's (E-04 §7).
  companyMemberId   String?

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  days      Decimal   @db.Decimal(6, 2)
  reason    String?

  status LeaveRequestStatus @default(DRAFT)

  submittedAt DateTime?

  approvedByMemberId String?
  approvedAt         DateTime?

  rejectedByMemberId String?
  rejectedAt         DateTime?

  cancelledByMemberId String?
  cancelledAt         DateTime?

  decisionNote String?

  createdByMemberId String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([leaveType])
  @@map("leave_requests")
}

/// Entitlement per employee, type and year (PRD #16 §79).
///
/// `usedDays` is maintained transactionally from approved leave, never sent by
/// a browser: it is the number every "do you have enough days" check reads
/// (PRD #16 §80).
model LeaveBalance {
  id                String    @id @default(cuid())
  companyId         String
  employeeProfileId String
  /// The login the employee had, if any: leave is the employment's (E-04 §7).
  companyMemberId   String?
  leaveType         LeaveType
  year              Int

  entitledDays   Decimal @db.Decimal(6, 2)
  usedDays       Decimal @default(0) @db.Decimal(6, 2)
  adjustmentDays Decimal @default(0) @db.Decimal(6, 2)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, leaveType, year])
  @@index([companyId])
  @@index([companyMemberId])
  @@index([year])
  @@map("leave_balances")
}

/// Daily attendance, not biometric timekeeping (PRD #16 §97).
///
/// The source columns let approved leave write `ON_LEAVE` days and, when that
/// leave is cancelled, take exactly those rows back out again — without
/// touching anything a person entered by hand (PRD #16 §109, §110).
model AttendanceRecord {
  id                String  @id @default(cuid())
  companyId         String
  employeeProfileId String
  /// The login the employee had when this was recorded, if any. Attendance is
  /// the employment's; somebody without a NESTO account has it too (E-04 §51).
  companyMemberId   String?

  /// Where the day was worked, when it was recorded on site (E-04 §123, §243).
  projectId String?
  siteId    String?
  crewId    String?

  date   DateTime
  status AttendanceStatus

  checkIn       DateTime?
  checkOut      DateTime?
  workedMinutes Int?

  notes  String?
  source AttendanceSource @default(MANUAL)

  sourceEntityType String?
  sourceEntityId   String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site            ProjectSite?    @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  crew            WorkforceCrew?  @relation(fields: [crewId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, employeeProfileId, date])
  @@index([companyId, projectId, date])
  @@index([companyId, siteId, date])
  @@index([companyId, crewId, date])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([status])
  @@index([sourceEntityType, sourceEntityId])
  @@map("attendance_records")
}

/// A prospective contact nobody has qualified yet (PRD #17 §32, §33).
///
/// A Lead is not a Client. It may name a company that does not exist in the
/// system, an email nobody has replied to, and a value somebody guessed. The
/// canonical Client is created at conversion, through the Clients service —
/// never by copying these fields into a second customer table (PRD #17 §4, §54).
model Lead {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  website     String?

  source           LeadSource
  status           LeadStatus  @default(NEW)
  /// The status to return to on restore, so an archived lead comes back
  /// CONTACTED if that is what it was (PRD #17 §58).
  preArchiveStatus LeadStatus?

  ownerMemberId String?
  notes         String?

  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String?  @db.VarChar(3)

  /// Why the lead went nowhere. Free text rather than an enum, so a company can
  /// say what actually happened without a migration (PRD #17 §421).
  disqualifyReason String?

  /// Conversion lineage (PRD #17 §386, §438). `convertedOpportunity` is the
  /// back-reference of `Opportunity.sourceLeadId`, so one column carries the
  /// link and the two records can never disagree about it.
  convertedAt       DateTime?
  convertedClientId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner   CompanyMember? @relation("LeadOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  convertedClient      Client?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity? @relation("OpportunitySourceLead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, ownerMemberId])
  @@index([companyId, source])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("leads")
}

/// A qualified potential deal (PRD #17 §59, §60).
///
/// `stage` is the commercial outcome and keeps WON or LOST forever; archiving
/// is `archivedAt`, a separate fact, so closing the books on a deal never
/// overwrites how it ended (PRD #17 §61, §62).
model Opportunity {
  id            String  @id @default(cuid())
  companyId     String
  name          String
  clientId      String?
  contactId     String?
  ownerMemberId String

  stage           OpportunityStage  @default(PROSPECTING)
  /// Stage the opportunity held before archiving (PRD #17 §60).
  preArchiveStage OpportunityStage?
  /// When the stage last moved, for pipeline aging (PRD #17 §439, §442).
  stageChangedAt  DateTime          @default(now())

  estimatedValue      Decimal  @db.Decimal(18, 2)
  currency            String   @db.VarChar(3)
  /// 0–100, overriding the stage default when the owner knows better
  /// (PRD #17 §28).
  probabilityOverride Decimal? @db.Decimal(5, 2)

  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  description String?
  nextStep    String?

  sourceLeadId String? @unique

  wonReason  String?
  lostReason LostReason?
  lostNote   String?

  convertedProjectId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   CompanyMember @relation("OpportunityOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)

  sourceLead       Lead?    @relation("OpportunitySourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  convertedProject Project? @relation("OpportunityConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)

  proposals            Proposal[]
  contracts            Contract[]            @relation("ContractSourceOpportunity")
  // The units in this deal, and the reservations it holds (E-05E §17, §19).
  units                OpportunityUnit[]     @relation("OpportunityUnits")
  unitReservations     UnitReservation[]     @relation("UnitReservationOpportunity")
  unitContractRequests UnitContractRequest[] @relation("UnitContractRequestOpportunity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, stage])
  @@index([companyId, ownerMemberId])
  @@index([clientId])
  @@index([contactId])
  @@index([convertedProjectId])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("opportunities")
}

/// A commercial offer against an Opportunity (PRD #17 §104).
///
/// A Proposal is not an Invoice. It carries no receivable, settles nothing, and
/// the Finance module never reads it as one (PRD #17 §153).
model Proposal {
  id             String @id @default(cuid())
  companyId      String
  proposalNumber String
  opportunityId  String
  clientId       String

  title    String
  currency String @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  validUntil DateTime?

  status           ProposalStatus  @default(DRAFT)
  preArchiveStatus ProposalStatus?

  notes String?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  lineItems ProposalLineItem[]
  contracts Contract[]         @relation("ContractSourceProposal")
  invoices  Invoice[]          @relation("InvoiceSourceProposal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([opportunityId])
  @@index([clientId])
  @@index([validUntil])
  @@index([currency])
  @@index([updatedAt])
  @@map("proposals")
}

model ProposalLineItem {
  id         String @id @default(cuid())
  proposalId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId])
  @@map("proposal_line_items")
}

/// One approval cycle on a Proposal (PRD #17 §128, §129).
///
/// Shaped like FinanceApproval and kept separate on purpose: the two modules
/// grant approval authority through different permissions, and a shared table
/// would make "who may decide this?" a question about a row rather than about a
/// module (PRD #17 §19).
model SalesApproval {
  id        String @id @default(cuid())
  companyId String

  recordType SalesApprovalRecordType
  recordId   String

  status SalesApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("sales_approvals")
}

/// The canonical legal agreement record (PRD #18 §35, §528).
///
/// A Contract is not a Document and not a Proposal. The Proposal is the price
/// somebody offered, the Document is the file that was signed, and this is the
/// agreement's metadata and lifecycle — the only one of the three that has a
/// status, an owner and an expiry (PRD #18 §3).
///
/// `contractValue` and `expiryDate` are *current effective* values. Their
/// history is not overwritten but preserved in ContractAmendment, which is why
/// a signed contract is changed by amendment rather than by edit
/// (PRD #18 §330, §331).
model Contract {
  id             String       @id @default(cuid())
  companyId      String
  contractNumber String
  title          String
  contractType   ContractType

  clientId      String?
  projectId     String?
  /// Sales lineage (PRD #18 §56). Real foreign keys rather than loose ids, so
  /// a contract can never point at an opportunity that no longer exists.
  opportunityId String?
  proposalId    String?

  /// The internal business owner of the record. Ownership is not authority: it
  /// says who answers for the contract, never what they may do (PRD #18 §52).
  ownerMemberId String

  status           ContractStatus  @default(DRAFT)
  /// The status to return to on restore (PRD #18 §135).
  preArchiveStatus ContractStatus?

  /// A snapshot of the other side's legal name. Not the Client's name read
  /// live: the entity that signed is a historical fact (PRD #18 §61, §141).
  counterpartyName String?

  currency      String?  @db.VarChar(3)
  contractValue Decimal? @db.Decimal(18, 2)

  sentAt        DateTime?
  signedDate    DateTime?
  effectiveDate DateTime?
  expiryDate    DateTime?

  renewalType             ContractRenewalType @default(NONE)
  renewalNoticeDays       Int?
  autoRenewalPeriodMonths Int?

  governingLaw String?
  jurisdiction String?

  summary         String?
  /// Permission-gated. Visible only with `legal.commercial.view` (PRD #18 §79).
  commercialNotes String?
  /// Permission-gated. Visible only with `legal.confidential_terms.view`
  /// (PRD #18 §80).
  legalNotes      String?

  terminationDate      DateTime?
  terminationReason    String?
  terminatedByMemberId String?

  /// When its obligations were recorded as fulfilled (E-05F §83).
  completedAt         DateTime?
  completedByMemberId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner       CompanyMember @relation("ContractOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  opportunity Opportunity?  @relation("ContractSourceOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal    Proposal?     @relation("ContractSourceProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  parties     ContractParty[]
  obligations ContractObligation[]
  amendments  ContractAmendment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  contractorAssignments ProjectContractorAssignment[]
  workPackages          WorkPackage[]

  // A unit sale (E-05F): the units it sells, the requests it answered, and
  // Finance's schedules, installments, invoices and payments against it.
  units            ContractUnit[]
  unitRequests     UnitContractRequest[]
  paymentSchedules PaymentSchedule[]
  invoices         Invoice[]
  payments         Payment[]

  @@unique([companyId, contractNumber])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expiryDate])
  @@index([clientId])
  @@index([projectId])
  @@index([opportunityId])
  @@index([proposalId])
  @@index([ownerMemberId])
  @@index([contractType])
  @@index([effectiveDate])
  @@index([expiryDate])
  @@index([renewalType])
  @@index([currency])
  @@index([updatedAt])
  @@map("contracts")
}

/// A unit sold under a contract (E-05F §88-§90). One contract may sell an
/// apartment, its parking and its storage; the unit is referenced, never copied.
/// `value` is the unit's part of the contract value, starting from Sales' agreed
/// price; a different figure carries `valueNote`, and the agreed price on the
/// reservation is left as it was (§14).
///
/// `releasedAt` is set when the contract stops being the unit's contract —
/// cancelled, terminated, expired or archived — and a partial unique index keeps
/// one unreleased row per unit: the unit's one live contract (§8).
model ContractUnit {
  id         String @id @default(cuid())
  companyId  String
  projectId  String
  contractId String
  unitId     String

  value     Decimal? @db.Decimal(18, 2)
  currency  String?  @db.VarChar(3)
  valueNote String?

  releasedAt         DateTime?
  releasedByMemberId String?
  releaseReason      String?

  createdByMemberId String

  contract Contract    @relation(fields: [contractId, companyId], references: [id, companyId], onDelete: Restrict)
  unit     ProjectUnit @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, unitId])
  @@index([unitId])
  @@index([companyId, projectId])
  @@map("contract_units")
}

/// Sales asking Legal to draft a unit's contract (E-05F §12). Names the unit and
/// the reservation behind it; the client, deal and agreed price are read from the
/// reservation, never copied here. A partial unique index keeps one OPEN request
/// per unit.
model UnitContractRequest {
  id            String @id @default(cuid())
  companyId     String
  projectId     String
  unitId        String
  reservationId String
  clientId      String
  opportunityId String

  status UnitContractRequestStatus @default(OPEN)
  notes  String?

  requestedByMemberId String
  requestedAt         DateTime @default(now())

  contractId       String?
  closedByMemberId String?
  closedAt         DateTime?
  closeReason      String?

  unit        ProjectUnit     @relation(fields: [unitId, projectId, companyId], references: [id, projectId, companyId], onDelete: Restrict)
  reservation UnitReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  client      Client          @relation("UnitContractRequestClient", fields: [clientId], references: [id], onDelete: Restrict)
  opportunity Opportunity     @relation("UnitContractRequestOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict)
  contract    Contract?       @relation(fields: [contractId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, requestedAt])
  @@index([unitId, status])
  @@index([reservationId])
  @@index([contractId])
  @@map("unit_contract_requests")
}

/// A legal party to an agreement, stored as a snapshot (PRD #18 §137, §141).
///
/// `clientId` is traceability only. The name, legal name and address are what
/// the contract said at signing, so renaming the Client later must not rewrite
/// who signed (PRD #18 §329).
model ContractParty {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  partyRole ContractPartyRole
  partyType ContractPartyType

  name               String
  legalName          String?
  registrationNumber String?
  taxId              String?

  clientId String?

  address String?
  city    String?
  country String?

  signatoryName  String?
  signatoryTitle String?

  /// At most one per contract, enforced by a partial unique index in the
  /// migration and inside the transaction that sets it (PRD #18 §144, §236).
  isPrimaryCounterparty Boolean @default(false)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client   Client?  @relation("ContractPartyClient", fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([contractId])
  @@index([clientId])
  @@index([partyRole])
  @@map("contract_parties")
}

/// A contractual requirement with a date (PRD #18 §149).
///
/// An obligation is not a Task. The obligation is what the agreement requires;
/// a Task is work somebody does to satisfy it, and the Task lives in Tasks
/// where every other piece of work lives (PRD #18 §154).
model ContractObligation {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  title          String
  description    String?
  obligationType ContractObligationType

  responsibleMemberId String?
  dueDate             DateTime?

  status      ContractObligationStatus @default(OPEN)
  completedAt DateTime?

  /// Set when an amendment introduced the obligation (PRD #18 §337).
  sourceAmendmentId String?

  createdByMemberId String
  updatedByMemberId String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  responsibleMember CompanyMember?     @relation("ContractObligationResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  sourceAmendment   ContractAmendment? @relation("ObligationSourceAmendment", fields: [sourceAmendmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([contractId])
  @@index([responsibleMemberId])
  @@index([dueDate])
  @@index([obligationType])
  @@map("contract_obligations")
}

/// A legal change to an approved or signed Contract (PRD #18 §160).
///
/// The amendment does not replace the contract; activating it copies the new
/// value and expiry onto the contract and keeps the previous ones here, which
/// is how the contract carries a current figure and a history at the same time
/// (PRD #18 §174, §175).
model ContractAmendment {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  amendmentNumber String
  title           String
  summary         String

  status ContractAmendmentStatus @default(DRAFT)

  effectiveDate DateTime?
  signedDate    DateTime?

  /// The resulting value is authoritative; the delta is derived from it by the
  /// server so the two can never disagree (PRD #18 §167, §332).
  valueDelta       Decimal?  @db.Decimal(18, 2)
  newContractValue Decimal?  @db.Decimal(18, 2)
  newExpiryDate    DateTime?

  /// What the contract held before this amendment was activated, so activation
  /// is reversible evidence rather than an overwrite (PRD #18 §175).
  previousContractValue Decimal?  @db.Decimal(18, 2)
  previousExpiryDate    DateTime?
  activatedAt           DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  obligations ContractObligation[] @relation("ObligationSourceAmendment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, amendmentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([contractId])
  @@index([effectiveDate])
  @@index([newExpiryDate])
  @@map("contract_amendments")
}

/// One approval cycle on a Contract or an Amendment (PRD #18 §181, §182).
///
/// Shaped like FinanceApproval and SalesApproval and kept separate for the same
/// reason: the three modules grant approval authority through different
/// permissions, and a shared table would make "who may decide this?" a question
/// about a row rather than about a module (PRD #18 §526).
model ContractApproval {
  id        String @id @default(cuid())
  companyId String

  recordType ContractApprovalRecordType
  recordId   String

  status ContractApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("contract_approvals")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Procurement (PRD #19)
 */
/**
 * --------------------------------------------------------------------------
 */

/**
 * A supplier is who we buy from (PRD #19 §10, §26).
 * Deliberately its own record rather than a Client with a flag. A Client is who
 * pays us and a Supplier is who we pay, and the two answer different questions
 * even when the same organisation is both — which V0.1 records twice on purpose
 * (PRD #19 §3, §11).
 */
model Supplier {
  id        String @id @default(cuid())
  companyId String

  code         String?
  name         String
  legalName    String?
  supplierType SupplierType @default(COMPANY)

  email   String?
  phone   String?
  website String?

  taxId              String?
  registrationNumber String?

  address String?
  city    String?
  country String?

  status SupplierStatus @default(ACTIVE)

  /**
   * Used to date an invoice due from a receipt (PRD #19 §39).
   */
  paymentTermsDays Int?
  defaultCurrency  String? @db.VarChar(3)

  notes String?

  /**
   * Lower-cased, punctuation-stripped name for duplicate detection (§31).
   */
  normalizedName String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  rfqSuppliers   RFQSupplier[]
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  contractorProfiles  ContractorProfile[]
  technicalSubmittals TechnicalSubmittal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@index([normalizedName])
  @@index([taxId])
  @@index([registrationNumber])
  @@index([country])
  @@index([updatedAt])
  @@map("suppliers")
}

/**
 * A purchase request is somebody asking to buy something (PRD #19 §41).
 * It is a need, not a commitment. Nothing is owed to anybody until a purchase
 * order is issued, which is why the two are separate records rather than one
 * with a status (PRD #19 §3).
 */
model PurchaseRequest {
  id        String @id @default(cuid())
  companyId String

  requestNumber String
  title         String
  description   String?

  projectId    String?
  departmentId String?

  requestedByMemberId String
  ownerMemberId       String?

  requiredDate DateTime?
  priority     ProcurementPriority @default(MEDIUM)

  currency       String? @db.VarChar(3)
  estimatedTotal Decimal @default(0) @db.Decimal(18, 2)

  status           PurchaseRequestStatus  @default(DRAFT)
  preArchiveStatus PurchaseRequestStatus?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  rejectedAt         DateTime?
  rejectedByMemberId String?
  rejectionReason    String?
  cancelledAt        DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  requestedBy CompanyMember  @relation("PurchaseRequestRequester", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  owner       CompanyMember? @relation("PurchaseRequestOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  items          PurchaseRequestItem[]
  rfqs           RFQ[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([departmentId])
  @@index([requestedByMemberId])
  @@index([ownerMemberId])
  @@index([requiredDate])
  @@index([priority])
  @@index([updatedAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String @id @default(cuid())
  purchaseRequestId String

  description        String
  quantity           Decimal              @db.Decimal(18, 4)
  unit               String
  estimatedUnitPrice Decimal?             @db.Decimal(18, 4)
  estimatedAmount    Decimal              @default(0) @db.Decimal(18, 2)
  category           ProcurementCategory?
  specification      String?

  sortOrder Int @default(0)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseRequestId])
  @@index([category])
  @@map("purchase_request_items")
}

/**
 * A request for quotation: the same ask, sent to several suppliers (§64).
 */
model RFQ {
  id        String @id @default(cuid())
  companyId String

  rfqNumber String
  title     String

  purchaseRequestId String?
  projectId         String?

  currency        String    @db.VarChar(3)
  responseDueDate DateTime?

  status RFQStatus @default(DRAFT)

  issuedAt    DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  suppliers      RFQSupplier[]
  items          RFQItem[]
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, rfqNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([purchaseRequestId])
  @@index([projectId])
  @@index([responseDueDate])
  @@index([updatedAt])
  @@map("rfqs")
}

model RFQSupplier {
  id         String @id @default(cuid())
  rfqId      String
  supplierId String

  status      RFQSupplierStatus @default(INVITED)
  invitedAt   DateTime?
  respondedAt DateTime?

  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@map("rfq_suppliers")
}

model RFQItem {
  id                  String  @id @default(cuid())
  rfqId               String
  sourceRequestItemId String?

  description   String
  quantity      Decimal @db.Decimal(18, 4)
  unit          String
  specification String?
  sortOrder     Int     @default(0)

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  quoteItems SupplierQuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([sourceRequestItemId])
  @@map("rfq_items")
}

/**
 * What one supplier answered (PRD #19 §78).
 * A quote is commercially confidential to the buying side: one supplier must
 * never be shown another's price, which is why quote reads are gated separately
 * from the RFQ itself (PRD #19 §260).
 */
model SupplierQuote {
  id         String @id @default(cuid())
  companyId  String
  rfqId      String
  supplierId String

  quoteNumber String?
  quoteDate   DateTime
  validUntil  DateTime?

  currency String @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  leadTimeDays Int?
  deliveryDate DateTime?

  status SupplierQuoteStatus @default(DRAFT)

  disqualificationReason String?
  notes                  String?

  createdByMemberId String
  updatedByMemberId String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items          SupplierQuoteItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([rfqId])
  @@index([supplierId])
  @@index([quoteDate])
  @@index([validUntil])
  @@index([currency])
  @@map("supplier_quotes")
}

model SupplierQuoteItem {
  id              String @id @default(cuid())
  supplierQuoteId String
  rfqItemId       String

  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)
  taxRate   Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  notes String?

  supplierQuote SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  rfqItem       RFQItem       @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierQuoteId, rfqItemId])
  @@index([supplierQuoteId])
  @@index([rfqItemId])
  @@map("supplier_quote_items")
}

/**
 * A purchase order is the commitment (PRD #19 §95).
 * Issuing one is the moment the company owes somebody money, which is why it is
 * also the moment a Finance commitment appears (PRD #19 §116).
 */
model PurchaseOrder {
  id        String @id @default(cuid())
  companyId String

  poNumber   String
  supplierId String

  purchaseRequestId String?
  rfqId             String?
  supplierQuoteId   String?

  projectId           String?
  contractId          String?
  financeCommitmentId String?

  orderDate    DateTime
  requiredDate DateTime?
  currency     String    @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  /**
   * True once somebody edited a line the selected quote priced (§107).
   */
  modifiedFromQuote Boolean @default(false)

  status           PurchaseOrderStatus  @default(DRAFT)
  preArchiveStatus PurchaseOrderStatus?

  notes String?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  rejectedAt         DateTime?
  rejectedByMemberId String?
  rejectionReason    String?
  issuedAt           DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  rfq             RFQ?             @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  supplierQuote   SupplierQuote?   @relation(fields: [supplierQuoteId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract        Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([projectId])
  @@index([purchaseRequestId])
  @@index([rfqId])
  @@index([supplierQuoteId])
  @@index([contractId])
  @@index([financeCommitmentId])
  @@index([orderDate])
  @@index([requiredDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String

  sourceRequestItemId String?
  sourceQuoteItemId   String?

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unit        String

  unitPrice Decimal @db.Decimal(18, 4)
  taxRate   Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([sourceRequestItemId])
  @@index([sourceQuoteItemId])
  @@map("purchase_order_items")
}

/**
 * What actually turned up (PRD #19 §132).
 * Receipts are additive: a correction is a new receipt or a void, never an edit
 * of what was recorded as delivered (PRD #19 §143, §144).
 */
model GoodsReceipt {
  id        String @id @default(cuid())
  companyId String

  receiptNumber   String
  purchaseOrderId String
  projectId       String?
  supplierId      String

  receiptDate       DateTime
  deliveryReference String?

  status GoodsReceiptStatus @default(RECORDED)

  receivedByMemberId String
  notes              String?

  createdByMemberId String
  voidedByMemberId  String?
  voidedAt          DateTime?
  voidReason        String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  receivedBy CompanyMember @relation("GoodsReceiptReceiver", fields: [receivedByMemberId], references: [id], onDelete: Restrict)

  items GoodsReceiptItem[]

  inspectionRequests    InspectionRequest[]
  qualityInspections    QualityInspection[]
  nonConformanceReports NonConformanceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([supplierId])
  @@index([receiptDate])
  @@index([receivedByMemberId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String

  receivedQuantity Decimal @db.Decimal(18, 4)
  acceptedQuantity Decimal @db.Decimal(18, 4)
  rejectedQuantity Decimal @db.Decimal(18, 4)

  notes String?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  inspectionRequests    InspectionRequest[]
  qualityInspections    QualityInspection[]
  materialDecisions     MaterialInspectionDecision[]
  materialReleases      QualityMaterialRelease[]
  nonConformanceReports NonConformanceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

/**
 * One approval cycle, on a request or an order (PRD #19 §148).
 */
model ProcurementApproval {
  id        String @id @default(cuid())
  companyId String

  recordType ProcurementApprovalRecordType
  recordId   String

  status ProcurementApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("procurement_approvals")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Inventory (PRD #20)
 */
/**
 * --------------------------------------------------------------------------
 */

/**
 * An inventory item is a *kind* of thing, not a quantity of it (PRD #20 §25).
 * How much exists lives in InventoryBalance, one row per item per location, and
 * every change to it is a row in StockMovement. Putting a `quantity` column on
 * the item is what makes stock figures that nobody can explain.
 */
model InventoryItem {
  id        String @id @default(cuid())
  companyId String

  sku         String
  name        String
  description String?

  category InventoryItemCategory
  /// The unit every movement of this item is measured in. Immutable once stock
  /// exists: changing it would silently reinterpret history (PRD #20 §46).
  baseUnit String

  status InventoryItemStatus @default(ACTIVE)

  minimumStock Decimal? @db.Decimal(18, 4)
  reorderPoint Decimal? @db.Decimal(18, 4)

  defaultWarehouseId String?
  defaultLocationId  String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  balances        InventoryBalance[]
  movements       StockMovement[]
  receiptLines    InventoryReceiptLine[]
  issueLines      StockIssueLine[]
  returnLines     StockReturnLine[]
  transferLines   StockTransferLine[]
  adjustmentLines StockAdjustmentLine[]
  reservations    StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, status])
  @@index([category])
  @@index([name])
  @@index([updatedAt])
  @@map("inventory_items")
}

/**
 * Where stock is held (PRD #20 §49).
 */
model Warehouse {
  id        String @id @default(cuid())
  companyId String

  code        String
  name        String
  description String?

  warehouseType WarehouseType
  projectId     String?

  address String?
  city    String?
  country String?

  status WarehouseStatus @default(ACTIVE)

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  locations InventoryLocation[]
  balances  InventoryBalance[]
  movements StockMovement[]

  inventoryReceipts InventoryReceipt[]
  stockIssues       StockIssue[]
  stockReturns      StockReturn[]

  transfersFrom StockTransfer[] @relation("StockTransferFromWarehouse")
  transfersTo   StockTransfer[] @relation("StockTransferToWarehouse")

  adjustments  StockAdjustment[]
  reservations StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseType])
  @@index([projectId])
  @@index([city])
  @@map("warehouses")
}

/**
 * A bin, bay or yard inside a warehouse (PRD #20 §61).
 * Balances hang off the location rather than the warehouse, so "where is it"
 * has one answer. Every warehouse gets a default location, because a warehouse
 * with no location has nowhere to put stock (PRD #20 §64).
 */
model InventoryLocation {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String

  code        String
  name        String?
  description String?

  status InventoryLocationStatus @default(ACTIVE)

  /// The one location a warehouse uses when nobody picks another (§64).
  isDefault Boolean @default(false)

  createdByMemberId String
  updatedByMemberId String?
  archivedAt        DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  balances     InventoryBalance[]
  movements    StockMovement[]
  receiptLines InventoryReceiptLine[]
  issueLines   StockIssueLine[]
  returnLines  StockReturnLine[]

  transferFromLines StockTransferLine[] @relation("StockTransferFromLocation")
  transferToLines   StockTransferLine[] @relation("StockTransferToLocation")

  adjustmentLines StockAdjustmentLine[]
  reservations    StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@map("inventory_locations")
}

/**
 * What is where, right now (PRD #20 §79–§83).
 * A projection of the movement ledger, never a source of truth. It exists
 * because summing every movement ever recorded to answer "how many bags of
 * cement are on site" does not scale — but it can always be rebuilt from the
 * ledger, and a repair that disagrees with the ledger is a bug in the
 * projection, never a correction to history (PRD #20 §82, §83).
 * `availableQuantity` is `onHand - reserved`, stored so it can be indexed and
 * filtered on (PRD #20 §76).
 */
model InventoryBalance {
  id              String @id @default(cuid())
  companyId       String
  inventoryItemId String
  warehouseId     String
  locationId      String

  onHandQuantity    Decimal @default(0) @db.Decimal(18, 4)
  reservedQuantity  Decimal @default(0) @db.Decimal(18, 4)
  availableQuantity Decimal @default(0) @db.Decimal(18, 4)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([inventoryItemId, locationId])
  @@index([companyId])
  @@index([warehouseId])
  @@index([inventoryItemId])
  @@index([availableQuantity])
  @@map("inventory_balances")
}

/**
 * The stock ledger (PRD #20 §67, §70, §71).
 * Append-only. A movement is never edited or deleted: a mistake is corrected by
 * a REVERSAL row that points at the one it undoes, so the history of what
 * somebody believed at the time survives the correction.
 * `signedQuantity` carries the direction — negative for anything leaving — so
 * a balance is the sum of a single column rather than a case statement over
 * movement types (PRD #20 §71).
 */
model StockMovement {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  warehouseId     String
  locationId      String

  movementType StockMovementType

  quantity       Decimal @db.Decimal(18, 4)
  signedQuantity Decimal @db.Decimal(18, 4)
  unit           String

  projectId String?

  /// Where this came from, so a movement can always be traced back to the
  /// document that caused it (PRD #20 §179, §291, §292).
  sourceModule     String
  sourceEntityType String
  sourceEntityId   String
  sourceLineId     String?

  reversalOfMovementId String?

  occurredAt       DateTime
  postedByMemberId String

  notes String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  reversalOf StockMovement?  @relation("StockMovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: Restrict)
  reversals  StockMovement[] @relation("StockMovementReversal")

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, occurredAt])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([projectId])
  @@index([movementType])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@index([sourceLineId])
  @@index([reversalOfMovementId])
  @@map("stock_movements")
}

/**
 * Stock coming in, usually from a Procurement delivery (PRD #20 §84).
 */
model InventoryReceipt {
  id        String @id @default(cuid())
  companyId String

  receiptNumber  String
  /// The Procurement goods receipt this was posted from, when there is one.
  /// Unique so one delivery cannot be booked into stock twice (PRD #20 §91).
  goodsReceiptId String?

  warehouseId String

  status InventoryTransactionStatus @default(DRAFT)

  receiptDate DateTime
  postedAt    DateTime?
  reversedAt  DateTime?

  createdByMemberId  String
  postedByMemberId   String?
  reversedByMemberId String?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines InventoryReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, receiptNumber])
  @@unique([goodsReceiptId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([postedAt])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id                 String @id @default(cuid())
  inventoryReceiptId String

  goodsReceiptItemId String?

  inventoryItemId String
  locationId      String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  movementId String?

  notes String?

  inventoryReceipt InventoryReceipt  @relation(fields: [inventoryReceiptId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryReceiptId])
  @@index([goodsReceiptItemId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([movementId])
  @@map("inventory_receipt_lines")
}

/**
 * Stock going out to a project or a person (PRD #20 §104).
 */
model StockIssue {
  id        String @id @default(cuid())
  companyId String

  issueNumber String
  projectId   String?
  warehouseId String

  status InventoryTransactionStatus @default(DRAFT)

  issueDate           DateTime
  issuedToMemberId    String?
  requestedByMemberId String?

  createdByMemberId String
  postedByMemberId  String?

  cancelledAt DateTime?
  reversedAt  DateTime?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines StockIssueLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, issueNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([warehouseId])
  @@index([issueDate])
  @@index([issuedToMemberId])
  @@map("stock_issues")
}

model StockIssueLine {
  id           String @id @default(cuid())
  stockIssueId String

  inventoryItemId String
  locationId      String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  reservationId String?
  movementId    String?

  notes String?

  stockIssue    StockIssue        @relation(fields: [stockIssueId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockIssueId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([reservationId])
  @@index([movementId])
  @@map("stock_issue_lines")
}

/**
 * Unused material coming back from a project (PRD #20 §121).
 */
model StockReturn {
  id        String @id @default(cuid())
  companyId String

  returnNumber String
  projectId    String
  warehouseId  String

  returnDate DateTime
  status     InventoryTransactionStatus @default(DRAFT)

  returnedByMemberId String?

  createdByMemberId String
  postedByMemberId  String?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines StockReturnLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, returnNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([warehouseId])
  @@index([returnDate])
  @@map("stock_returns")
}

model StockReturnLine {
  id            String @id @default(cuid())
  stockReturnId String

  inventoryItemId String
  locationId      String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  sourceIssueLineId String?
  movementId        String?

  notes String?

  stockReturn   StockReturn       @relation(fields: [stockReturnId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockReturnId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([sourceIssueLineId])
  @@index([movementId])
  @@map("stock_return_lines")
}

/**
 * Stock moving between locations (PRD #20 §129).
 * Posts two movements per line — out of one location, into another — in one
 * transaction, so total stock never changes and the two halves cannot be
 * separated (PRD #20 §137, §138).
 */
model StockTransfer {
  id        String @id @default(cuid())
  companyId String

  transferNumber String

  fromWarehouseId String
  toWarehouseId   String

  transferDate DateTime
  status       InventoryTransactionStatus @default(DRAFT)

  createdByMemberId String
  postedByMemberId  String?

  notes String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromWarehouse Warehouse @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  lines StockTransferLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, transferNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([transferDate])
  @@map("stock_transfers")
}

model StockTransferLine {
  id              String @id @default(cuid())
  stockTransferId String

  inventoryItemId String

  fromLocationId String
  toLocationId   String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  outMovementId String?
  inMovementId  String?

  notes String?

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  fromLocation InventoryLocation @relation("StockTransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   InventoryLocation @relation("StockTransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockTransferId])
  @@index([inventoryItemId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("stock_transfer_lines")
}

/**
 * A correction to what the system believes is there (PRD #20 §141).
 * Always carries a reason, because "the number changed" with no explanation is
 * exactly what an inventory audit exists to catch (PRD #20 §144).
 */
model StockAdjustment {
  id        String @id @default(cuid())
  companyId String

  adjustmentNumber String
  warehouseId      String

  adjustmentDate DateTime
  reason         StockAdjustmentReason

  status InventoryTransactionStatus @default(DRAFT)

  createdByMemberId String
  postedByMemberId  String?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines StockAdjustmentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, adjustmentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([adjustmentDate])
  @@index([reason])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                String @id @default(cuid())
  stockAdjustmentId String

  inventoryItemId String
  locationId      String

  /// Signed: negative writes stock off, positive writes it on (PRD #20 §147).
  quantityDelta Decimal @db.Decimal(18, 4)
  unit          String

  movementId String?

  notes String?

  stockAdjustment StockAdjustment   @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockAdjustmentId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([movementId])
  @@map("stock_adjustment_lines")
}

/**
 * Stock spoken for but not yet issued (PRD #20 §152).
 * A reservation moves quantity from available to reserved without moving it out
 * of the warehouse. It writes no ledger row, because nothing has physically
 * happened (PRD #20 §166).
 */
model StockReservation {
  id        String @id @default(cuid())
  companyId String

  reservationNumber String

  inventoryItemId String
  warehouseId     String
  locationId      String

  projectId String?

  quantity          Decimal @db.Decimal(18, 4)
  fulfilledQuantity Decimal @default(0) @db.Decimal(18, 4)

  status StockReservationStatus @default(ACTIVE)

  requiredDate DateTime?
  expiresAt    DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reservationNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([projectId])
  @@index([requiredDate])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model QualityRecord {
  id               String            @id @default(cuid())
  companyId        String
  projectId        String?
  assignedMemberId String?
  reference        String
  type             QualityRecordType
  title            String
  description      String?
  severity         RecordSeverity?
  status           WorkRecordStatus  @default(OPEN)
  dueDate          DateTime?
  closedAt         DateTime?

  createdBy String
  updatedBy String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee CompanyMember? @relation("QualityAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([type])
  @@map("quality_records")
}

model HseRecord {
  id               String           @id @default(cuid())
  companyId        String
  projectId        String?
  assignedMemberId String?
  reference        String
  type             HseRecordType
  title            String
  description      String?
  severity         RecordSeverity?
  status           WorkRecordStatus @default(OPEN)
  occurredAt       DateTime?
  closedAt         DateTime?

  createdBy String
  updatedBy String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee CompanyMember? @relation("HseAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([type])
  @@map("hse_records")
}

model SupportRequest {
  id                String               @id @default(cuid())
  companyId         String
  requestedMemberId String?
  reference         String
  subject           String
  body              String?
  status            SupportRequestStatus @default(OPEN)

  createdBy String
  updatedBy String?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requester CompanyMember? @relation("SupportRequester", fields: [requestedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@map("support_requests")
}

// ---------------------------------------------------------------------------
// Company configuration (PRD #24, consolidated per PRD #37 §24, §114, §116)
//
// Company-wide runtime configuration lives in the database, never in
// environment variables or frontend constants (PRD #24 §4). None of it grants
// permission: a module being enabled does not authorise a user (PRD #24 §7).
// ---------------------------------------------------------------------------

enum NumberingMode {
  MANUAL
  AUTO
}

enum NumberingYearMode {
  NONE
  YYYY
  YY
}

/// One row per Company. The canonical owner of locale, timezone, base currency
/// and fiscal defaults — FinanceSettings defers to this rather than duplicating
/// it (PRD #24 §40-§43, PRD #37 §24).
model CompanySettings {
  id        String @id @default(cuid())
  companyId String @unique

  /// BCP 47. Presentation only (PRD #24 §25).
  locale     String @default("en")
  /// IANA name, never a raw UTC offset (PRD #24 §26). Timestamps stay UTC.
  timezone   String @default("UTC")
  dateFormat String @default("DD/MM/YYYY")

  /// ISO 4217. A base currency implies no FX support whatsoever (PRD #24 §32).
  baseCurrency            String       @default("EUR") @db.VarChar(3)
  fiscalYearStartMonth    Int          @default(1)
  defaultPaymentTermsDays Int          @default(30)
  /// How long a unit reservation lasts unless the person reserving chooses otherwise (E-05E §24).
  unitReservationDays     Int          @default(7)
  /// What a unit needs before Sales may mark it Sold (E-05F §42, §43).
  unitSoldRule            UnitSoldRule @default(SIGNED_CONTRACT)
  defaultTaxRate          Decimal?     @db.Decimal(9, 4)

  /// The working day and week the calendar shades against (PRD #39 §91, §92).
  /// Local wall-clock times in `timezone`, "HH:MM".
  workingDayStart     String @default("08:00")
  workingDayEnd       String @default("17:00")
  /// ISO weekdays: 1 = Monday … 7 = Sunday.
  workingDays         Int[]  @default([1, 2, 3, 4, 5])
  defaultCalendarView String @default("week")

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseCurrency])
  @@index([timezone])
  @@map("company_settings")
}

/// Product-defined cross-module behaviours a Company may switch on. These are
/// not a workflow builder — each flag maps to one implemented integration
/// (PRD #24 §71-§76, PRD #37 §116).
model CompanyIntegrationSettings {
  id        String @id @default(cuid())
  companyId String @unique

  /// Goods Receipt must pass QA before Inventory may post (PRD #24 §77).
  qualityGateForInventoryReceipts           Boolean @default(false)
  /// Approving a Purchase Order opens a Finance Commitment (PRD #24 §82).
  autoCreateFinanceCommitmentFromApprovedPo Boolean @default(true)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_integration_settings")
}

/// How human-readable business numbers are generated. Database ids stay cuid;
/// these are the numbers people quote to each other (PRD #24 §86-§99,
/// PRD #37 §114). Allocation takes a row lock; numbers are never recycled.
model CompanyNumberingScheme {
  id        String @id @default(cuid())
  companyId String

  moduleKey  String
  entityType String

  mode                NumberingMode     @default(MANUAL)
  prefix              String?
  separator           String            @default("-")
  yearMode            NumberingYearMode @default(YYYY)
  padding             Int               @default(4)
  resetSequenceYearly Boolean           @default(true)

  currentYear  Int?
  nextSequence Int  @default(1)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleKey, entityType])
  @@index([companyId])
  @@index([moduleKey, entityType])
  @@map("company_numbering_schemes")
}

// ---------------------------------------------------------------------------
// Audit (PRD #28, consolidated per PRD #37 §109-§112)
//
// Audit is evidence, not history. Activity tells a user what happened to a
// record; AuditEvent proves who did it, when, from where, and what changed
// (PRD #28 §3-§6). It is append-only: the repository exposes no update and no
// delete, and no user-facing route can reach one (PRD #28 §10-§12).
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  INTEGRATION
}

enum AuditCategory {
  AUTHENTICATION
  ACCESS_CONTROL
  CONFIGURATION
  FINANCIAL
  LEGAL
  PROCUREMENT
  INVENTORY
  QUALITY
  HSE
  HR
  SALES
  PROJECT
  DOCUMENT
  REPORTING
  SYSTEM
  /// Comments, mentions and watchers on business records (PRD #38 §35).
  COLLABORATION
  /// Calendar-owned events, participants and visibility (PRD #39 §112).
  CALENDAR
  /// Meetings, minutes, decisions and action items (PRD #40 §181).
  MEETING
  /// Approval cycles, chain steps, delegations and reassignments (PRD #41 §56).
  APPROVAL
  /// Work logs, weekly timesheets, their decisions and settings (PRD #42 §112).
  TIMESHEET
  /// Daily site records, their review, locking, voids and corrections (PRD #43 §193).
  DAILY_LOG
  /// Internal announcements: publishing, scheduling, pinning, expiry and archive (PRD #45 §54).
  ANNOUNCEMENT
  /// Contractor organisations, project assignments, work packages and compliance (PRD #46 §229).
  CONTRACTOR
  /// Engineering documents, revisions and reviews, RFIs, submittals and transmittals (PRD #46 §229).
  ENGINEERING
}

enum AuditSeverity {
  INFO
  IMPORTANT
  CRITICAL
}

model AuditEvent {
  id            String  @id @default(cuid())
  /// Null for an event that belongs to no one company: creating a parent group,
  /// appointing a group head, a person HR created before any employment
  /// (E-06 §114). `parentGroupId` places those; a company event carries both.
  companyId     String?
  parentGroupId String?

  occurredAt DateTime @default(now())

  actorType                AuditActorType
  actorUserId              String?
  actorMemberId            String?
  /// Kept as a snapshot so a historical event still reads correctly after the
  /// member is renamed, changes role or leaves (PRD #28 §17, §219).
  actorDisplayNameSnapshot String?
  actorRoleSnapshot        String?

  moduleKey String
  category  AuditCategory
  severity  AuditSeverity @default(INFO)

  actionKey String

  entityType          String?
  entityId            String?
  entityLabelSnapshot String?

  projectId String?

  /// Minimal, redacted snapshots — never a copy of the whole record, and never
  /// a secret (PRD #28 §33, §38, §112).
  beforeJson  Json?
  afterJson   Json?
  changesJson Json?

  reason       String?
  metadataJson Json?

  correlationId String?
  requestId     String?

  ipAddress String?
  userAgent String?

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentGroup ParentGroup? @relation(fields: [parentGroupId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId, occurredAt, id])
  @@index([parentGroupId, occurredAt, id])
  @@index([companyId, actionKey, occurredAt])
  @@index([companyId, moduleKey, occurredAt])
  @@index([companyId, category, occurredAt])
  @@index([companyId, severity, occurredAt])
  @@index([actorMemberId, occurredAt])
  @@index([entityType, entityId])
  @@index([projectId, occurredAt])
  @@index([correlationId])
  @@index([requestId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Cross-module integration (PRD #23, consolidated per PRD #37 §106-§108)
//
// One concept has one canonical owner. When a Sales quote becomes an invoice,
// Finance owns the invoice — Sales never becomes Finance (PRD #23 §4, §341).
// These two models are the provenance and the idempotency: the link records
// that a handoff happened, the attempt records that it was tried.
// ---------------------------------------------------------------------------

enum IntegrationMode {
  REFERENCE
  CREATE_FROM
  SYNCHRONIZE
}

enum IntegrationLinkStatus {
  ACTIVE
  CANCELLED
  SUPERSEDED
  FAILED
}

enum IntegrationAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  SKIPPED
}

/// A durable source-to-target relationship between two modules (PRD #23 §18-§24).
model IntegrationLink {
  id        String @id @default(cuid())
  companyId String

  integrationType String
  mode            IntegrationMode @default(CREATE_FROM)

  sourceModule     String
  sourceEntityType String
  sourceEntityId   String

  targetModule     String
  targetEntityType String
  targetEntityId   String

  status IntegrationLinkStatus @default(ACTIVE)

  /// The uniqueness that makes a retry safe: the same source cannot produce a
  /// second target (PRD #23 §21, §45, §230).
  idempotencyKey String

  correlationId     String?
  createdByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, integrationType, idempotencyKey])
  @@index([companyId])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@index([targetModule, targetEntityType, targetEntityId])
  @@index([status])
  @@index([correlationId])
  @@map("integration_links")
}

/// Technical orchestration history, kept out of business Activity (PRD #23 §156-§161).
model IntegrationAttempt {
  id        String @id @default(cuid())
  companyId String

  integrationType String

  sourceModule     String
  sourceEntityType String
  sourceEntityId   String

  idempotencyKey String
  correlationId  String

  status        IntegrationAttemptStatus @default(STARTED)
  errorCode     String?
  attemptNumber Int                      @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([integrationType])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@index([idempotencyKey])
  @@index([correlationId])
  @@index([status])
  @@map("integration_attempts")
}

// ---------------------------------------------------------------------------
// Notifications and attention (PRD #25, consolidated per PRD #37 §101-§105)
//
// Four separate things, kept separate on purpose: Activity is what happened,
// a Notification is what one person was told, an AttentionItem is what still
// needs doing, and a Task is the work itself (PRD #25 §2, §364).
// ---------------------------------------------------------------------------

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationReadState {
  UNREAD
  READ
}

enum AttentionStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum NotificationEventGroup {
  ASSIGNMENTS
  APPROVALS
  DEADLINES
  CRITICAL_ALERTS
  STATUS_UPDATES
  REMINDERS
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// A message directed at one member. Title and body are written after the
/// recipient has been authorised, so a stored notification is already safe for
/// the person who will read it (PRD #25 §49, §194).
model Notification {
  id                String @id @default(cuid())
  companyId         String
  recipientMemberId String

  eventType String
  moduleKey String

  entityType String?
  entityId   String?
  projectId  String?

  title String
  body  String?

  priority  NotificationPriority  @default(NORMAL)
  readState NotificationReadState @default(UNREAD)

  /// One notification per event per recipient (PRD #25 §60-§62).
  dedupeKey String
  /// The registry category, for preferences and filtering (PRD #38 §75, §78).
  category  String?
  /// Set once the email copy of this notification was handed to the mail service.
  emailedAt DateTime?

  readAt DateTime?

  actorMemberId String?
  correlationId String?

  metadataJson Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([companyId, recipientMemberId, dedupeKey])
  @@index([companyId])
  @@index([recipientMemberId, readState, createdAt])
  @@index([recipientMemberId, createdAt])
  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([priority])
  @@index([dedupeKey])
  @@index([correlationId])
  @@map("notifications")
}

/// An unresolved condition, not an event. It disappears when the condition
/// stops being true — paying the invoice is what clears it, not reading about
/// it (PRD #25 §13-§15, §77).
model AttentionItem {
  id                String @id @default(cuid())
  companyId         String
  recipientMemberId String

  conditionKey String
  moduleKey    String

  entityType String
  entityId   String
  projectId  String?

  title String
  body  String?

  priority    NotificationPriority @default(NORMAL)
  status      AttentionStatus      @default(ACTIVE)
  /// Some conditions may not be waved away: an active Stop Work is not a
  /// notification you dismiss (PRD #25 §79).
  dismissible Boolean              @default(true)

  firstDetectedAt DateTime  @default(now())
  lastEvaluatedAt DateTime  @default(now())
  resolvedAt      DateTime?
  dismissedAt     DateTime?

  dedupeKey String

  metadataJson Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, recipientMemberId, dedupeKey])
  @@index([recipientMemberId, status, priority])
  @@index([recipientMemberId, lastEvaluatedAt])
  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([projectId])
  @@map("attention_items")
}

/// Per-membership delivery preferences. Mandatory critical alerts ignore them
/// (PRD #25 §85, §340).
model NotificationPreference {
  id        String @id @default(cuid())
  companyId String
  memberId  String

  /// Superseded by `category` (PRD #38 §78). Kept, nullable, because dropping
  /// a column is not an additive migration; nothing reads or writes it.
  moduleKey  String?
  eventGroup NotificationEventGroup?
  /// A notification category from the event registry: tasks, mentions,
  /// approvals, documents, qa_qc, hse, hr, contracts, procurement, …
  category   String?

  inAppEnabled Boolean @default(true)
  emailEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, memberId, moduleKey, eventGroup])
  @@unique([companyId, memberId, category])
  @@index([memberId])
  @@index([companyId])
  @@index([moduleKey])
  @@map("notification_preferences")
}

/// The durable handoff between a business transaction and notification
/// delivery. Enqueued in the same transaction as the mutation, so a rolled-back
/// action never notifies anybody (PRD #25 §26, §27, §240).
model NotificationEventOutbox {
  id        String @id @default(cuid())
  companyId String

  eventType  String
  moduleKey  String
  entityType String
  entityId   String

  actorMemberId String?
  projectId     String?

  payloadJson   Json
  correlationId String?

  status         NotificationOutboxStatus @default(PENDING)
  /// Lease: a worker claims a batch with FOR UPDATE SKIP LOCKED and holds it
  /// until `leaseExpiresAt`. A worker that dies mid-batch leaves a lease that
  /// expires and is claimed again (PRD #38 §80, §96).
  lockedAt       DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  /// Attempts started, counted when the row is claimed — so a worker that
  /// crashes mid-event still spends one, and a poison event reaches FAILED
  /// instead of being claimed forever (PRD #51 §34, §272).
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime?
  processedAt    DateTime?
  lastError      String?
  /// A normalised failure code (PRD #51 §123); the history of every failed
  /// attempt is in `job_failures`, which a manual retry never erases (§39).
  lastErrorCode  String?
  failedAt       DateTime?
  manualRetries  Int                      @default(0)
  /// The payload's shape. A worker refuses, visibly, a version newer than it
  /// understands, and leaves it for a worker that does (PRD #51 §223-§225).
  schemaVersion  Int                      @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([companyId])
  @@index([eventType])
  @@index([createdAt])
  @@index([correlationId])
  @@map("notification_event_outbox")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * QA/QC (PRD #21)
 */
/**
 * --------------------------------------------------------------------------
 */

/**
 * Quality is a decision about material or work, made by somebody accountable
 * for it, and recorded so it can be re-read later (PRD #21 §2).
 * Three ideas that look alike and are not (PRD #21 §3):
 * - an *inspection* is the act of looking, with a result,
 * - a *defect* is a fault on a job that somebody must fix,
 * - an *NCR* is a formal statement that something did not meet requirement,
 * which needs a root cause and a corrective action before it can close.
 * Quantities are Decimal throughout: a rejected quantity that a JSON parser has
 * rounded is a quantity nobody can reconcile against the delivery it came from
 * (PRD #21 §220).
 */

enum QualityInspectionType {
  MATERIAL
  WORK
  GENERAL
}

enum QualityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InspectionResponseType {
  PASS_FAIL
  PASS_FAIL_NA
  TEXT
  NUMBER
  BOOLEAN
}

enum QualityInspectionStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

/// NOT_SET is the honest default: an inspection nobody has finished has no
/// verdict, and "PASS until proven otherwise" would be a lie (PRD #21 §64).
enum QualityInspectionResult {
  NOT_SET
  PASS
  FAIL
  CONDITIONAL
}

enum ChecklistItemResult {
  PASS
  FAIL
  NA
}

enum QualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QualityDefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
  REOPENED
}

enum NCRCategory {
  MATERIAL
  WORKMANSHIP
  DOCUMENTATION
  PROCESS
  SUPPLIER
  DESIGN
  OTHER
}

enum NCRStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED_FOR_CLOSE
  CLOSED
  REJECTED
  CANCELLED
  REOPENED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CANCELLED
  REOPENED
}

enum QualityApprovalRecordType {
  INSPECTION
  NCR
}

enum QualityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MaterialReleaseStatus {
  RELEASED
  PARTIALLY_RELEASED
  HELD
  REJECTED
  REVOKED
}

/// Somebody asking for an inspection is not the inspection (PRD #21 §34).
model InspectionRequest {
  id        String @id @default(cuid())
  companyId String

  requestNumber  String
  title          String
  inspectionType QualityInspectionType

  projectId          String?
  goodsReceiptId     String?
  goodsReceiptItemId String?

  requestedByMemberId       String
  assignedInspectorMemberId String?

  requestedDate  DateTime
  requiredByDate DateTime?

  priority QualityPriority         @default(MEDIUM)
  status   InspectionRequestStatus @default(OPEN)

  description  String?
  locationText String?

  createdByMemberId String
  updatedByMemberId String?

  cancelledAt DateTime?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  requestedBy       CompanyMember  @relation("InspectionRequester", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  assignedInspector CompanyMember? @relation("InspectionRequestInspector", fields: [assignedInspectorMemberId], references: [id], onDelete: SetNull)

  inspections QualityInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([goodsReceiptId])
  @@index([goodsReceiptItemId])
  @@index([requestedByMemberId])
  @@index([assignedInspectorMemberId])
  @@index([requiredByDate])
  @@index([priority])
  @@map("inspection_requests")
}

/// The checklist a company inspects against. Versioned, never edited in place
/// once used, so a past inspection still reads against what it was actually
/// checked with (PRD #21 §53).
model InspectionTemplate {
  id        String @id @default(cuid())
  companyId String

  code           String
  name           String
  inspectionType QualityInspectionType
  description    String?

  status  InspectionTemplateStatus @default(ACTIVE)
  version Int                      @default(1)

  createdByMemberId String
  updatedByMemberId String?
  archivedAt        DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items       InspectionTemplateItem[]
  inspections QualityInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([inspectionType])
  @@index([code])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id                   String @id @default(cuid())
  inspectionTemplateId String

  code        String?
  label       String
  description String?

  responseType InspectionResponseType
  required     Boolean                @default(true)
  sortOrder    Int                    @default(0)

  passCriteriaText       String?
  requiresEvidenceOnFail Boolean @default(false)

  template InspectionTemplate @relation(fields: [inspectionTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionTemplateId])
  @@index([sortOrder])
  @@map("inspection_template_items")
}

/// The act of looking, and its verdict (PRD #21 §59).
model QualityInspection {
  id        String @id @default(cuid())
  companyId String

  inspectionNumber String
  inspectionType   QualityInspectionType

  requestId       String?
  templateId      String?
  templateVersion Int?

  parentInspectionId   String?
  reinspectionSequence Int?

  projectId          String?
  goodsReceiptId     String?
  goodsReceiptItemId String?

  assignedInspectorMemberId String
  executedByMemberId        String?

  status QualityInspectionStatus @default(DRAFT)
  result QualityInspectionResult @default(NOT_SET)

  inspectionDate DateTime?
  submittedAt    DateTime?

  approvedAt         DateTime?
  approvedByMemberId String?

  rejectedAt         DateTime?
  rejectedByMemberId String?

  closedAt         DateTime?
  closedByMemberId String?
  cancelledAt      DateTime?

  locationText           String?
  workReference          String?
  drawingReference       String?
  specificationReference String?

  summary      String?
  decisionNote String?

  createdByMemberId String
  updatedByMemberId String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  request  InspectionRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  template InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  assignedInspector CompanyMember  @relation("QualityInspector", fields: [assignedInspectorMemberId], references: [id], onDelete: Restrict)
  executedBy        CompanyMember? @relation("QualityInspectionExecutor", fields: [executedByMemberId], references: [id], onDelete: SetNull)

  parentInspection QualityInspection?  @relation("QualityReinspection", fields: [parentInspectionId], references: [id], onDelete: SetNull)
  reinspections    QualityInspection[] @relation("QualityReinspection")

  checklistItems    InspectionChecklistItem[]
  materialDecisions MaterialInspectionDecision[]
  materialReleases  QualityMaterialRelease[]
  defects           QualityDefect[]
  ncrs              NonConformanceReport[]
  correctiveActions CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, inspectionNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, result])
  @@index([projectId])
  @@index([requestId])
  @@index([templateId])
  @@index([parentInspectionId])
  @@index([goodsReceiptId])
  @@index([goodsReceiptItemId])
  @@index([assignedInspectorMemberId])
  @@index([inspectionDate])
  @@map("quality_inspections")
}

/// A snapshot of the template, taken when the inspection was created. Editing
/// the template afterwards must not rewrite what somebody actually checked
/// (PRD #21 §69).
model InspectionChecklistItem {
  id           String @id @default(cuid())
  inspectionId String

  templateItemId String?

  code        String?
  label       String
  description String?

  responseType InspectionResponseType
  required     Boolean                @default(true)
  sortOrder    Int                    @default(0)

  responseValue String?
  result        ChecklistItemResult?
  note          String?

  /// Copied from the template alongside the question, so a five-year-old
  /// inspection still says what "pass" meant on the day (PRD #21 §69).
  passCriteriaText       String?
  requiresEvidenceOnFail Boolean @default(false)

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@index([sortOrder])
  @@index([result])
  @@map("inspection_checklist_items")
}

/// How much of a delivered line passed, failed, or passed with a condition.
/// accepted + rejected + conditional must equal inspected, exactly, in Decimal
/// (PRD #21 §91, §220).
model MaterialInspectionDecision {
  id                 String @id @default(cuid())
  companyId          String
  inspectionId       String
  goodsReceiptItemId String

  inspectedQuantity   Decimal @db.Decimal(18, 4)
  acceptedQuantity    Decimal @db.Decimal(18, 4)
  rejectedQuantity    Decimal @db.Decimal(18, 4)
  conditionalQuantity Decimal @db.Decimal(18, 4)

  unit  String
  notes String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspection       QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  goodsReceiptItem GoodsReceiptItem  @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, goodsReceiptItemId])
  @@index([companyId])
  @@index([inspectionId])
  @@index([goodsReceiptItemId])
  @@map("material_inspection_decisions")
}

/// The act of letting material through to stock. Quality decides; Inventory
/// records the movement (PRD #21 §98, §102).
model QualityMaterialRelease {
  id        String @id @default(cuid())
  companyId String

  inspectionId       String
  goodsReceiptItemId String

  releasedQuantity Decimal @db.Decimal(18, 4)
  rejectedQuantity Decimal @db.Decimal(18, 4)
  heldQuantity     Decimal @db.Decimal(18, 4)

  unit   String
  status MaterialReleaseStatus

  releasedByMemberId String
  releasedAt         DateTime

  revokedAt         DateTime?
  revokedByMemberId String?
  revocationReason  String?

  notes String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspection       QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  goodsReceiptItem GoodsReceiptItem  @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  releasedBy       CompanyMember     @relation("QualityReleaser", fields: [releasedByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One cumulative release per inspection line, versioned by revocation
  /// rather than by a second row (PRD #21 §219).
  @@unique([inspectionId, goodsReceiptItemId])
  @@index([companyId])
  @@index([inspectionId])
  @@index([goodsReceiptItemId])
  @@index([status])
  @@index([releasedAt])
  @@map("quality_material_releases")
}

/// A fault on a job that somebody must fix. Always on a project — a defect with
/// no site is nobody's to close (PRD #21 §111, §222).
model QualityDefect {
  id        String @id @default(cuid())
  companyId String

  defectNumber String
  title        String
  description  String

  projectId    String
  inspectionId String?

  severity QualitySeverity
  status   QualityDefectStatus @default(OPEN)

  locationText String?

  assignedToMemberId String?
  dueDate            DateTime?

  resolvedAt         DateTime?
  resolvedByMemberId String?
  resolutionNote     String?

  closedAt         DateTime?
  closedByMemberId String?

  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  inspection QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  assignedTo CompanyMember? @relation("QualityDefectAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)

  ncrs              NonConformanceReport[]
  correctiveActions CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, defectNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([inspectionId])
  @@index([severity])
  @@index([assignedToMemberId])
  @@index([dueDate])
  @@map("quality_defects")
}

/// A formal statement that something did not meet requirement. It cannot close
/// without a root cause and a verified corrective action — that is the whole
/// difference between an NCR and a defect (PRD #21 §122, §136).
model NonConformanceReport {
  id        String @id @default(cuid())
  companyId String

  ncrNumber   String
  title       String
  description String

  projectId          String?
  inspectionId       String?
  goodsReceiptId     String?
  goodsReceiptItemId String?
  sourceDefectId     String?

  category NCRCategory
  severity QualitySeverity
  status   NCRStatus       @default(DRAFT)

  assignedToMemberId String?
  ownerMemberId      String?

  immediateAction         String?
  rootCause               String?
  correctiveActionSummary String?

  dueDate DateTime?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  rejectedAt         DateTime?
  rejectedByMemberId String?

  closedAt         DateTime?
  closedByMemberId String?
  closureNote      String?

  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inspection       QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptItem GoodsReceiptItem?  @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)
  sourceDefect     QualityDefect?     @relation(fields: [sourceDefectId], references: [id], onDelete: SetNull)

  assignedTo CompanyMember? @relation("NcrAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)
  owner      CompanyMember? @relation("NcrOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  correctiveActions CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ncrNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([inspectionId])
  @@index([goodsReceiptId])
  @@index([goodsReceiptItemId])
  @@index([sourceDefectId])
  @@index([category])
  @@index([severity])
  @@index([assignedToMemberId])
  @@index([ownerMemberId])
  @@index([dueDate])
  @@map("non_conformance_reports")
}

/// What somebody actually does about a non-conformance. Verified by somebody
/// other than whoever completed it (PRD #21 §140, §147).
model CorrectiveAction {
  id        String @id @default(cuid())
  companyId String

  actionNumber String
  title        String
  description  String

  ncrId        String?
  defectId     String?
  inspectionId String?

  projectId String?

  assignedToMemberId String
  dueDate            DateTime?

  status CorrectiveActionStatus @default(OPEN)

  completionNote      String?
  completedAt         DateTime?
  completedByMemberId String?

  verificationNote   String?
  verifiedAt         DateTime?
  verifiedByMemberId String?

  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ncr        NonConformanceReport? @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  defect     QualityDefect?        @relation(fields: [defectId], references: [id], onDelete: SetNull)
  inspection QualityInspection?    @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  project    Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignedTo CompanyMember @relation("CorrectiveActionAssignee", fields: [assignedToMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, actionNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([ncrId])
  @@index([defectId])
  @@index([inspectionId])
  @@index([projectId])
  @@index([assignedToMemberId])
  @@index([dueDate])
  @@map("corrective_actions")
}

/// The approval cycle for an inspection or an NCR. At most one PENDING row per
/// record, enforced transactionally (PRD #21 §160, §218).
model QualityApproval {
  id        String @id @default(cuid())
  companyId String

  recordType QualityApprovalRecordType
  recordId   String

  status QualityApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy CompanyMember  @relation("QualityApprovalSubmitter", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  decidedBy   CompanyMember? @relation("QualityApprovalDecider", fields: [decidedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("quality_approvals")
}

// ---------------------------------------------------------------------------
// HSE — Health, Safety & Environment (PRD #22)
// ---------------------------------------------------------------------------

/**
 * Safety is a chain: something is observed, its risk is judged, a control goes
 * in, somebody is made accountable for it, and somebody else verifies it went
 * in (PRD #22 §4).
 * The entities here are deliberately not the ones they resemble (PRD #22 §3):
 * - an *HSE inspection* is a safety look, not a QA/QC inspection,
 * - a *hazard* is a condition that could hurt somebody, not an NCR,
 * - an *incident* is something that happened, not a defect,
 * - an *HSE action* is the safety obligation and its verification; the Task is
 * the work item used to discharge it (PRD #22 §128).
 * Risk is `likelihood x severity` on a 5x5 matrix, and both the score and the
 * level are derived on the server every time. A browser that could post its own
 * riskLevel could file a critical hazard as low and route it away from the
 * people who must see it (PRD #22 §243).
 * Injury is recorded as operational flags only — occurred, first aid, medical
 * treatment, lost time. No diagnosis, no medical history: V0.1 stores what
 * safety management needs to act and nothing a medical record would hold
 * (PRD #22 §22, §87).
 */

enum HseInspectionType {
  SITE_SAFETY
  PPE
  HOUSEKEEPING
  WORK_AT_HEIGHT
  ELECTRICAL
  FIRE_SAFETY
  EXCAVATION
  LIFTING
  ENVIRONMENTAL
  GENERAL
}

enum HseInspectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

enum HseInspectionResult {
  NOT_SET
  PASS
  FAIL
  CONDITIONAL
}

enum HseTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum HseChecklistResponseType {
  PASS_FAIL
  PASS_FAIL_NA
  BOOLEAN
  TEXT
  NUMBER
}

enum HseChecklistResult {
  PASS
  FAIL
  NA
}

enum HseHazardCategory {
  WORK_AT_HEIGHT
  ELECTRICAL
  FIRE
  EXCAVATION
  LIFTING
  MACHINERY
  VEHICLE
  HOUSEKEEPING
  PPE
  CHEMICAL
  ENVIRONMENTAL
  ERGONOMIC
  OTHER
}

enum HseRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseHazardStatus {
  OPEN
  CONTROLLED
  IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  CANCELLED
  REOPENED
}

enum HseIncidentType {
  INCIDENT
  NEAR_MISS
  FIRST_AID
  PROPERTY_DAMAGE
  ENVIRONMENTAL_EVENT
  VEHICLE_EVENT
  FIRE_EVENT
  OTHER
}

enum HseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseIncidentStatus {
  OPEN
  UNDER_INVESTIGATION
  ACTIONS_OPEN
  PENDING_CLOSE
  CLOSED
  CANCELLED
  REOPENED
}

enum HseRiskAssessmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

enum HsePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseActionType {
  CORRECTIVE
  PREVENTIVE
  IMMEDIATE
  FOLLOW_UP
  OTHER
}

enum HseActionStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CANCELLED
  REOPENED
}

enum ToolboxTalkStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ToolboxAttendanceStatus {
  ATTENDED
  ABSENT
  EXCUSED
}

enum HsePermitType {
  HOT_WORK
  WORK_AT_HEIGHT
  CONFINED_SPACE
  EXCAVATION
  ELECTRICAL
  LIFTING
  GENERAL
  OTHER
}

enum HsePermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  EXPIRED
  CLOSED
  CANCELLED
}

enum PpeCheckResult {
  PASS
  FAIL
  CONDITIONAL
}

enum EnvironmentalCategory {
  SPILL
  WASTE
  DUST
  NOISE
  WATER
  SOIL
  EMISSIONS
  BIODIVERSITY
  OTHER
}

enum EnvironmentalStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  CANCELLED
  REOPENED
}

enum StopWorkStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum HseApprovalRecordType {
  INSPECTION
  RISK_ASSESSMENT
  WORK_PERMIT
  INCIDENT_CLOSE
}

enum HseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * A safety checklist the company inspects against (PRD #22 §42, §43).
 * Versioned, never rewritten: once a version has been used, editing it would
 * rewrite what somebody actually checked on a site months ago (PRD #22 §349).
 */
model HseInspectionTemplate {
  id        String @id @default(cuid())
  companyId String

  code           String
  name           String
  inspectionType HseInspectionType
  description    String?

  version Int               @default(1)
  status  HseTemplateStatus @default(ACTIVE)

  createdByMemberId String
  updatedByMemberId String?
  archivedAt        DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items       HseInspectionTemplateItem[]
  inspections HseInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([inspectionType])
  @@index([code])
  @@map("hse_inspection_templates")
}

model HseInspectionTemplateItem {
  id         String @id @default(cuid())
  templateId String

  code        String?
  label       String
  description String?

  responseType HseChecklistResponseType
  required     Boolean                  @default(true)
  sortOrder    Int                      @default(0)

  riskIfFailed       HseSeverity?
  requiresNoteOnFail Boolean      @default(false)

  template HseInspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([sortOrder])
  @@map("hse_inspection_template_items")
}

/**
 * An executed safety inspection (PRD #22 §33).
 * Status and result are separate facts, as in QA/QC: an inspection can sit at
 * PENDING_APPROVAL with a result of FAIL — the inspector has finished and found
 * a problem, and somebody still has to sign it off (PRD #22 §37, §38).
 */
model HseInspection {
  id        String @id @default(cuid())
  companyId String

  inspectionNumber String
  inspectionType   HseInspectionType

  projectId       String?
  templateId      String?
  templateVersion Int?

  assignedInspectorMemberId String
  executedByMemberId        String?

  status HseInspectionStatus @default(DRAFT)
  result HseInspectionResult @default(NOT_SET)

  scheduledDate  DateTime?
  inspectionDate DateTime?

  locationText String?
  summary      String?
  decisionNote String?

  submittedAt DateTime?

  approvedAt         DateTime?
  approvedByMemberId String?

  rejectedAt         DateTime?
  rejectedByMemberId String?

  closedAt         DateTime?
  closedByMemberId String?
  cancelledAt      DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template HseInspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  assignedInspector CompanyMember  @relation("HseInspector", fields: [assignedInspectorMemberId], references: [id], onDelete: Restrict)
  executedBy        CompanyMember? @relation("HseInspectionExecutor", fields: [executedByMemberId], references: [id], onDelete: SetNull)

  checklistItems HseInspectionChecklistItem[]
  hazards        HseHazard[]
  actions        HseAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, inspectionNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, result])
  @@index([projectId])
  @@index([templateId])
  @@index([assignedInspectorMemberId])
  @@index([scheduledDate])
  @@index([inspectionDate])
  @@map("hse_inspections")
}

/**
 * The checklist as it stood when the inspection was raised (PRD #22 §47).
 */
model HseInspectionChecklistItem {
  id             String  @id @default(cuid())
  inspectionId   String
  templateItemId String?

  code        String?
  label       String
  description String?

  responseType HseChecklistResponseType
  required     Boolean                  @default(true)
  sortOrder    Int                      @default(0)

  responseValue String?
  result        HseChecklistResult?
  note          String?

  riskIfFailed       HseSeverity?
  requiresNoteOnFail Boolean      @default(false)

  inspection HseInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@index([sortOrder])
  @@index([result])
  @@map("hse_inspection_checklist_items")
}

/**
 * A condition with the potential to cause harm (PRD #22 §57).
 * `severityScore` rather than `severity`: it is one axis of the 5x5 matrix, an
 * integer 1-5, not the LOW/MEDIUM/HIGH/CRITICAL enum that an incident carries.
 * Naming both "severity" is how a hazard ends up filed at the wrong risk.
 */
model HseHazard {
  id        String @id @default(cuid())
  companyId String

  hazardNumber String
  title        String
  description  String

  projectId    String?
  inspectionId String?

  hazardCategory HseHazardCategory

  likelihood    Int
  severityScore Int
  riskScore     Int
  riskLevel     HseRiskLevel

  residualLikelihood Int?
  residualSeverity   Int?
  residualRiskScore  Int?
  residualRiskLevel  HseRiskLevel?

  status HseHazardStatus @default(OPEN)

  locationText String?
  observedAt   DateTime

  reportedByMemberId String
  assignedToMemberId String?

  immediateControl String?
  controlMeasure   String?

  dueDate DateTime?

  closedAt         DateTime?
  closedByMemberId String?
  closureNote      String?
  cancelledAt      DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inspection HseInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  reportedBy CompanyMember  @relation("HseHazardReporter", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  assignedTo CompanyMember? @relation("HseHazardAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)

  actions   HseAction[]
  stopWorks StopWorkRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, hazardNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, riskLevel])
  @@index([projectId])
  @@index([inspectionId])
  @@index([hazardCategory])
  @@index([assignedToMemberId])
  @@index([dueDate])
  @@index([observedAt])
  @@map("hse_hazards")
}

/**
 * Something that caused harm, or could have (PRD #22 §76).
 * A near miss is the same record with `incidentType = NEAR_MISS`, not a second
 * table: the whole value of near-miss reporting is that it sits in the same
 * register as the incidents it predicts (PRD #22 §82).
 */
model HseIncident {
  id        String @id @default(cuid())
  companyId String

  incidentNumber String
  incidentType   HseIncidentType

  title       String
  description String

  projectId String?

  occurredAt DateTime
  reportedAt DateTime @default(now())

  locationText String?

  severity HseSeverity
  status   HseIncidentStatus @default(OPEN)

  reportedByMemberId   String
  investigatorMemberId String?

  injuryOccurred           Boolean @default(false)
  firstAidRequired         Boolean @default(false)
  medicalTreatmentRequired Boolean @default(false)
  lostTime                 Boolean @default(false)
  propertyDamage           Boolean @default(false)
  environmentalImpact      Boolean @default(false)

  immediateAction String?

  investigationSummary String?
  rootCause            String?
  lessonsLearned       String?

  dueDate DateTime?

  submittedForCloseAt DateTime?
  closedAt            DateTime?
  closedByMemberId    String?
  closureNote         String?
  cancelledAt         DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  reportedBy   CompanyMember  @relation("HseIncidentReporter", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  investigator CompanyMember? @relation("HseIncidentInvestigator", fields: [investigatorMemberId], references: [id], onDelete: SetNull)

  actions   HseAction[]
  stopWorks StopWorkRecord[]
  /// Who was hurt, saw it, or was involved (E-04 §73) — HSE's record, restricted like the incident.
  people    HseIncidentPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, incidentNumber])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, incidentType])
  @@index([companyId, severity])
  @@index([projectId])
  @@index([reportedByMemberId])
  @@index([investigatorMemberId])
  @@index([occurredAt])
  @@index([dueDate])
  @@map("hse_incidents")
}

/**
 * A structured risk evaluation for an activity or location (PRD #22 §100).
 */
model HseRiskAssessment {
  id        String @id @default(cuid())
  companyId String

  assessmentNumber String
  title            String
  description      String?

  projectId String?

  activityType String?
  locationText String?

  version Int                     @default(1)
  status  HseRiskAssessmentStatus @default(DRAFT)

  ownerMemberId String?

  assessmentDate DateTime
  reviewDate     DateTime?

  submittedAt DateTime?

  approvedAt         DateTime?
  approvedByMemberId String?

  createdByMemberId String
  updatedByMemberId String?
  archivedAt        DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  owner CompanyMember? @relation("HseRiskAssessmentOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  items   HseRiskAssessmentItem[]
  actions HseAction[]
  permits HseWorkPermit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, assessmentNumber, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([ownerMemberId])
  @@index([assessmentDate])
  @@index([reviewDate])
  @@map("hse_risk_assessments")
}

model HseRiskAssessmentItem {
  id               String @id @default(cuid())
  riskAssessmentId String

  hazardDescription String
  existingControls  String?

  likelihood    Int
  severityScore Int
  riskScore     Int
  riskLevel     HseRiskLevel

  additionalControls String?

  residualLikelihood Int?
  residualSeverity   Int?
  residualRiskScore  Int?
  residualRiskLevel  HseRiskLevel?

  responsibleMemberId String?
  dueDate             DateTime?

  sortOrder Int @default(0)

  riskAssessment HseRiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskAssessmentId])
  @@index([riskLevel])
  @@index([responsibleMemberId])
  @@index([dueDate])
  @@map("hse_risk_assessment_items")
}

/**
 * A safety obligation and its verification (PRD #22 §114).
 * Not a Task. The Task is the work item somebody does; the action is the record
 * that the obligation existed, was discharged, and was checked by somebody
 * other than whoever discharged it (PRD #22 §128).
 */
model HseAction {
  id        String @id @default(cuid())
  companyId String

  actionNumber String
  actionType   HseActionType
  title        String
  description  String

  projectId String?

  hazardId                   String?
  incidentId                 String?
  inspectionId               String?
  riskAssessmentId           String?
  environmentalObservationId String?
  stopWorkId                 String?
  permitId                   String?

  assignedToMemberId String
  dueDate            DateTime?

  priority HsePriority
  status   HseActionStatus @default(OPEN)

  completionNote      String?
  completedAt         DateTime?
  completedByMemberId String?

  verificationNote   String?
  verifiedAt         DateTime?
  verifiedByMemberId String?

  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  hazard                   HseHazard?                @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  incident                 HseIncident?              @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  inspection               HseInspection?            @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  riskAssessment           HseRiskAssessment?        @relation(fields: [riskAssessmentId], references: [id], onDelete: SetNull)
  environmentalObservation EnvironmentalObservation? @relation(fields: [environmentalObservationId], references: [id], onDelete: SetNull)
  stopWork                 StopWorkRecord?           @relation(fields: [stopWorkId], references: [id], onDelete: SetNull)
  permit                   HseWorkPermit?            @relation(fields: [permitId], references: [id], onDelete: SetNull)

  assignedTo CompanyMember @relation("HseActionAssignee", fields: [assignedToMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, actionNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([hazardId])
  @@index([incidentId])
  @@index([inspectionId])
  @@index([riskAssessmentId])
  @@index([environmentalObservationId])
  @@index([stopWorkId])
  @@index([permitId])
  @@index([assignedToMemberId])
  @@index([priority])
  @@index([dueDate])
  @@map("hse_actions")
}

/**
 * A short safety briefing, with who was there (PRD #22 §129).
 */
model ToolboxTalk {
  id        String @id @default(cuid())
  companyId String

  talkNumber String
  title      String
  topic      String

  projectId String?

  talkDate     DateTime
  locationText String?

  conductedByMemberId String

  status ToolboxTalkStatus @default(DRAFT)
  notes  String?

  completedAt DateTime?
  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  conductedBy CompanyMember @relation("ToolboxConductor", fields: [conductedByMemberId], references: [id], onDelete: Restrict)

  participants ToolboxTalkParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, talkNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([talkDate])
  @@index([conductedByMemberId])
  @@map("toolbox_talks")
}

/**
 * Somebody who attended, or did not (PRD #22 §132).
 * `externalName` exists because subcontractors attend toolbox talks and are not
 * company members; a talk that could only record employees would record half
 * the people who were actually briefed (PRD #22 §133).
 */
model ToolboxTalkParticipant {
  id            String @id @default(cuid())
  toolboxTalkId String

  companyMemberId   String?
  /// A worker without a login is a participant by their employment (E-04 §71).
  employeeProfileId String?
  externalName      String?

  attendanceStatus  ToolboxAttendanceStatus
  signatureRecorded Boolean                 @default(false)

  toolboxTalk     ToolboxTalk      @relation(fields: [toolboxTalkId], references: [id], onDelete: Cascade)
  companyMember   CompanyMember?   @relation("ToolboxParticipant", fields: [companyMemberId], references: [id], onDelete: SetNull)
  employeeProfile EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toolboxTalkId])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([attendanceStatus])
  @@map("toolbox_talk_participants")
}

/**
 * Authorisation for controlled or high-risk work (PRD #22 §140).
 */
model HseWorkPermit {
  id        String @id @default(cuid())
  companyId String

  permitNumber String
  permitType   HsePermitType
  title        String

  projectId    String
  locationText String

  riskAssessmentId String?

  validFrom  DateTime
  validUntil DateTime

  requestedByMemberId String
  responsibleMemberId String?

  status HsePermitStatus @default(DRAFT)

  hazardsSummary    String?
  controlsSummary   String?
  ppeRequirements   String?
  specialConditions String?

  suspensionReason String?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  activatedAt        DateTime?
  suspendedAt        DateTime?
  closedAt           DateTime?
  closedByMemberId   String?
  cancelledAt        DateTime?

