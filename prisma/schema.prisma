  requestedBy CompanyMember  @relation("HsePermitRequester", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  responsible CompanyMember? @relation("HsePermitResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)

  actions HseAction[]
  /// The workers and crews the permit covers (E-04 §74).
  workers HseWorkPermitWorker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, permitNumber])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([permitType])
  @@index([riskAssessmentId])
  @@index([validFrom])
  @@index([validUntil])
  @@index([requestedByMemberId])
  @@index([responsibleMemberId])
  @@map("hse_work_permits")
}

/**
 * Whether the protective equipment was there and was being worn (PRD #22 §158).
 * It never touches Inventory. Issuing a helmet from the store is a stock issue;
 * checking somebody is wearing one is a safety observation (PRD #22 §162).
 */
model PpeCheck {
  id        String @id @default(cuid())
  companyId String

  checkNumber String
  projectId   String?

  checkDate    DateTime
  locationText String?

  checkedByMemberId String

  subjectMemberId          String?
  /// Whose PPE was checked, when they have no login (E-04 §72).
  subjectEmployeeProfileId String?
  externalSubjectName      String?

  helmetOk                Boolean?
  eyeProtectionOk         Boolean?
  glovesOk                Boolean?
  footwearOk              Boolean?
  harnessOk               Boolean?
  hearingProtectionOk     Boolean?
  respiratoryProtectionOk Boolean?
  otherPpeNote            String?

  result PpeCheckResult
  notes  String?

  createdByMemberId String
  updatedByMemberId String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  checkedBy       CompanyMember    @relation("PpeChecker", fields: [checkedByMemberId], references: [id], onDelete: Restrict)
  subject         CompanyMember?   @relation("PpeSubject", fields: [subjectMemberId], references: [id], onDelete: SetNull)
  subjectEmployee EmployeeProfile? @relation("PpeSubjectEmployee", fields: [subjectEmployeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, checkNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([checkDate])
  @@index([checkedByMemberId])
  @@index([subjectMemberId])
  @@index([subjectEmployeeProfileId])
  @@index([result])
  @@map("ppe_checks")
}

/// Somebody hurt by, witnessing or involved in an incident (E-04 §73): an
/// employee of the company — with or without a login — or a named outsider.
/// Read with the incident and nowhere else (§84).
model HseIncidentPerson {
  id                String                 @id @default(cuid())
  companyId         String
  incidentId        String
  employeeProfileId String?
  externalName      String?
  involvement       HseIncidentInvolvement
  notes             String?

  createdByMemberId String

  incident        HseIncident      @relation(fields: [incidentId, companyId], references: [id, companyId], onDelete: Cascade)
  employeeProfile EmployeeProfile? @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([incidentId, employeeProfileId])
  @@index([companyId, employeeProfileId])
  @@map("hse_incident_people")
}

/// A worker or a whole crew a work permit covers (E-04 §74).
model HseWorkPermitWorker {
  id                String  @id @default(cuid())
  companyId         String
  permitId          String
  employeeProfileId String?
  crewId            String?

  createdByMemberId String

  permit          HseWorkPermit    @relation(fields: [permitId, companyId], references: [id, companyId], onDelete: Cascade)
  employeeProfile EmployeeProfile? @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)
  crew            WorkforceCrew?   @relation(fields: [crewId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([permitId, employeeProfileId])
  @@unique([permitId, crewId])
  @@index([companyId, employeeProfileId])
  @@index([companyId, crewId])
  @@map("hse_work_permit_workers")
}

/// A site induction given to a worker before they start on a project (E-04 §71,
/// §270). A record of training, kept when it lapses; a wrong entry is voided
/// with a reason, never deleted.
model HseInduction {
  id                  String    @id @default(cuid())
  companyId           String
  employeeProfileId   String
  projectId           String
  siteId              String?
  inductedOn          DateTime  @db.Date
  validUntil          DateTime? @db.Date
  conductedByMemberId String
  notes               String?

  voidedAt         DateTime?
  voidedByMemberId String?
  voidReason       String?

  createdByMemberId String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId, companyId], references: [id, companyId], onDelete: Restrict)
  project         Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site            ProjectSite?    @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  conductedBy     CompanyMember   @relation("HseInductionConductor", fields: [conductedByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, employeeProfileId, inductedOn])
  @@index([companyId, projectId, inductedOn])
  @@index([conductedByMemberId])
  @@map("hse_inductions")
}

/**
 * An environmental issue or event (PRD #22 §163).
 */
model EnvironmentalObservation {
  id        String @id @default(cuid())
  companyId String

  observationNumber String
  projectId         String?

  category    EnvironmentalCategory
  title       String
  description String

  observedAt   DateTime
  locationText String?

  severity HseSeverity
  status   EnvironmentalStatus @default(OPEN)

  reportedByMemberId String
  assignedToMemberId String?

  immediateAction String?
  dueDate         DateTime?

  closedAt         DateTime?
  closedByMemberId String?
  closureNote      String?
  cancelledAt      DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  reportedBy CompanyMember  @relation("EnvObservationReporter", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  assignedTo CompanyMember? @relation("EnvObservationAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)

  actions HseAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, observationNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([category])
  @@index([severity])
  @@index([reportedByMemberId])
  @@index([assignedToMemberId])
  @@index([dueDate])
  @@index([observedAt])
  @@map("environmental_observations")
}

/**
 * A formal stop to work because it was not safe to continue (PRD #22 §170).
 * V0.1 does not freeze the project's other data — it is an operational state
 * and an alert that has to be impossible to miss, not a lock (PRD #22 §176).
 */
model StopWorkRecord {
  id        String @id @default(cuid())
  companyId String

  stopWorkNumber String
  projectId      String

  title        String
  reason       String
  locationText String?

  hazardId   String?
  incidentId String?

  issuedAt         DateTime
  issuedByMemberId String

  status StopWorkStatus @default(ACTIVE)

  releasedAt         DateTime?
  releasedByMemberId String?
  releaseReason      String?
  cancelledAt        DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  hazard   HseHazard?   @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  incident HseIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  issuedBy   CompanyMember  @relation("StopWorkIssuer", fields: [issuedByMemberId], references: [id], onDelete: Restrict)
  releasedBy CompanyMember? @relation("StopWorkReleaser", fields: [releasedByMemberId], references: [id], onDelete: SetNull)

  actions HseAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, stopWorkNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([hazardId])
  @@index([incidentId])
  @@index([issuedAt])
  @@map("stop_work_records")
}

/**
 * One sign-off, kept after it is decided (PRD #22 §177, §183).
 * The row survives the decision so the queue can be re-read as a history of who
 * approved what and when, rather than only showing what is still outstanding.
 */
model HseApproval {
  id        String @id @default(cuid())
  companyId String

  recordType HseApprovalRecordType
  recordId   String

  status HseApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  submittedBy CompanyMember  @relation("HseApprovalSubmitter", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  decidedBy   CompanyMember? @relation("HseApprovalDecider", fields: [decidedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("hse_approvals")
}

// ---------------------------------------------------------------------------
// Collaboration (PRD #38 M2)
// ---------------------------------------------------------------------------
//
// Discussion lives on the business record it is about. There is no chat module
// and no thread without a parent: a CollaborationThread is the one discussion
// of one record, created the first time somebody comments or watches.
//
// Nothing here grants access. A comment, a mention and a subscription are all
// read back through the parent record's own authorisation, every time
// (PRD #38 §30-§32).

model CollaborationThread {
  id         String @id @default(cuid())
  companyId  String
  /// A record registry type (`lib/core/records`): task, invoice, hazard, …
  parentType String
  parentId   String

  commentCount  Int       @default(0)
  lastCommentAt DateTime?

  comments      Comment[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, parentType, parentId])
  @@index([companyId, lastCommentAt])
  @@map("collaboration_threads")
}

/// Plain text only. Never HTML, never copied into audit (PRD #38 §34, §36).
model Comment {
  id                 String    @id @default(cuid())
  companyId          String
  threadId           String
  authorMemberId     String
  body               String
  /// The comment this one replies to, when it is a reply.
  replyToId          String?
  editedAt           DateTime?
  /// Deletion is archival: the row stays, the body is withheld (PRD #38 §34).
  archivedAt         DateTime?
  archivedByMemberId String?

  thread   CollaborationThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  author   CompanyMember       @relation("CommentAuthor", fields: [authorMemberId], references: [id], onDelete: Restrict)
  mentions Mention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, threadId, createdAt])
  @@index([companyId, authorMemberId, createdAt])
  @@map("comments")
}

model Mention {
  id                String @id @default(cuid())
  companyId         String
  commentId         String
  mentionedMemberId String

  comment Comment       @relation(fields: [commentId], references: [id], onDelete: Restrict)
  member  CompanyMember @relation("MentionedMember", fields: [mentionedMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([commentId, mentionedMemberId])
  @@index([companyId, mentionedMemberId, createdAt])
  @@map("mentions")
}

/// A watcher. Not ownership, not access (PRD #38 §27, §32).
model Subscription {
  id        String             @id @default(cuid())
  companyId String
  threadId  String
  memberId  String
  source    SubscriptionSource
  active    Boolean            @default(true)

  thread CollaborationThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  member CompanyMember       @relation("SubscriptionMember", fields: [memberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, memberId])
  @@index([companyId, memberId, active])
  @@map("collaboration_subscriptions")
}

// ---------------------------------------------------------------------------
// Workers (PRD #38 M5)
// ---------------------------------------------------------------------------

/// The last thing each background job did, written by the job itself
/// (PRD #38 §97). Health and metrics read it; nothing else does.
model WorkerHeartbeat {
  /// A job key: notifications.dispatch, documents.scan, attention.reconcile, …
  job                 String    @id
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  lastDurationMs      Int?
  /// The job's own count of what it handled on its last run.
  lastProcessed       Int       @default(0)
  runs                Int       @default(0)
  failures            Int       @default(0)
  /// Which process ran it last — host and pid, never a secret.
  instance            String?
  /// The lease: one worker runs a scheduled job at a time, and a crashed
  /// worker's claim expires on its own (PRD #38 §96).
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  /// Not due again before this.
  nextRunAt           DateTime?
  /// Runs claimed, and how each ended (PRD #51 §119). `runs` counts runs that
  /// finished either way; `retries` counts runs started after a failure.
  started             Int       @default(0)
  successes           Int       @default(0)
  retries             Int       @default(0)
  timeouts            Int       @default(0)
  /// Failures since the last success. At the job's `maxAttempts` the job is
  /// FAILED: health says so, and it stops retrying early (PRD #51 §34, §35).
  consecutiveFailures Int       @default(0)
  lastErrorCode       String?
  /// When the run holding the lease began, and the correlation id it carries.
  runStartedAt        DateTime?
  lastCorrelationId   String?

  updatedAt DateTime @updatedAt

  @@map("worker_heartbeats")
}

enum WorkerProcessStatus {
  RUNNING
  STOPPING
  STOPPED
}

/// One worker process, alive or recently gone (PRD #51 §25, §116-§118).
///
/// A job's heartbeat row says when the job last ran; this says whether
/// anything is running at all. A process writes it on start, on a fixed beat
/// whether or not a job is due, and on the way out — so an idle worker is
/// visibly alive and a deployment with no worker for a group is visibly not.
model WorkerProcess {
  /// host:pid:random — unique per process start.
  workerId        String              @id
  hostname        String
  pid             Int
  /// The deployed build, so a rolling deploy's overlap can be seen (§60, §197).
  version         String
  groups          String[]
  status          WorkerProcessStatus @default(RUNNING)
  currentJob      String?
  startedAt       DateTime            @default(now())
  lastHeartbeatAt DateTime            @default(now())
  stoppedAt       DateTime?

  @@index([lastHeartbeatAt])
  @@map("worker_processes")
}

/// Every failed attempt of a job or of an outbox event (PRD #51 §36, §39).
///
/// Technical history, never a payload: a code, a message already stripped of
/// query arguments, and the ids needed to find the work item again (§37).
/// A manual retry marks the rows it retried and deletes none of them.
model JobFailure {
  id            String    @id @default(cuid())
  jobKey        String
  companyId     String?
  /// What failed: `job` for a scheduled run, `notification_event` for an outbox row.
  sourceType    String
  sourceId      String?
  attempt       Int
  errorCode     String
  errorMessage  String
  retryable     Boolean
  correlationId String?
  workerId      String?
  failedAt      DateTime  @default(now())
  retriedAt     DateTime?
  retriedBy     String?

  @@index([jobKey, failedAt])
  @@index([sourceType, sourceId])
  @@index([failedAt])
  @@map("job_failures")
}

/// "This job has already done this, for this company" (PRD #51 §16, §19).
///
/// The key is the job's logical work item — a reminder's record and date, a
/// member's week — written in the same transaction as the effect it guards.
/// Two runs, two workers or two versions of a worker racing each other insert
/// one row between them, and only the one that inserted goes on to act.
model JobIdempotencyKey {
  companyId String
  jobKey    String
  key       String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, jobKey, key])
  @@index([createdAt])
  @@map("job_idempotency_keys")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Calendar (PRD #39)
 */
/**
 * --------------------------------------------------------------------------
 */

/// What a Calendar-owned event is (PRD #39 §9, §37). Never a stand-in for a
/// module record: task dates, contract expiries and inspections stay with their
/// modules and reach the calendar through providers.
enum CalendarEventType {
  COMPANY_EVENT
  COMPANY_HOLIDAY
  OFFICE_CLOSURE
  TRAINING
  INTERNAL_DEADLINE
  PERSONAL_EVENT
  TEAM_EVENT
}

/// Who may see a Calendar-owned event (PRD #39 §38, §49-§53).
enum CalendarVisibility {
  PRIVATE
  SELECTED_MEMBERS
  PROJECT
  DEPARTMENT
  COMPANY
}

enum CalendarParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CalendarReminderChannel {
  IN_APP
  EMAIL
}

/// A Calendar-owned event (PRD #39 §36). Times are UTC; an all-day event is
/// stored as the UTC instants of local midnight in `timezone`, so it never
/// slides a day between zones (PRD #39 §72, §73, §185).
model CalendarEvent {
  id                String @id @default(cuid())
  companyId         String
  createdByMemberId String

  title       String
  description String?
  location    String?
  eventType   CalendarEventType

  startsAt DateTime
  endsAt   DateTime?
  allDay   Boolean   @default(false)
  /// The company zone the event was planned in. Recurrence repeats in local
  /// wall-clock time here, which is what keeps a 09:00 series at 09:00 across
  /// a daylight-saving change (PRD #39 §74).
  timezone String

  projectId    String?
  departmentId String?
  visibility   CalendarVisibility

  /// RRULE subset: FREQ=DAILY|WEEKLY|MONTHLY|YEARLY, INTERVAL, BYDAY, COUNT, UNTIL (PRD #39 §76, §77).
  recurrenceRule   String?
  /// The last instant the series can produce, precomputed so range queries stay indexed.
  recurrenceEndsAt DateTime?

  updatedByMemberId  String?
  archivedAt         DateTime?
  archivedByMemberId String?

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy  CompanyMember @relation("CalendarEventCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  participants CalendarEventParticipant[]
  reminders    CalendarReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startsAt])
  @@index([companyId, projectId, startsAt])
  @@index([companyId, departmentId, startsAt])
  @@index([companyId, visibility, startsAt])
  @@index([companyId, createdByMemberId, startsAt])
  @@index([companyId, archivedAt])
  @@index([companyId, recurrenceEndsAt])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  eventId   String
  memberId  String
  companyId String

  status          CalendarParticipantStatus @default(INVITED)
  respondedAt     DateTime?
  addedByMemberId String?

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member  CompanyMember @relation("CalendarParticipant", fields: [memberId], references: [id], onDelete: Restrict)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([eventId, memberId])
  @@index([companyId, memberId])
  @@index([memberId])
  @@map("calendar_event_participants")
}

/// A member's reminder on an event (PRD #39 §41, §42). At most three per member
/// per event, enforced by the service.
model CalendarReminder {
  id            String                  @id @default(cuid())
  companyId     String
  /// Exactly one of eventId and meetingId: meetings reuse the calendar's
  /// reminders rather than keeping their own (PRD #40 §74, §188).
  eventId       String?
  meetingId     String?
  memberId      String
  minutesBefore Int
  channel       CalendarReminderChannel @default(IN_APP)

  event      CalendarEvent?             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  meeting    Meeting?                   @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  member     CompanyMember              @relation("CalendarReminderMember", fields: [memberId], references: [id], onDelete: Restrict)
  company    Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveries CalendarReminderDelivery[]

  createdAt DateTime @default(now())

  @@unique([eventId, memberId, minutesBefore, channel])
  @@unique([meetingId, memberId, minutesBefore, channel])
  @@index([companyId, eventId])
  @@index([companyId, meetingId])
  @@index([memberId])
  @@map("calendar_reminders")
}

/// One reminder fired for one occurrence (PRD #39 §109, §110). The unique key is
/// the idempotency key: a retried or concurrent worker run cannot fire twice.
model CalendarReminderDelivery {
  id                 String   @id @default(cuid())
  companyId          String
  reminderId         String
  occurrenceStartsAt DateTime
  dueAt              DateTime
  sentAt             DateTime @default(now())

  reminder CalendarReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([reminderId, occurrenceStartsAt])
  @@index([companyId, sentAt])
  @@map("calendar_reminder_deliveries")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Meetings (PRD #40)
 */
/**
 * --------------------------------------------------------------------------
 */

/// Descriptive only: a meeting's type never grants anything (PRD #40 §6).
enum MeetingType {
  INTERNAL
  PROJECT
  SITE
  CLIENT
  COORDINATION
  MANAGEMENT
  DESIGN_REVIEW
  TECHNICAL
  PROCUREMENT
  QA_QC
  HSE
  FINANCE
  LEGAL
  HR
  OTHER
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MinutesStatus {
  DRAFT
  FINAL
}

enum MeetingLocationType {
  IN_PERSON
  ONLINE
  HYBRID
  UNSPECIFIED
}

/// There is no PUBLIC (PRD #40 §17).
enum MeetingVisibility {
  PARTICIPANTS
  PROJECT
  DEPARTMENT
  COMPANY
}

enum MeetingParticipantRole {
  ORGANIZER
  CHAIR
  SECRETARY
  ATTENDEE
  OBSERVER
}

enum MeetingResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

/// Actual attendance, distinct from the RSVP (PRD #40 §112, §257).
enum MeetingAttendanceStatus {
  UNKNOWN
  PRESENT
  ABSENT
  EXCUSED
}

enum MeetingAgendaItemStatus {
  PENDING
  DISCUSSED
  SKIPPED
  DEFERRED
}

enum MeetingActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// A recurring meeting's template (PRD #40 §224-§229). Occurrences are real
/// Meeting rows generated a bounded horizon ahead, because each one keeps its
/// own minutes, decisions and actions.
model MeetingSeries {
  id                String @id @default(cuid())
  companyId         String
  createdByMemberId String

  title        String
  description  String?
  meetingType  MeetingType
  projectId    String?
  departmentId String?
  visibility   MeetingVisibility

  locationType MeetingLocationType @default(UNSPECIFIED)
  locationText String?
  onlineUrl    String?

  /// The first occurrence's start, and each occurrence's length.
  firstStartsAt   DateTime
  durationMinutes Int
  timezone        String

  recurrenceRule   String
  recurrenceEndsAt DateTime?
  /// Occurrences exist up to here; the series job moves it forward.
  generatedUntil   DateTime
  cancelledAt      DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetings Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([cancelledAt, generatedUntil])
  @@map("meeting_series")
}

model Meeting {
  id                String  @id @default(cuid())
  companyId         String
  projectId         String?
  departmentId      String?
  createdByMemberId String
  /// Exactly one organizer at a time; transfer is an explicit, audited command (PRD #40 §21, §136).
  organizerMemberId String

  title       String
  description String?
  meetingType MeetingType
  status      MeetingStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime
  timezone String

  locationType MeetingLocationType @default(UNSPECIFIED)
  locationText String?
  onlineUrl    String?

  visibility MeetingVisibility

  seriesId        String?
  occurrenceIndex Int?

  minutesStatus              MinutesStatus @default(DRAFT)
  minutesFinalizedAt         DateTime?
  minutesFinalizedByMemberId String?

  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelReason        String?

  archivedAt DateTime?
  /// Optimistic concurrency for edits (PRD #40 §178).
  version    Int       @default(1)

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organizer  CompanyMember  @relation("MeetingOrganizer", fields: [organizerMemberId], references: [id], onDelete: Restrict)
  series     MeetingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  participants    MeetingParticipant[]
  agendaItems     MeetingAgendaItem[]
  minutesSections MeetingMinutesSection[]
  decisions       MeetingDecision[]
  actionItems     MeetingActionItem[]
  reminders       CalendarReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, occurrenceIndex])
  @@index([companyId, startsAt])
  @@index([companyId, projectId, startsAt])
  @@index([companyId, status, startsAt])
  @@index([companyId, departmentId, startsAt])
  @@index([companyId, organizerMemberId, startsAt])
  @@index([companyId, archivedAt])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String
  memberId  String
  companyId String

  role        MeetingParticipantRole  @default(ATTENDEE)
  response    MeetingResponseStatus   @default(PENDING)
  required    Boolean                 @default(true)
  attendance  MeetingAttendanceStatus @default(UNKNOWN)
  /// The name as it was when the member was added, so a final record stays
  /// readable after people leave (PRD #40 §111).
  displayName String

  invitedAt   DateTime?
  respondedAt DateTime?

  meeting Meeting       @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  member  CompanyMember @relation("MeetingParticipant", fields: [memberId], references: [id], onDelete: Restrict)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([meetingId, memberId])
  @@index([memberId, response])
  @@index([companyId, memberId])
  @@map("meeting_participants")
}

model MeetingAgendaItem {
  id        String @id @default(cuid())
  companyId String
  meetingId String
  sortOrder Int

  title             String
  description       String?
  presenterMemberId String?
  plannedMinutes    Int?
  status            MeetingAgendaItemStatus @default(PENDING)

  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  presenter CompanyMember? @relation("MeetingAgendaPresenter", fields: [presenterMemberId], references: [id], onDelete: SetNull)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, meetingId, sortOrder])
  @@map("meeting_agenda_items")
}

/// The formal record, section by section (PRD #40 §42-§49). Plain text: no HTML is stored or rendered.
model MeetingMinutesSection {
  id        String @id @default(cuid())
  companyId String
  meetingId String
  sortOrder Int
  title     String
  body      String

  createdByMemberId String
  updatedByMemberId String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, meetingId, sortOrder])
  @@map("meeting_minutes_sections")
}

/// What was agreed (PRD #40 §50, §51). Never creates a task by itself.
model MeetingDecision {
  id        String @id @default(cuid())
  companyId String
  meetingId String

  decisionNumber     Int
  title              String
  description        String?
  decidedAt          DateTime
  recordedByMemberId String
  archivedAt         DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, decisionNumber])
  @@index([companyId, meetingId])
  @@map("meeting_decisions")
}

/// What must happen next (PRD #40 §53-§62). May link to one canonical Task.
model MeetingActionItem {
  id        String @id @default(cuid())
  companyId String
  meetingId String

  title       String
  description String?

  ownerMemberId     String?
  /// A business date, midday UTC.
  dueAt             DateTime?
  status            MeetingActionItemStatus @default(OPEN)
  completedAt       DateTime?
  createdByMemberId String

  /// Unique: one action item links to at most one Task (PRD #40 §58).
  linkedTaskId String? @unique

  meeting    Meeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  owner      CompanyMember? @relation("MeetingActionOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  linkedTask Task?          @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, meetingId, status])
  @@index([companyId, ownerMemberId, status])
  @@index([companyId, dueAt, status])
  @@map("meeting_action_items")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Unified Approvals Center (PRD #41)
 */
/**
 * --------------------------------------------------------------------------
 */

/// Where a step of a module-owned approval chain stands (PRD #41 §24).
enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  /// Not needed after all, by the owning module's policy.
  SKIPPED
  /// Never reached: an earlier step ended the cycle, or the request was withdrawn.
  CANCELLED
}

/// One step of a sequential approval chain a source module decided it needs
/// (PRD #41 §20-§26). The cycle itself stays the module's own approval row; a
/// step names who may act at that point — a permission, a role resolved at
/// runtime, or one member — and records who did.
model ApprovalStep {
  id          String @id @default(cuid())
  companyId   String
  /// The approval provider that owns the cycle, e.g. "procurement".
  providerKey String @db.VarChar(40)
  /// The module's own approval row this step belongs to.
  approvalId  String
  stepNumber  Int
  /// What the step is called to people: "Procurement", "Finance", "Executive".
  label       String @db.VarChar(80)

  approverMemberId   String?
  /// Resolved to members holding this role when the step is reached (§25).
  approverRoleKey    String? @db.VarChar(40)
  /// The permission that decides the step, beyond reading the record.
  approverPermission String? @db.VarChar(80)

  status             ApprovalStepStatus @default(PENDING)
  decidedByMemberId  String?
  /// Set when the decision was taken under a delegation from this member (§33).
  onBehalfOfMemberId String?
  decidedAt          DateTime?
  decisionNote       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerKey, approvalId, stepNumber])
  @@index([companyId, approvalId, stepNumber])
  @@index([companyId, approverMemberId, status])
  @@index([companyId, decidedByMemberId, status])
  @@map("approval_steps")
}

/// Temporary approval authority, from one member to another, in one company
/// (PRD #41 §32-§34, §169-§173). It lends only the authority to decide what
/// was assigned to the delegator — never module access the delegate lacks.
model ApprovalDelegation {
  id           String  @id @default(cuid())
  companyId    String
  fromMemberId String
  toMemberId   String
  /// One provider ("procurement"), or null for every approval the delegator may decide.
  providerKey  String? @db.VarChar(40)

  startsAt DateTime
  endsAt   DateTime

  reason String? @db.VarChar(500)
  active Boolean @default(true)

  createdByMemberId String
  revokedAt         DateTime?
  revokedByMemberId String?

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromMember CompanyMember @relation("ApprovalDelegationFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   CompanyMember @relation("ApprovalDelegationTo", fields: [toMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, fromMemberId, startsAt, endsAt])
  @@index([companyId, toMemberId, startsAt, endsAt])
  @@map("approval_delegations")
}

/// The answer to a decision request carrying an idempotency key (PRD #41
/// §123, §124): a retried request replays this instead of deciding twice.
model ApprovalDecisionReceipt {
  id             String @id @default(cuid())
  companyId      String
  memberId       String
  idempotencyKey String @db.VarChar(100)
  providerKey    String @db.VarChar(40)
  approvalId     String
  decision       String @db.VarChar(16)
  outcome        String @db.VarChar(24)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([companyId, memberId, idempotencyKey])
  @@index([createdAt])
  @@map("approval_decision_receipts")
}

/// When a purchase order needs more than a Procurement decision (PRD #41
/// §27, §28, §158). Procurement's own configuration, in one currency: an order
/// in another currency cannot be compared, so it takes the full chain.
model ProcurementApprovalPolicy {
  id        String @id @default(cuid())
  companyId String @unique

  /// Orders whose total is above this also need a Finance decision. Null: never.
  financeStepAbove   Decimal? @db.Decimal(18, 2)
  /// Orders whose total is above this also need an executive decision. Null: never.
  executiveStepAbove Decimal? @db.Decimal(18, 2)
  /// The role that takes the executive decision, resolved when the step is reached.
  executiveRoleKey   String   @default("CEO") @db.VarChar(40)
  /// The currency the limits are written in.
  currency           String   @db.VarChar(3)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("procurement_approval_policies")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Timesheets & Work Logs (PRD #42)
 */
/**
 * --------------------------------------------------------------------------
 */

/// Where a member's week stands (PRD #42 §9).
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  REJECTED
  CANCELLED
}

/// What kind of work the time was spent on (PRD #42 §15).
enum WorkLogType {
  PROJECT_WORK
  INTERNAL
  ADMIN
  TRAINING
  TRAVEL
  SUPPORT
  OTHER
}

enum TimesheetApprovalRecordType {
  TIMESHEET
}

enum TimesheetApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/// One member's week: how their working time was allocated (PRD #42 §4, §13).
/// Not attendance, not payroll, not a cost ledger (§2).
model Timesheet {
  id        String @id @default(cuid())
  companyId String
  memberId  String

  /// First and last day of the week, business dates kept at midday UTC.
  periodStart DateTime
  periodEnd   DateTime

  status TimesheetStatus @default(DRAFT)

  /// Resolved when the week is submitted (§72-§75), never chosen by the browser.
  approverMemberId String?

  submittedAt         DateTime?
  submittedByMemberId String?
  approvedAt          DateTime?
  approvedByMemberId  String?
  returnedAt          DateTime?
  returnedByMemberId  String?
  rejectedAt          DateTime?
  rejectedByMemberId  String?
  reopenedAt          DateTime?
  reopenedByMemberId  String?
  decisionNote        String?

  /// Incremented on every submission, so each approval cycle is distinct (§85).
  submissionVersion Int @default(0)
  /// Optimistic concurrency for submit and decide (§162, §164).
  version           Int @default(1)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  member   CompanyMember @relation("TimesheetMember", fields: [memberId], references: [id], onDelete: Restrict)
  workLogs WorkLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, memberId, periodStart])
  @@index([companyId, memberId, status])
  @@index([companyId, status, periodStart])
  @@index([companyId, approverMemberId, status])
  @@map("timesheets")
}

/// Time spent on one piece of work on one day, in whole minutes (PRD #42 §14, §16).
model WorkLog {
  id           String      @id @default(cuid())
  companyId    String
  timesheetId  String
  memberId     String
  /// A business date, midday UTC, in the company's time zone (§19, §20).
  workDate     DateTime
  projectId    String?
  taskId       String?
  workType     WorkLogType
  minutes      Int
  description  String?
  billable     Boolean     @default(false)
  overtimeFlag Boolean     @default(false)

  createdByMemberId String

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  timesheet Timesheet     @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  member    CompanyMember @relation("WorkLogMember", fields: [memberId], references: [id], onDelete: Restrict)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task      Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, memberId, workDate])
  @@index([companyId, projectId, workDate])
  @@index([companyId, taskId, workDate])
  @@index([timesheetId, workDate])
  @@map("work_logs")
}

/// One submission of a week for approval (PRD #42 §70, §85, §86): the same
/// cycle shape every module's approvals use, so the Approvals Center reads it
/// as it reads the rest.
model TimesheetApproval {
  id        String @id @default(cuid())
  companyId String

  recordType TimesheetApprovalRecordType @default(TIMESHEET)
  recordId   String

  status TimesheetApprovalStatus @default(PENDING)

  submissionVersion Int
  approverMemberId  String

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("timesheet_approvals")
}

/// A company's timesheet rules (PRD #42 §12, §30, §35, §59, §101, §217).
model TimesheetSettings {
  id        String @id @default(cuid())
  companyId String @unique

  /// ISO weekday the week starts on: 1 = Monday.
  weekStartsOn          Int     @default(1)
  standardDailyMinutes  Int     @default(480)
  standardWeeklyMinutes Int     @default(2400)
  /// The step the entry controls snap to.
  incrementMinutes      Int     @default(15)
  /// Whether the server refuses durations off the increment.
  enforceIncrement      Boolean @default(false)
  backdateDays          Int     @default(14)
  /// When last week is due: ISO weekday and local "HH:MM". Both null: no deadline.
  submitDay             Int?
  submitTime            String?
  descriptionsRequired  Boolean @default(false)
  /// Whether members may set billable on their own entries (§39).
  membersSetBillable    Boolean @default(true)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timesheet_settings")
}

/// The one designated approver for a member's weeks (PRD #42 §73, §74). With
/// none, the member's department manager decides.
model TimesheetApproverAssignment {
  id               String @id @default(cuid())
  companyId        String
  memberId         String @unique
  approverMemberId String

  updatedByMemberId String?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  member   CompanyMember @relation("TimesheetApproverSubject", fields: [memberId], references: [id], onDelete: Cascade)
  approver CompanyMember @relation("TimesheetApproverMember", fields: [approverMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, approverMemberId])
  @@map("timesheet_approver_assignments")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Construction Daily Log / Site Diary (PRD #43)
 */
/**
 * --------------------------------------------------------------------------
 */

enum DailyLogStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  LOCKED
  CORRECTION_REQUIRED
  VOID
}

enum DailyLogWeatherCondition {
  CLEAR
  PARTLY_CLOUDY
  CLOUDY
  RAIN
  HEAVY_RAIN
  SNOW
  WINDY
  FOG
  EXTREME_HEAT
  EXTREME_COLD
  OTHER
}

enum DailyLogSiteCondition {
  DRY
  WET
  MUDDY
  FLOODED
  RESTRICTED_ACCESS
  HIGH_WIND
  DUSTY
  OTHER
}

enum DailyLogEquipmentStatus {
  AVAILABLE
  IN_USE
  IDLE
  OUT_OF_SERVICE
  BREAKDOWN
  OTHER
}

enum DailyLogDelayCategory {
  WEATHER
  LABOR
  MATERIAL
  EQUIPMENT
  DESIGN
  ACCESS
  INSPECTION
  CLIENT
  SUBCONTRACTOR
  UTILITY
  SAFETY
  QUALITY
  OTHER
}

enum DailyLogDelayImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DailyLogTaskLinkType {
  RELATED
  CREATED_FROM_LOG
  FOLLOW_UP
  DELAY_ACTION
  INSTRUCTION_ACTION
}

enum DailyLogDocumentCategory {
  PHOTO
  DELIVERY_TICKET
  SKETCH
  REPORT
  INSTRUCTION
  OTHER
}

/// One project's canonical record of one site day (PRD #43 §10, §15).
model DailyLog {
  id        String @id @default(cuid())
  companyId String
  projectId String

  /// The project's calendar day, kept at midday UTC (§16).
  workDate DateTime

  status DailyLogStatus @default(DRAFT)

  createdByMemberId   String
  submittedByMemberId String?
  submittedAt         DateTime?
  /// Resolved on the server when the log is submitted (§87-§89, §233).
  reviewerMemberId    String?
  reviewedByMemberId  String?
  reviewedAt          DateTime?
  lockedByMemberId    String?
  lockedAt            DateTime?
  returnedByMemberId  String?
  returnedAt          DateTime?
  returnReason        String?
  voidedByMemberId    String?
  voidedAt            DateTime?
  voidReason          String?

  summary            String?
  generalNotes       String?
  delaySummary       String?
  instructionSummary String?
  weatherSummary     String?
  siteCondition      DailyLogSiteCondition?
  siteConditionNotes String?

  /// Created after its work date (§19).
  lateEntry       Boolean @default(false)
  submissionCount Int     @default(0)
  version         Int     @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  weatherEntries     DailyLogWeatherEntry[]
  workforce          DailyLogWorkforceEntry[]
  workActivities     DailyLogWorkActivity[]
  equipmentEntries   DailyLogEquipmentEntry[]
  deliveryEntries    DailyLogDeliveryEntry[]
  visitorEntries     DailyLogVisitorEntry[]
  delayEntries       DailyLogDelayEntry[]
  instructionEntries DailyLogInstructionEntry[]
  taskLinks          DailyLogTaskLink[]
  documentLinks      DailyLogDocumentLink[]
  corrections        DailyLogCorrection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, projectId, workDate])
  @@index([companyId, status, workDate])
  @@index([companyId, reviewerMemberId, status])
  @@index([companyId, workDate])
  @@map("daily_logs")
}

model DailyLogWeatherEntry {
  id         String @id @default(cuid())
  companyId  String
  dailyLogId String

  observedAt      DateTime
  temperatureC    Decimal?                  @db.Decimal(5, 2)
  condition       DailyLogWeatherCondition?
  precipitationMm Decimal?                  @db.Decimal(8, 2)
  windKph         Decimal?                  @db.Decimal(8, 2)
  humidityPct     Int?
  notes           String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, dailyLogId])
  @@map("daily_log_weather_entries")
}

model DailyLogWorkforceEntry {
  id         String @id @default(cuid())
  companyId  String
  dailyLogId String

  organizationName String
  supplierId       String?
  /// The contractor crew and the scope it worked on (PRD #46 §142).
  contractorId     String?
  workPackageId    String?
  trade            String?
  crewName         String?
  /// One of the company's own crews, when the entry was taken from the workforce (E-04 §43, §182).
  crewId           String?
  headcount        Int
  notes            String?

  dailyLog DailyLog       @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  crew     WorkforceCrew? @relation(fields: [crewId, companyId], references: [id, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, dailyLogId])
  @@index([companyId, supplierId])
