  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryLocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Every row in the ledger is one of these. REVERSAL undoes an earlier
/// movement without deleting it (PRD #20 §68, §70).
enum StockMovementType {
