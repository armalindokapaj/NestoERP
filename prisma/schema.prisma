enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProcurementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProcurementCategory {
  MATERIALS
  EQUIPMENT
  SUBCONTRACT
  SERVICES
  LOGISTICS
  OFFICE
  OTHER
}

enum RFQStatus {
