// NESTO V0.1 — Core Data Model (PRD #8).
//
// One company, one user identity, one membership, one project, one client,
// one task, one document, one activity system. Every module references these
// shared records rather than duplicating them (PRD #8 §1, §3).
//
// Company isolation is structural: every business record carries companyId and
// every query must constrain it (PRD #8 §6, §7). Prisma foreign keys cannot
// guarantee that related records share a company, so the service layer
// validates that before every write (PRD #8 §64).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
  SUSPENDED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum AccessLevel {
  NONE
  VIEW
  CONTRIBUTE
  APPROVE
  MANAGE
}

enum DataScope {
  SELF
  ASSIGNED
  PROJECT
  DEPARTMENT
  COMPANY
  SYSTEM
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMemberStatus {
  ACTIVE
  INACTIVE
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  PUBLIC_ENTITY
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  ACCOUNT_BLOCKED
  MEMBERSHIP_DENIED
}

// Module test-record enums (PRD #9 §67)
// Deliberately small shapes that exercise the Module Shell: lists, details,
// statuses, scope and approval. They are not the final ERP domain models.

/// Invoice workflow state (PRD #15 §41).
///
/// Deliberately free of any notion of payment: whether an invoice has been
/// settled is derived from its recorded payments, never stored here, so
/// issuance workflow and cash settlement cannot drift apart (PRD #15 §42, §45).
enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  CANCELLED
  ARCHIVED
}

enum PaymentDirection {
  RECEIPT
  DISBURSEMENT
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHECK
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
}

/// One cost vocabulary for expenses, budget lines and commitments, so budget
/// vs actual compares like with like (PRD #15 §89).
enum FinanceCostCategory {
  LABOR
  MATERIALS
  EQUIPMENT
  SUBCONTRACTOR
  SERVICES
  TRAVEL
  ADMINISTRATION
  OTHER
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum CommitmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
  ARCHIVED
}

enum FinanceApprovalRecordType {
  INVOICE
  EXPENSE
  BUDGET
  COMMITMENT
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Employment, which is a different fact from company membership (PRD #16 §29).
///
/// A person can hold an active membership and have no employment record at all
/// (a contractor with a login), or have ended employment while their membership
/// is deactivated separately. HR never changes access on its own.
enum EmploymentStatus {
  PLANNED
  ACTIVE
  ON_LEAVE
  SUSPENDED
  ENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
  TEMPORARY
  OTHER
}

enum HrProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_REQUIRED
}

enum CompensationPayType {
  SALARY
  HOURLY
  DAILY
  OTHER
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  PARENTAL
  OTHER
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  REMOTE
  HOLIDAY
  OFF
}

enum AttendanceSource {
  MANUAL
  SELF
  IMPORT
  SYSTEM
}

/// Sales (PRD #17 §173, §174).
///
/// The stage ladder is fixed in V0.1: a configurable pipeline is a later
/// product, and a company that can rename its own stages cannot have its
/// forecast compared with anybody else's (PRD #17 §391).
enum OpportunityStage {
  PROSPECTING
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  OUTBOUND
  EVENT
  PARTNER
  SOCIAL
  DIRECT
  OTHER
}

enum LostReason {
  PRICE
  COMPETITOR
  TIMING
  NO_BUDGET
  NO_RESPONSE
  SCOPE_MISMATCH
  INTERNAL_DECISION
  OTHER
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
  ARCHIVED
}

enum SalesApprovalRecordType {
  PROPOSAL
}

enum SalesApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRING
  EXPIRED
  ARCHIVED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  DELIVERED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum QualityRecordType {
  INSPECTION
  NCR
  PUNCH_ITEM
  TEST
}

enum HseRecordType {
  INCIDENT
  INSPECTION
  PERMIT
  CORRECTIVE_ACTION
}

enum RecordSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkRecordStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

/// One global NESTO identity. Role, company and department live on the
/// membership, never here (PRD #8 §13).
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  memberships         CompanyMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]

  createdActivities Activity[] @relation("ActivityActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Company {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  legalName String?
  logoUrl   String?
  industry  String?
  country   String?
  address   String?
  email     String?
  phone     String?
  website   String?
  status    CompanyStatus @default(ACTIVE)

  memberships CompanyMember[]
  invites     CompanyInvite[]
  departments Department[]
  modules     CompanyModule[]

  projects   Project[]
  clients    Client[]
  contacts   Contact[]
  tasks      Task[]
  documents  Document[]
  activities Activity[]

  financeSettings   FinanceSettings?
  invoices          Invoice[]
  expenses          Expense[]
  payments          Payment[]
  projectBudgets    ProjectBudget[]
  commitments       Commitment[]
  financeApprovals  FinanceApproval[]
  employeeProfiles  EmployeeProfile[]
  compensations     Compensation[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendanceRecords AttendanceRecord[]
  leads             Lead[]
  opportunities     Opportunity[]
  proposals         Proposal[]
  salesApprovals    SalesApproval[]
  contracts         Contract[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  inventoryItems    InventoryItem[]
  stockMovements    InventoryMovement[]
  qualityRecords    QualityRecord[]
  hseRecords        HseRecord[]
  supportRequests   SupportRequest[]

  sessions   Session[]
  authEvents AuthEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@map("companies")
}

model Department {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  key              String?
  description      String?
  managerMemberId  String?
  status           DepartmentStatus  @default(ACTIVE)
  /// Restore returns the department to the status it held (PRD #14 §125).
  preArchiveStatus DepartmentStatus?

  createdBy  String?
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CompanyMember[] @relation("DepartmentMembers")

  managerMember CompanyMember? @relation("DepartmentManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@index([companyId])
  @@index([companyId, status])
  @@index([managerMemberId])
  @@index([status])
  @@map("departments")
}

/// One of the 16 predefined V0.1 roles. Stored as a row rather than an enum so
/// company-specific roles can be added later without a migration (PRD #5 §45).
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  members      CompanyMember[]
  permissions  RolePermission[]
  moduleAccess RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  scope        DataScope?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  route       String       @unique
  status      ModuleStatus @default(ACTIVE)

  companyModules CompanyModule[]
  roleAccess     RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

/// The simplified role × module matrix. Combined with RolePermission and
/// CompanyModule it produces the final module context (PRD #6 §129A).
model RoleModuleAccess {
  id          String      @id @default(cuid())
  roleId      String
  moduleId    String
  accessLevel AccessLevel
  scope       DataScope

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
  @@map("role_module_access")
}

/// A module switched off here is unavailable regardless of role (PRD #7 §59).
model CompanyModule {
  id        String  @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

/// The centre of NESTO: user + company + role + department. This is what makes
/// the same person an Architect in one company and a PM in another (PRD #8 §14).
model CompanyMember {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  roleId       String
  departmentId String?
  jobTitle     String?
  status       MembershipStatus @default(ACTIVE)

  /// Membership lifecycle. Who invited them, when they accepted, and who
  /// removed their access — the questions asked after the fact (PRD #14 §12).
  invitedAt             DateTime?
  invitedByMemberId     String?
  joinedAt              DateTime?
  deactivatedAt         DateTime?
  deactivatedByMemberId String?

  archivedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  managedDepartments Department[]    @relation("DepartmentManager")
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]

  uploadedDocuments Document[] @relation("DocumentUploadedBy")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreatorMember")

  activityActions Activity[] @relation("ActivityActorMember")

  employeeProfile         EmployeeProfile?    @relation("EmployeeProfileMember")
  managedEmployeeProfiles EmployeeProfile[]   @relation("EmployeeProfileManager")
  ownedLeads              Lead[]              @relation("LeadOwner")
  ownedOpportunities      Opportunity[]       @relation("OpportunityOwner")
  requestedOrders         PurchaseRequest[]   @relation("PurchaseRequester")
  stockMovements          InventoryMovement[] @relation("MovementActor")
  qualityRecords          QualityRecord[]     @relation("QualityAssignee")
  hseRecords              HseRecord[]         @relation("HseAssignee")
  supportRequests         SupportRequest[]    @relation("SupportRequester")

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// Core business objects
// ---------------------------------------------------------------------------

model Project {
  id                     String           @id @default(cuid())
  companyId              String
  code                   String
  name                   String
  description            String?
  clientId               String?
  projectManagerMemberId String?
  status                 ProjectStatus    @default(DRAFT)
  /// Status the project held before archiving, so Restore returns it there
  /// rather than always to ACTIVE (PRD #10 §68).
  preArchiveStatus       ProjectStatus?
  priority               ProjectPriority?
  startDate              DateTime?
  endDate                DateTime?
  address                String?
  city                   String?
  country                String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectManager CompanyMember? @relation("ProjectManager", fields: [projectManagerMemberId], references: [id], onDelete: SetNull)

  members   ProjectMember[]
  tasks     Task[]
  documents Document[]

  invoices         Invoice[]
  expenses         Expense[]
  budgets          ProjectBudget[]
  commitments      Commitment[]
  contracts        Contract[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  stockMovements   InventoryMovement[]
  qualityRecords   QualityRecord[]
  hseRecords       HseRecord[]

  sourceOpportunities Opportunity[] @relation("OpportunityConvertedProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([clientId])
  @@index([projectManagerMemberId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@map("projects")
}

/// How PROJECT and ASSIGNED scope are resolved: user → member → project
/// membership → project (PRD #8 §28).
model ProjectMember {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  companyMemberId String
  projectRole     String?
  isPrimary       Boolean             @default(false)
  status          ProjectMemberStatus @default(ACTIVE)
  joinedAt        DateTime?
  leftAt          DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, companyMemberId])
  @@index([companyId])
  @@index([projectId])
  @@index([companyMemberId])
  @@index([companyId, companyMemberId])
  @@index([status])
  @@map("project_members")
}

model Client {
  id               String        @id @default(cuid())
  companyId        String
  code             String?
  name             String
  legalName        String?
  type             ClientType    @default(COMPANY)
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?
  status           ClientStatus  @default(ACTIVE)
  /// The status to return to on restore, so an archived client comes back
  /// INACTIVE if that is what it was (PRD #12 §70, §75).
  preArchiveStatus ClientStatus?

  /// Lower-cased, punctuation-stripped `name`, maintained by the service and
  /// never edited directly. It exists so duplicate detection is an indexed
  /// lookup rather than a scan (PRD #12 §55, §162).
  normalizedName String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contacts       Contact[]
  projects       Project[]
  documents      Document[]
  invoices       Invoice[]
  opportunities  Opportunity[]
  proposals      Proposal[]
  convertedLeads Lead[]        @relation("LeadConvertedClient")
  contracts      Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, normalizedName])
  @@index([name])
  @@index([email])
  @@index([country])
  @@index([updatedAt])
  @@map("clients")
}

model Contact {
  id               String         @id @default(cuid())
  companyId        String
  clientId         String
  firstName        String
  lastName         String
  jobTitle         String?
  email            String?
  phone            String?
  isPrimary        Boolean        @default(false)
  status           ContactStatus  @default(ACTIVE)
  /// As on Client: restore returns the contact to the status it held
  /// (PRD #12 §77, §88).
  preArchiveStatus ContactStatus?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([companyId, clientId, status])
  @@index([lastName, firstName])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model Task {
  id                String       @id @default(cuid())
  companyId         String
  projectId         String?
  title             String
  description       String?
  assigneeMemberId  String?
  createdByMemberId String
  status            TaskStatus   @default(TODO)
  /// The status to return to on restore, so an archived task remembers where it
  /// was rather than always coming back as TODO (PRD #11 §73).
  preArchiveStatus  TaskStatus?
  priority          TaskPriority @default(MEDIUM)
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?

  /// Generic parent context, so a later module can hang work off its own record
  /// without inventing a second task table (PRD #11 §171, §252).
  module     String?
  entityType String?
  entityId   String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignee CompanyMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  creator  CompanyMember  @relation("TaskCreatorMember", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, dueDate])
  @@index([companyId, assigneeMemberId, status])
  @@index([companyId, projectId, status])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([module])
  @@index([entityType, entityId])
  @@map("tasks")
}

/// File metadata plus the business context that governs who may see it.
/// A document is reachable only through its parent's permissions (PRD #8 §43).
model Document {
  id               String          @id @default(cuid())
  companyId        String
  name             String
  description      String?
  /// The name the file was uploaded under, kept for display. The storage key
  /// is sanitised separately and never derived from it (PRD #13 §23, §154).
  originalFileName String?
  fileName         String?
  extension        String?
  storageProvider  String?
  storageKey       String?
  mimeType         String?
  sizeBytes        BigInt?
  /// SHA-256 of the stored object. Integrity and duplicate diagnostics only —
  /// never authorisation (PRD #13 §32).
  checksum         String?
  projectId        String?
  clientId         String?
  module           String?
  entityType       String?
  entityId         String?
  status           DocumentStatus  @default(ACTIVE)
  /// Archived documents return to ACTIVE, but the field keeps the shape every
  /// other module uses (PRD #13 §114).
  preArchiveStatus DocumentStatus?

  /// Who uploaded it. Records authorship, not ownership: access is decided by
  /// company, parent and permissions (PRD #13 §281).
  uploadedByMemberId String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  uploadedBy CompanyMember? @relation("DocumentUploadedBy", fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, projectId, status])
  @@index([companyId, clientId, status])
  @@index([companyId, module, status])
  @@index([projectId])
  @@index([clientId])
  @@index([uploadedByMemberId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([mimeType])
  @@index([extension])
  @@index([updatedAt])
  @@map("documents")
}

/// Business/user-visible activity. Authentication events go to AuthEvent —
/// the two are never combined (PRD #8 §48).
model Activity {
  id            String  @id @default(cuid())
  companyId     String
  module        String
  entityType    String
  entityId      String
  action        String
  message       String?
  actorMemberId String?
  actorUserId   String?
  metadata      Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorMember CompanyMember? @relation("ActivityActorMember", fields: [actorMemberId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation("ActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
  @@map("activities")
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

/// An invitation to join a company (PRD #14 §64, §135).
///
/// Its lifecycle is tracked separately from `CompanyMember.status`, because
/// "this invitation was cancelled" and "this person's access was removed" are
/// different facts about different things.
///
/// Only the hash of the token is stored. The raw token exists solely inside the
/// emailed link, so a database leak cannot be replayed into a membership
/// (PRD #14 §67, §237).
model CompanyInvite {
  id                String              @id @default(cuid())
  companyId         String
  email             String
  userId            String?
  companyMemberId   String?
  roleId            String
  departmentId      String?
  jobTitle          String?
  tokenHash         String              @unique
  status            CompanyInviteStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  cancelledAt       DateTime?
  createdByMemberId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([email])
  @@index([expiresAt])
  @@index([companyMemberId])
  @@map("company_invites")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A server-side session record. The signed cookie carries only this row's id,
/// so revoking access is a delete rather than a wait for a token to expire
/// (PRD #6 §51, §113).
model Session {
  id               String   @id @default(cuid())
  sessionToken     String   @unique
  userId           String
  membershipId     String
  currentCompanyId String
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership CompanyMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company       @relation(fields: [currentCompanyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([membershipId])
  @@index([currentCompanyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the hash is stored; the raw token exists solely in the emailed link
/// (PRD #6 §57).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  companyId String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

// ---------------------------------------------------------------------------
// Module test records (PRD #9 §67)
// ---------------------------------------------------------------------------
// Minimal shapes that make the Module Shell testable: list, detail, status,
// scope, approval. Each department module replaces its table when its own PRD
// lands; none of these is a final domain model.

/// Per-company finance configuration (PRD #15 §28).
model FinanceSettings {
  id                      String   @id @default(cuid())
  companyId               String   @unique
  baseCurrency            String   @default("EUR") @db.VarChar(3)
  defaultPaymentTermsDays Int      @default(30)
  fiscalYearStartMonth    Int      @default(1)
  invoicePrefix           String?
  defaultTaxRate          Decimal? @db.Decimal(7, 4)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

/// A customer receivable (PRD #15 §38).
///
/// Totals are columns rather than derived at read time because a historical
/// invoice must keep the numbers it was issued with, whatever later happens to
/// its lines. They are recalculated by the server on every write and never
/// accepted from the browser (PRD #15 §52, §220).
model Invoice {
  id            String  @id @default(cuid())
  companyId     String
  invoiceNumber String
  clientId      String
  projectId     String?

  issueDate DateTime
  dueDate   DateTime
  currency  String   @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           InvoiceStatus  @default(DRAFT)
  preArchiveStatus InvoiceStatus?

  notes  String?
  sentAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([clientId])
  @@index([projectId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A cost incurred by the company, with or without a project (PRD #15 §87).
model Expense {
  id            String  @id @default(cuid())
  companyId     String
  expenseNumber String?
  projectId     String?

  expenseDate DateTime
  category    FinanceCostCategory
  description String
  payeeName   String?

  currency    String  @db.VarChar(3)
  netAmount   Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           ExpenseStatus  @default(DRAFT)
  preArchiveStatus ExpenseStatus?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, expenseNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
  @@index([projectId])
  @@index([category])
  @@index([currency])
  @@index([updatedAt])
  @@map("expenses")
}

/// Actual cash movement against exactly one invoice or one expense
/// (PRD #15 §70, §74). Voided rather than deleted, so the trail survives.
model Payment {
  id        String @id @default(cuid())
  companyId String

  direction PaymentDirection
  invoiceId String?
  expenseId String?

  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @db.VarChar(3)
  paymentDate DateTime
  method      PaymentMethod

  reference String?
  notes     String?

  status PaymentStatus @default(RECORDED)

  createdByMemberId String
  voidedByMemberId  String?
  voidedAt          DateTime?
  voidReason        String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, paymentDate])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([direction])
  @@index([currency])
  @@map("payments")
}

/// A versioned project budget (PRD #15 §103, §109).
///
/// An approved budget is never edited; a revision is a new version, and exactly
/// one version per project carries `isCurrent` (PRD #15 §111, §115, §201).
model ProjectBudget {
  id        String @id @default(cuid())
  companyId String
  projectId String

  version          Int
  name             String?
  currency         String        @db.VarChar(3)
  status           BudgetStatus  @default(DRAFT)
  preArchiveStatus BudgetStatus?
  isCurrent        Boolean       @default(false)

  totalAmount Decimal @db.Decimal(18, 2)
  notes       String?

  createdByMemberId  String
  updatedByMemberId  String?
  approvedByMemberId String?
  approvedAt         DateTime?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  lineItems ProjectBudgetLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([projectId, isCurrent])
  @@index([currency])
  @@map("project_budgets")
}

model ProjectBudgetLineItem {
  id       String @id @default(cuid())
  budgetId String

  category      FinanceCostCategory
  description   String
  plannedAmount Decimal             @db.Decimal(18, 2)
  sortOrder     Int                 @default(0)

  budget ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([category])
  @@map("project_budget_line_items")
}

/// Approved future spend not yet recognised as an expense (PRD #15 §124).
///
/// The source columns exist so a future Procurement purchase order can claim
/// the commitment it created rather than a second one appearing beside it
/// (PRD #15 §127).
model Commitment {
  id        String  @id @default(cuid())
  companyId String
  projectId String?

  reference        String?
  description      String
  counterpartyName String?
  category         FinanceCostCategory

  currency String  @db.VarChar(3)
  amount   Decimal @db.Decimal(18, 2)

  expectedDate     DateTime?
  status           CommitmentStatus  @default(DRAFT)
  preArchiveStatus CommitmentStatus?

  sourceModule     String?
  sourceEntityType String?
  sourceEntityId   String?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([category])
  @@index([expectedDate])
  @@index([currency])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@map("commitments")
}

/// One approval cycle for one finance record (PRD #15 §137).
///
/// A resubmission creates a new row rather than reopening the old one, so the
/// record's approval history stays readable (PRD #15 §64, §145).
model FinanceApproval {
  id        String @id @default(cuid())
  companyId String

  recordType FinanceApprovalRecordType
  recordId   String

  status FinanceApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("finance_approvals")
}

/// The canonical employment record (PRD #16 §25, §26).
///
/// One per company membership. It carries employment facts — dates, type,
/// manager, hours — and deliberately not identity: a person's name, email and
/// phone belong to their `User`, and their role and department to their
/// `CompanyMember` (PRD #16 §2).
model EmployeeProfile {
  id              String @id @default(cuid())
  companyId       String
  companyMemberId String @unique

  employeeNumber   String?
  employmentStatus EmploymentStatus @default(PLANNED)
  employmentType   EmploymentType   @default(FULL_TIME)

  startDate        DateTime?
  probationEndDate DateTime?
  endDate          DateTime?

  managerMemberId String?
  workLocation    String?
  weeklyHours     Decimal? @db.Decimal(6, 2)

  onboardingStatus  HrProgressStatus @default(NOT_STARTED)
  offboardingStatus HrProgressStatus @default(NOT_REQUIRED)

  createdByMemberId String?
  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyMember CompanyMember  @relation("EmployeeProfileMember", fields: [companyMemberId], references: [id], onDelete: Restrict)
  managerMember CompanyMember? @relation("EmployeeProfileManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  compensations     Compensation[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([companyId, employmentType])
  @@index([managerMemberId])
  @@index([startDate])
  @@index([endDate])
  @@map("employee_profiles")
}

/// Pay, behind its own permission (PRD #16 §17, §58).
///
/// Effective-dated rather than overwritten: a raise opens a new record and
/// closes the previous one, so what somebody was paid last year survives
/// (PRD #16 §64, §65).
model Compensation {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String

  currency   String              @db.VarChar(3)
  payType    CompensationPayType
  baseAmount Decimal             @db.Decimal(18, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  notes String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeProfileId])
  @@index([employeeProfileId, effectiveFrom])
  @@index([currency])
  @@map("compensations")
}

model LeaveRequest {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  days      Decimal   @db.Decimal(6, 2)
  reason    String?

  status LeaveRequestStatus @default(DRAFT)

  submittedAt DateTime?

  approvedByMemberId String?
  approvedAt         DateTime?

  rejectedByMemberId String?
  rejectedAt         DateTime?

  cancelledByMemberId String?
  cancelledAt         DateTime?

  decisionNote String?

  createdByMemberId String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([leaveType])
  @@map("leave_requests")
}

/// Entitlement per employee, type and year (PRD #16 §79).
///
/// `usedDays` is maintained transactionally from approved leave, never sent by
/// a browser: it is the number every "do you have enough days" check reads
/// (PRD #16 §80).
model LeaveBalance {
  id                String    @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String
  leaveType         LeaveType
  year              Int

  entitledDays   Decimal @db.Decimal(6, 2)
  usedDays       Decimal @default(0) @db.Decimal(6, 2)
  adjustmentDays Decimal @default(0) @db.Decimal(6, 2)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, leaveType, year])
  @@index([companyId])
  @@index([companyMemberId])
  @@index([year])
  @@map("leave_balances")
}

/// Daily attendance, not biometric timekeeping (PRD #16 §97).
///
/// The source columns let approved leave write `ON_LEAVE` days and, when that
/// leave is cancelled, take exactly those rows back out again — without
/// touching anything a person entered by hand (PRD #16 §109, §110).
model AttendanceRecord {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String

  date   DateTime
  status AttendanceStatus

  checkIn       DateTime?
  checkOut      DateTime?
  workedMinutes Int?

  notes  String?
  source AttendanceSource @default(MANUAL)

  sourceEntityType String?
  sourceEntityId   String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyMemberId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([status])
  @@index([sourceEntityType, sourceEntityId])
  @@map("attendance_records")
}

/// A prospective contact nobody has qualified yet (PRD #17 §32, §33).
///
/// A Lead is not a Client. It may name a company that does not exist in the
/// system, an email nobody has replied to, and a value somebody guessed. The
/// canonical Client is created at conversion, through the Clients service —
/// never by copying these fields into a second customer table (PRD #17 §4, §54).
model Lead {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  website     String?

  source           LeadSource
  status           LeadStatus  @default(NEW)
  /// The status to return to on restore, so an archived lead comes back
  /// CONTACTED if that is what it was (PRD #17 §58).
  preArchiveStatus LeadStatus?

  ownerMemberId String?
  notes         String?

  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String?  @db.VarChar(3)

  /// Why the lead went nowhere. Free text rather than an enum, so a company can
  /// say what actually happened without a migration (PRD #17 §421).
  disqualifyReason String?

  /// Conversion lineage (PRD #17 §386, §438). `convertedOpportunity` is the
  /// back-reference of `Opportunity.sourceLeadId`, so one column carries the
  /// link and the two records can never disagree about it.
  convertedAt       DateTime?
  convertedClientId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   CompanyMember? @relation("LeadOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  convertedClient      Client?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity? @relation("OpportunitySourceLead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, ownerMemberId])
  @@index([companyId, source])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("leads")
}

/// A qualified potential deal (PRD #17 §59, §60).
///
/// `stage` is the commercial outcome and keeps WON or LOST forever; archiving
/// is `archivedAt`, a separate fact, so closing the books on a deal never
/// overwrites how it ended (PRD #17 §61, §62).
model Opportunity {
  id            String  @id @default(cuid())
  companyId     String
  name          String
  clientId      String?
  contactId     String?
  ownerMemberId String

  stage           OpportunityStage  @default(PROSPECTING)
  /// Stage the opportunity held before archiving (PRD #17 §60).
  preArchiveStage OpportunityStage?
  /// When the stage last moved, for pipeline aging (PRD #17 §439, §442).
  stageChangedAt  DateTime          @default(now())

  estimatedValue      Decimal  @db.Decimal(18, 2)
  currency            String   @db.VarChar(3)
  /// 0–100, overriding the stage default when the owner knows better
  /// (PRD #17 §28).
  probabilityOverride Decimal? @db.Decimal(5, 2)

  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  description String?
  nextStep    String?

  sourceLeadId String? @unique

  wonReason  String?
  lostReason LostReason?
  lostNote   String?

  convertedProjectId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   CompanyMember @relation("OpportunityOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)

  sourceLead       Lead?    @relation("OpportunitySourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  convertedProject Project? @relation("OpportunityConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, stage])
  @@index([companyId, ownerMemberId])
  @@index([clientId])
  @@index([contactId])
  @@index([convertedProjectId])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("opportunities")
}

/// A commercial offer against an Opportunity (PRD #17 §104).
///
/// A Proposal is not an Invoice. It carries no receivable, settles nothing, and
/// the Finance module never reads it as one (PRD #17 §153).
model Proposal {
  id             String @id @default(cuid())
  companyId      String
  proposalNumber String
  opportunityId  String
  clientId       String

  title    String
  currency String @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  validUntil DateTime?

  status           ProposalStatus  @default(DRAFT)
  preArchiveStatus ProposalStatus?

  notes String?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  lineItems ProposalLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([opportunityId])
  @@index([clientId])
  @@index([validUntil])
  @@index([currency])
  @@index([updatedAt])
  @@map("proposals")
}

model ProposalLineItem {
  id         String @id @default(cuid())
  proposalId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId])
  @@map("proposal_line_items")
}

/// One approval cycle on a Proposal (PRD #17 §128, §129).
///
/// Shaped like FinanceApproval and kept separate on purpose: the two modules
/// grant approval authority through different permissions, and a shared table
/// would make "who may decide this?" a question about a row rather than about a
/// module (PRD #17 §19).
model SalesApproval {
  id        String @id @default(cuid())
  companyId String

  recordType SalesApprovalRecordType
  recordId   String

  status SalesApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("sales_approvals")
}

model Contract {
  id           String         @id @default(cuid())
  companyId    String
  clientId     String?
  projectId    String?
  reference    String
  title        String
  value        Decimal?       @db.Decimal(14, 2)
  currency     String         @default("EUR")
  status       ContractStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  counterparty String?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
  @@index([projectId])
  @@index([endDate])
  @@map("contracts")
}

model PurchaseRequest {
  id                String                @id @default(cuid())
  companyId         String
  projectId         String?
  requestedMemberId String?
  reference         String
  title             String
  amount            Decimal?              @db.Decimal(14, 2)
  currency          String                @default("EUR")
  status            PurchaseRequestStatus @default(DRAFT)
  neededBy          DateTime?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requester CompanyMember? @relation("PurchaseRequester", fields: [requestedMemberId], references: [id], onDelete: SetNull)

  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@map("purchase_requests")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  companyId  String
  projectId  String?
  requestId  String?
  reference  String
  supplier   String
  amount     Decimal             @db.Decimal(14, 2)
  currency   String              @default("EUR")
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  request PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@map("purchase_orders")
}

model InventoryItem {
  id           String   @id @default(cuid())
  companyId    String
  sku          String
  name         String
  unit         String   @default("unit")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  location     String?
  unitCost     Decimal? @db.Decimal(12, 2)

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([name])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  companyId     String
  itemId        String
  projectId     String?
  actorMemberId String?
  type          MovementType
  quantity      Int
  note          String?

  createdBy String

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   CompanyMember? @relation("MovementActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([itemId])
  @@index([projectId])
  @@index([createdAt])
  @@map("inventory_movements")
}

