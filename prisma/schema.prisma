  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

enum HseInspectionResult {
  NOT_SET
  PASS
  FAIL
  CONDITIONAL
}

enum HseTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum HseChecklistResponseType {
  PASS_FAIL
  PASS_FAIL_NA
  BOOLEAN
  TEXT
  NUMBER
}

