/**
 * --------------------------------------------------------------------------
 */
/**
 * Project planning: phases, milestones, dependencies, blockers (PRD #44)
 */
/**
 * --------------------------------------------------------------------------
 */

enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  DELAYED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectMilestoneType {
  PROJECT_START
  DESIGN
  APPROVAL
  PROCUREMENT
  CONSTRUCTION
  INSPECTION
  COMMISSIONING
  HANDOVER
  PAYMENT
  CONTRACTUAL
  INTERNAL
  OTHER
}

enum ProjectMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  DELAYED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MilestoneDependencyType {
  FINISH_TO_START
}

enum MilestoneBlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneTaskLinkType {
  SUPPORTS
  BLOCKS
  DELIVERS
  RELATED
}

/// A planning segment of a project (PRD #44 §9-§11, §26, §28).
model ProjectPhase {
  id        String @id @default(cuid())
  companyId String
  projectId String

  name        String
  description String?
  sortOrder   Int

  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  forecastStartDate DateTime?
  forecastEndDate   DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?

  status          ProjectPhaseStatus @default(NOT_STARTED)
  progressPercent Decimal?           @db.Decimal(5, 2)
  ownerMemberId   String?

  archivedAt        DateTime?
  createdByMemberId String
  version           Int       @default(1)

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestones ProjectMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId, sortOrder])
  @@index([companyId, projectId, status])
  @@map("project_phases")
}

/// A key achievement or date on a project (PRD #44 §12-§31).
model ProjectMilestone {
  id        String  @id @default(cuid())
  companyId String
  projectId String
  phaseId   String?

  name        String
  description String?

  milestoneType ProjectMilestoneType   @default(OTHER)
  status        ProjectMilestoneStatus @default(NOT_STARTED)
  ownerMemberId String?

  /// Business dates at midday UTC. Baseline is the approved reference and only moves through a baseline change.
  baselineDate DateTime?
  plannedDate  DateTime?
  forecastDate DateTime?
  actualDate   DateTime?

  progressPercent     Decimal? @db.Decimal(5, 2)
  critical            Boolean  @default(false)
  externallyCommitted Boolean  @default(false)
  sortOrder           Int

  /// When the status last changed: a new at-risk episode for Attention (PRD #44 §72, §73).
  statusChangedAt     DateTime?
  completionNote      String?
  completedByMemberId String?
  reopenedAt          DateTime?

  archivedAt        DateTime?
  createdByMemberId String
  version           Int       @default(1)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: Restrict)

  predecessors ProjectMilestoneDependency[] @relation("MilestoneSuccessor")
  successors   ProjectMilestoneDependency[] @relation("MilestonePredecessor")
  taskLinks    ProjectMilestoneTaskLink[]
  blockers     ProjectMilestoneBlocker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId, sortOrder])
  @@index([companyId, projectId, status])
  @@index([companyId, forecastDate])
  @@index([companyId, ownerMemberId, status])
  @@index([phaseId])
  @@map("project_milestones")
}

/// Finish-to-start sequencing between two milestones of one project (PRD #44 §32-§39).
model ProjectMilestoneDependency {
  id        String @id @default(cuid())
  companyId String
  projectId String

  predecessorMilestoneId String
  successorMilestoneId   String
  dependencyType         MilestoneDependencyType @default(FINISH_TO_START)
  lagDays                Int                     @default(0)

  createdByMemberId String

  predecessor ProjectMilestone @relation("MilestonePredecessor", fields: [predecessorMilestoneId], references: [id], onDelete: Restrict)
  successor   ProjectMilestone @relation("MilestoneSuccessor", fields: [successorMilestoneId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([predecessorMilestoneId, successorMilestoneId])
  @@index([companyId, projectId])
  @@index([successorMilestoneId])
  @@map("project_milestone_dependencies")
}

/// An active known issue standing in a milestone's way (PRD #44 §40-§42, §153-§157).
model ProjectMilestoneBlocker {
  id          String @id @default(cuid())
  companyId   String
  milestoneId String

  title       String
  description String?
  severity    MilestoneBlockerSeverity @default(MEDIUM)

  ownerMemberId String?
  dueDate       DateTime?

  resolvedAt         DateTime?
  resolvedByMemberId String?
  resolutionNote     String?

  linkedTaskId      String?
  createdByMemberId String

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, milestoneId, resolvedAt])
  @@index([companyId, severity, resolvedAt])
  @@map("project_milestone_blockers")
}

model ProjectMilestoneTaskLink {
  id          String @id @default(cuid())
  companyId   String
  milestoneId String
  taskId      String

  linkType          MilestoneTaskLinkType @default(SUPPORTS)
  createdByMemberId String

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([milestoneId, taskId])
  @@index([companyId, taskId])
  @@map("project_milestone_task_links")
}

/// Company planning rules (PRD #44 §71, §309).
model ProjectPlanningSettings {
  id        String @id @default(cuid())
  companyId String @unique

  milestoneReminderDays             Int     @default(7)
  baselineChangeReasonRequired      Boolean @default(true)
  /// Tell the CEO and Owner when a critical, externally committed milestone's baseline moves or it falls overdue (PRD #44 §165, §253).
  notifyExecutivesOnCriticalChanges Boolean @default(false)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_planning_settings")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Announcements, favorites and recent work (PRD #45)
 */
/**
 * --------------------------------------------------------------------------
 */

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  CRITICAL
}

enum AnnouncementAudienceType {
  COMPANY
  DEPARTMENT
  PROJECT
  SELECTED_MEMBERS
}

/// An intentionally published one-to-many internal bulletin (PRD #45 §6-§68).
model Announcement {
  id        String @id @default(cuid())
  companyId String

  title String
  /// Safe rich text: a small markdown subset rendered as React nodes, never HTML (§17).
  body  String

  status       AnnouncementStatus       @default(DRAFT)
  priority     AnnouncementPriority     @default(NORMAL)
  audienceType AnnouncementAudienceType @default(COMPANY)
  departmentId String?
  projectId    String?

  authorMemberId      String
  publishedByMemberId String?

  publishAt   DateTime?
  publishedAt DateTime?
  expiresAt   DateTime?
  expiredAt   DateTime?

  pinned                 Boolean @default(false)
  requiresAcknowledgment Boolean @default(false)

  /// A real dated event: the only thing that puts an announcement on the calendar (§40-§43).
  eventStartsAt DateTime?
  eventEndsAt   DateTime?

  /// Set when a published announcement's content is corrected (§145).
  editedAt   DateTime?
  archivedAt DateTime?
  version    Int       @default(1)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)

  selectedMembers AnnouncementAudienceMember[]
  reads           AnnouncementRead[]
  acknowledgments AnnouncementAcknowledgment[]
  targets         AnnouncementTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, publishAt])
  @@index([companyId, priority, publishedAt])
  @@index([companyId, projectId, status])
  @@index([companyId, departmentId, status])
  @@index([companyId, status, expiresAt])
  @@index([companyId, eventStartsAt])
  @@map("announcements")
}

model AnnouncementAudienceMember {
  announcementId String
  memberId       String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, memberId])
  @@index([memberId])
  @@map("announcement_audience_members")
}

/// Who opened it and when — personal state, never an audit event (§13, §55).
model AnnouncementRead {
  announcementId String
  memberId       String
  firstReadAt    DateTime
  lastReadAt     DateTime

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, memberId])
  @@index([memberId, lastReadAt])
  @@map("announcement_reads")
}

/// "I have read this" — explicit, self-only, not a legal acceptance (§14-§16).
model AnnouncementAcknowledgment {
  announcementId String
  memberId       String
  acknowledgedAt DateTime

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, memberId])
  @@index([memberId, acknowledgedAt])
  @@map("announcement_acknowledgments")
}

/// Who was asked to acknowledge, as it stood at publication (§135-§140).
model AnnouncementTarget {
  announcementId String
  memberId       String
  targetedAt     DateTime

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, memberId])
  @@index([memberId])
  @@map("announcement_targets")
}

/// A personal shortcut to a record; grants nothing (§69-§93).
model UserFavorite {
  id         String @id @default(cuid())
  companyId  String
  memberId   String
  /// A key of the code-defined navigable entity registry (§163).
  entityType String
  entityId   String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memberId, entityType, entityId])
  @@index([companyId, memberId, createdAt])
  @@map("user_favorites")
}

/// A record this member opened recently — not audit, not activity, prunable (§94-§115).
model RecentItem {
  id             String   @id @default(cuid())
  companyId      String
  memberId       String
  entityType     String
  entityId       String
  lastAccessedAt DateTime
  accessCount    Int      @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, entityType, entityId])
  @@index([companyId, memberId, lastAccessedAt])
  @@index([lastAccessedAt])
  @@map("recent_items")
}

/// Company switches and retention for the shared productivity layer (§247).
model ProductivitySettings {
  id        String @id @default(cuid())
  companyId String @unique

  announcementsEnabled        Boolean @default(true)
  favoritesEnabled            Boolean @default(true)
  recentWorkEnabled           Boolean @default(true)
  recentWorkRetentionDays     Int     @default(90)
  announcementAckReminderDays Int     @default(3)
  /// Ordinary announcements appear in the feed; this also sends them as notifications (§45).
  notifyNormalAnnouncements   Boolean @default(false)

  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productivity_settings")
}

// ---------------------------------------------------------------------------
// Contractors, engineering & legal integration (PRD #46)
//
// A contractor is an external business organisation the company engages — not
// a CompanyMember, not a Supplier, and in V0.1 never somebody who signs in
// (§3, §5, §14). Engineering records are the technical coordination truth on a
// project; every file stays a canonical Document, and Legal keeps contracts
// (§50, §125). Every record carries companyId, projectId, contractorId and
// workPackageId where they apply, so a V0.2 portal can scope external access
// without redesigning them (§261).
