  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockIssueId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([reservationId])
  @@index([movementId])
