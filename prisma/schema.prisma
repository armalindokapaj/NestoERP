/// The contract lifecycle (PRD #18 §40, §191).
///
/// EXPIRING is deliberately absent. "Expiring soon" is a fact about today and
/// the expiry date, derived on read — storing it would mean a contract's status
/// depended on when a maintenance job last ran (PRD #18 §75, §193).
enum ContractStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
  ARCHIVED
}

