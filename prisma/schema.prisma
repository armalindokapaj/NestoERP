// NESTO V0.1 — Core Data Model (PRD #8).
//
// One company, one user identity, one membership, one project, one client,
// one task, one document, one activity system. Every module references these
// shared records rather than duplicating them (PRD #8 §1, §3).
//
// Company isolation is structural: every business record carries companyId and
// every query must constrain it (PRD #8 §6, §7). Prisma foreign keys cannot
// guarantee that related records share a company, so the service layer
// validates that before every write (PRD #8 §64).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
  SUSPENDED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum AccessLevel {
  NONE
  VIEW
  CONTRIBUTE
  APPROVE
  MANAGE
}

enum DataScope {
  SELF
  ASSIGNED
  PROJECT
  DEPARTMENT
  COMPANY
  SYSTEM
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMemberStatus {
  ACTIVE
  INACTIVE
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  PUBLIC_ENTITY
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  ACCOUNT_BLOCKED
  MEMBERSHIP_DENIED
}

// Module test-record enums (PRD #9 §67)
// Deliberately small shapes that exercise the Module Shell: lists, details,
// statuses, scope and approval. They are not the final ERP domain models.

enum InvoiceStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  OVERDUE
  ARCHIVED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRING
  EXPIRED
  ARCHIVED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  DELIVERED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum QualityRecordType {
  INSPECTION
  NCR
  PUNCH_ITEM
  TEST
}

enum HseRecordType {
  INCIDENT
  INSPECTION
  PERMIT
  CORRECTIVE_ACTION
}

enum RecordSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkRecordStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

/// One global NESTO identity. Role, company and department live on the
/// membership, never here (PRD #8 §13).
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  memberships         CompanyMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]

  createdActivities Activity[] @relation("ActivityActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Company {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  legalName String?
  logoUrl   String?
  industry  String?
  country   String?
  address   String?
  email     String?
  phone     String?
  website   String?
  status    CompanyStatus @default(ACTIVE)

  memberships CompanyMember[]
  departments Department[]
  modules     CompanyModule[]

  projects   Project[]
  clients    Client[]
  contacts   Contact[]
  tasks      Task[]
  documents  Document[]
  activities Activity[]

  invoices         Invoice[]
  leaveRequests    LeaveRequest[]
  opportunities    Opportunity[]
  contracts        Contract[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  inventoryItems   InventoryItem[]
  stockMovements   InventoryMovement[]
  qualityRecords   QualityRecord[]
  hseRecords       HseRecord[]
  supportRequests  SupportRequest[]

  sessions   Session[]
  authEvents AuthEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@map("companies")
}

model Department {
  id              String           @id @default(cuid())
  companyId       String
  name            String
  key             String?
  description     String?
  managerMemberId String?
  status          DepartmentStatus @default(ACTIVE)
  archivedAt      DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CompanyMember[] @relation("DepartmentMembers")

  managerMember CompanyMember? @relation("DepartmentManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@index([companyId])
  @@index([managerMemberId])
  @@index([status])
  @@map("departments")
}

/// One of the 16 predefined V0.1 roles. Stored as a row rather than an enum so
/// company-specific roles can be added later without a migration (PRD #5 §45).
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  members      CompanyMember[]
  permissions  RolePermission[]
  moduleAccess RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  scope        DataScope?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  route       String       @unique
  status      ModuleStatus @default(ACTIVE)

  companyModules CompanyModule[]
  roleAccess     RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

/// The simplified role × module matrix. Combined with RolePermission and
/// CompanyModule it produces the final module context (PRD #6 §129A).
model RoleModuleAccess {
  id          String      @id @default(cuid())
  roleId      String
  moduleId    String
  accessLevel AccessLevel
  scope       DataScope

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
  @@map("role_module_access")
}

/// A module switched off here is unavailable regardless of role (PRD #7 §59).
model CompanyModule {
  id        String  @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

/// The centre of NESTO: user + company + role + department. This is what makes
/// the same person an Architect in one company and a PM in another (PRD #8 §14).
model CompanyMember {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  roleId       String
  departmentId String?
  jobTitle     String?
  status       MembershipStatus @default(ACTIVE)
  archivedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  managedDepartments Department[]    @relation("DepartmentManager")
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreatorMember")

  activityActions Activity[] @relation("ActivityActorMember")

  leaveRequests    LeaveRequest[]      @relation("LeaveEmployee")
  ownedInvoices    Invoice[]           @relation("InvoiceOwner")
  ownedOpportunity Opportunity[]       @relation("OpportunityOwner")
  requestedOrders  PurchaseRequest[]   @relation("PurchaseRequester")
  stockMovements   InventoryMovement[] @relation("MovementActor")
  qualityRecords   QualityRecord[]     @relation("QualityAssignee")
  hseRecords       HseRecord[]         @relation("HseAssignee")
  supportRequests  SupportRequest[]    @relation("SupportRequester")

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// Core business objects
// ---------------------------------------------------------------------------

model Project {
  id                     String           @id @default(cuid())
  companyId              String
  code                   String
  name                   String
  description            String?
  clientId               String?
  projectManagerMemberId String?
  status                 ProjectStatus    @default(DRAFT)
  /// Status the project held before archiving, so Restore returns it there
  /// rather than always to ACTIVE (PRD #10 §68).
  preArchiveStatus       ProjectStatus?
  priority               ProjectPriority?
  startDate              DateTime?
  endDate                DateTime?
  address                String?
  city                   String?
  country                String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectManager CompanyMember? @relation("ProjectManager", fields: [projectManagerMemberId], references: [id], onDelete: SetNull)

  members   ProjectMember[]
  tasks     Task[]
  documents Document[]

  invoices         Invoice[]
  contracts        Contract[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  stockMovements   InventoryMovement[]
  qualityRecords   QualityRecord[]
  hseRecords       HseRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([clientId])
  @@index([projectManagerMemberId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@map("projects")
}

/// How PROJECT and ASSIGNED scope are resolved: user → member → project
/// membership → project (PRD #8 §28).
model ProjectMember {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  companyMemberId String
  projectRole     String?
  isPrimary       Boolean             @default(false)
  status          ProjectMemberStatus @default(ACTIVE)
  joinedAt        DateTime?
  leftAt          DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, companyMemberId])
  @@index([companyId])
  @@index([projectId])
  @@index([companyMemberId])
  @@index([companyId, companyMemberId])
  @@index([status])
  @@map("project_members")
}

model Client {
  id        String       @id @default(cuid())
  companyId String
  code      String?
  name      String
  legalName String?
  type      ClientType   @default(COMPANY)
  email     String?
  phone     String?
  website   String?
  address   String?
  city      String?
  country   String?
  status    ClientStatus @default(ACTIVE)

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contacts      Contact[]
  projects      Project[]
  documents     Document[]
  invoices      Invoice[]
  opportunities Opportunity[]
  contracts     Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@index([updatedAt])
  @@map("clients")
}

model Contact {
  id        String        @id @default(cuid())
  companyId String
  clientId  String
  firstName String
  lastName  String
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean       @default(false)
  status    ContactStatus @default(ACTIVE)

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([lastName, firstName])
  @@index([status])
  @@map("contacts")
}

model Task {
  id                String       @id @default(cuid())
  companyId         String
  projectId         String?
  title             String
  description       String?
  assigneeMemberId  String?
  createdByMemberId String
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  dueDate           DateTime?
  completedAt       DateTime?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignee CompanyMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  creator  CompanyMember  @relation("TaskCreatorMember", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([updatedAt])
  @@map("tasks")
}

/// File metadata plus the business context that governs who may see it.
/// A document is reachable only through its parent's permissions (PRD #8 §43).
model Document {
  id          String         @id @default(cuid())
  companyId   String
  name        String
  description String?
  fileName    String?
  fileUrl     String?
  storageKey  String?
  mimeType    String?
  sizeBytes   BigInt?
  projectId   String?
  clientId    String?
  module      String?
  entityType  String?
  entityId    String?
  status      DocumentStatus @default(ACTIVE)

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([clientId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([updatedAt])
  @@map("documents")
}

/// Business/user-visible activity. Authentication events go to AuthEvent —
/// the two are never combined (PRD #8 §48).
model Activity {
  id            String  @id @default(cuid())
  companyId     String
  module        String
  entityType    String
  entityId      String
  action        String
  message       String?
  actorMemberId String?
  actorUserId   String?
  metadata      Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorMember CompanyMember? @relation("ActivityActorMember", fields: [actorMemberId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation("ActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A server-side session record. The signed cookie carries only this row's id,
/// so revoking access is a delete rather than a wait for a token to expire
/// (PRD #6 §51, §113).
model Session {
  id               String   @id @default(cuid())
  sessionToken     String   @unique
  userId           String
  membershipId     String
  currentCompanyId String
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership CompanyMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company       @relation(fields: [currentCompanyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([membershipId])
  @@index([currentCompanyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the hash is stored; the raw token exists solely in the emailed link
/// (PRD #6 §57).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  companyId String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

// ---------------------------------------------------------------------------
// Module test records (PRD #9 §67)
// ---------------------------------------------------------------------------
// Minimal shapes that make the Module Shell testable: list, detail, status,
// scope, approval. Each department module replaces its table when its own PRD
// lands; none of these is a final domain model.

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  projectId     String?
  clientId      String?
  ownerMemberId String?
  invoiceNumber String
  title         String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("EUR")
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?
  dueDate       DateTime?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?
  archivedBy String?
  archivedAt DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner   CompanyMember? @relation("InvoiceOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([clientId])
  @@index([dueDate])
  @@map("invoices")
}

model LeaveRequest {
  id               String      @id @default(cuid())
  companyId        String
  employeeMemberId String
  type             String
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String?
  status           LeaveStatus @default(PENDING)

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee CompanyMember @relation("LeaveEmployee", fields: [employeeMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([employeeMemberId])
  @@map("leave_requests")
}

model Opportunity {
  id            String           @id @default(cuid())
  companyId     String
  clientId      String?
  ownerMemberId String?
  name          String
  stage         OpportunityStage @default(LEAD)
  value         Decimal          @db.Decimal(14, 2)
  currency      String           @default("EUR")
  expectedClose DateTime?
  notes         String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner   CompanyMember? @relation("OpportunityOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, stage])
  @@index([clientId])
  @@map("opportunities")
}

model Contract {
  id           String         @id @default(cuid())
  companyId    String
  clientId     String?
  projectId    String?
  reference    String
  title        String
  value        Decimal?       @db.Decimal(14, 2)
  currency     String         @default("EUR")
  status       ContractStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  counterparty String?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
  @@index([projectId])
  @@index([endDate])
  @@map("contracts")
}

model PurchaseRequest {
  id                String                @id @default(cuid())
  companyId         String
  projectId         String?
  requestedMemberId String?
  reference         String
  title             String
  amount            Decimal?              @db.Decimal(14, 2)
  currency          String                @default("EUR")
  status            PurchaseRequestStatus @default(DRAFT)
  neededBy          DateTime?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requester CompanyMember? @relation("PurchaseRequester", fields: [requestedMemberId], references: [id], onDelete: SetNull)

  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@map("purchase_requests")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  companyId  String
  projectId  String?
  requestId  String?
  reference  String
  supplier   String
  amount     Decimal             @db.Decimal(14, 2)
  currency   String              @default("EUR")
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?

  createdBy  String
  updatedBy  String?
  approvedBy String?
  approvedAt DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  request PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@map("purchase_orders")
}

model InventoryItem {
  id           String   @id @default(cuid())
  companyId    String
  sku          String
  name         String
  unit         String   @default("unit")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  location     String?
  unitCost     Decimal? @db.Decimal(12, 2)

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([name])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  companyId     String
  itemId        String
  projectId     String?
  actorMemberId String?
  type          MovementType
  quantity      Int
  note          String?

  createdBy String

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   CompanyMember? @relation("MovementActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([itemId])
  @@index([projectId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model QualityRecord {
  id               String            @id @default(cuid())
  companyId        String
  projectId        String?
  assignedMemberId String?
  reference        String
  type             QualityRecordType
  title            String
  description      String?
  severity         RecordSeverity?
  status           WorkRecordStatus  @default(OPEN)
  dueDate          DateTime?
  closedAt         DateTime?

  createdBy String
  updatedBy String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee CompanyMember? @relation("QualityAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([type])
  @@map("quality_records")
}

model HseRecord {
  id               String           @id @default(cuid())
  companyId        String
  projectId        String?
  assignedMemberId String?
  reference        String
  type             HseRecordType
  title            String
  description      String?
  severity         RecordSeverity?
  status           WorkRecordStatus @default(OPEN)
  occurredAt       DateTime?
  closedAt         DateTime?

  createdBy String
  updatedBy String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee CompanyMember? @relation("HseAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([type])
  @@map("hse_records")
}

model SupportRequest {
  id                String               @id @default(cuid())
  companyId         String
  requestedMemberId String?
  reference         String
  subject           String
  body              String?
  status            SupportRequestStatus @default(OPEN)

  createdBy String
  updatedBy String?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester CompanyMember? @relation("SupportRequester", fields: [requestedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, status])
  @@map("support_requests")
}
