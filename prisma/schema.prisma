/**
 * Stock moving between locations (PRD #20 §129).
 * Posts two movements per line — out of one location, into another — in one
 * transaction, so total stock never changes and the two halves cannot be
 * separated (PRD #20 §137, §138).
 */
model StockTransfer {
  id        String @id @default(cuid())
  companyId String

  transferNumber String

  fromWarehouseId String
  toWarehouseId   String

  transferDate DateTime
  status       InventoryTransactionStatus @default(DRAFT)

  createdByMemberId String
  postedByMemberId  String?

  notes String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromWarehouse Warehouse @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  lines StockTransferLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, transferNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([transferDate])
  @@map("stock_transfers")
}

model StockTransferLine {
  id              String @id @default(cuid())
  stockTransferId String

  inventoryItemId String

  fromLocationId String
  toLocationId   String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  outMovementId String?
  inMovementId  String?

  notes String?

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  fromLocation InventoryLocation @relation("StockTransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   InventoryLocation @relation("StockTransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockTransferId])
  @@index([inventoryItemId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("stock_transfer_lines")
}

/**
 * A correction to what the system believes is there (PRD #20 §141).
 * Always carries a reason, because "the number changed" with no explanation is
 * exactly what an inventory audit exists to catch (PRD #20 §144).
 */
model StockAdjustment {
  id        String @id @default(cuid())
  companyId String

  adjustmentNumber String
  warehouseId      String

  adjustmentDate DateTime
  reason         StockAdjustmentReason

  status InventoryTransactionStatus @default(DRAFT)

  createdByMemberId String
  postedByMemberId  String?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines StockAdjustmentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, adjustmentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([adjustmentDate])
  @@index([reason])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                String @id @default(cuid())
  stockAdjustmentId String

  inventoryItemId String
  locationId      String

  /// Signed: negative writes stock off, positive writes it on (PRD #20 §147).
  quantityDelta Decimal @db.Decimal(18, 4)
  unit          String

  movementId String?

  notes String?

  stockAdjustment StockAdjustment   @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockAdjustmentId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([movementId])
  @@map("stock_adjustment_lines")
}

/**
 * Stock spoken for but not yet issued (PRD #20 §152).
 * A reservation moves quantity from available to reserved without moving it out
 * of the warehouse. It writes no ledger row, because nothing has physically
 * happened (PRD #20 §166).
 */
model StockReservation {
  id        String @id @default(cuid())
  companyId String

  reservationNumber String

  inventoryItemId String
  warehouseId     String
  locationId      String

  projectId String?

  quantity          Decimal @db.Decimal(18, 4)
  fulfilledQuantity Decimal @default(0) @db.Decimal(18, 4)

  status StockReservationStatus @default(ACTIVE)

  requiredDate DateTime?
  expiresAt    DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, reservationNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([projectId])
  @@index([requiredDate])
  @@index([expiresAt])
  @@map("stock_reservations")
}

