  PURCHASE_ORDER
}

enum ProcurementApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// Sent back to the requester for revision (PRD #41 §48); a resubmission opens a new cycle.
  RETURNED
}

enum InventoryItemCategory {
  MATERIAL
  EQUIPMENT
  TOOL
  CONSUMABLE
  SPARE_PART
  OFFICE
  OTHER
}

enum InventoryItemStatus {
