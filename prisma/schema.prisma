// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

/// One global NESTO identity. Role, company and department live on the
/// membership, never here (PRD #8 §13).
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  memberships         CompanyMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]

  createdActivities Activity[] @relation("ActivityActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Company {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  legalName String?
  logoUrl   String?
  industry  String?
  country   String?
  address   String?
  email     String?
  phone     String?
  website   String?
  status    CompanyStatus @default(ACTIVE)

  /// Bumped on every configuration mutation so caches and client context can
  /// be invalidated without guessing (PRD #37 §22, PRD #24 §315-§317).
  configVersion Int @default(1)

  memberships CompanyMember[]
  invites     CompanyInvite[]
  departments Department[]
  modules     CompanyModule[]

  projects   Project[]
  clients    Client[]
  contacts   Contact[]
  tasks      Task[]
  documents  Document[]
  activities Activity[]

  settings            CompanySettings?
  integrationSettings CompanyIntegrationSettings?
  storageQuota        CompanyStorageQuota?
  storageUsage        CompanyStorageUsage?
  uploadSessions      DocumentUploadSession[]
  numberingSchemes    CompanyNumberingScheme[]

  financeSettings      FinanceSettings?
  invoices             Invoice[]
  expenses             Expense[]
  payments             Payment[]
  projectBudgets       ProjectBudget[]
  commitments          Commitment[]
  financeApprovals     FinanceApproval[]
  employeeProfiles     EmployeeProfile[]
  compensations        Compensation[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  attendanceRecords    AttendanceRecord[]
  leads                Lead[]
  opportunities        Opportunity[]
  proposals            Proposal[]
  salesApprovals       SalesApproval[]
  contracts            Contract[]
  contractParties      ContractParty[]
  contractObligations  ContractObligation[]
  contractAmendments   ContractAmendment[]
  contractApprovals    ContractApproval[]
  suppliers            Supplier[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  rfqs                 RFQ[]
  supplierQuotes       SupplierQuote[]
  goodsReceipts        GoodsReceipt[]
  procurementApprovals ProcurementApproval[]
  inventoryItems       InventoryItem[]
  warehouses           Warehouse[]
  inventoryLocations   InventoryLocation[]
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  inventoryReceipts    InventoryReceipt[]
  stockIssues          StockIssue[]
  stockReturns         StockReturn[]
  stockTransfers       StockTransfer[]
  stockAdjustments     StockAdjustment[]
  stockReservations    StockReservation[]
  qualityRecords       QualityRecord[]
  hseRecords           HseRecord[]
  supportRequests      SupportRequest[]

  inspectionRequests          InspectionRequest[]
  inspectionTemplates         InspectionTemplate[]
  qualityInspections          QualityInspection[]
  materialInspectionDecisions MaterialInspectionDecision[]
  qualityMaterialReleases     QualityMaterialRelease[]
  qualityDefects              QualityDefect[]
  nonConformanceReports       NonConformanceReport[]
  correctiveActions           CorrectiveAction[]
  qualityApprovals            QualityApproval[]

  hseInspectionTemplates    HseInspectionTemplate[]
  hseInspections            HseInspection[]
  hseHazards                HseHazard[]
  hseIncidents              HseIncident[]
  hseRiskAssessments        HseRiskAssessment[]
  hseActions                HseAction[]
  toolboxTalks              ToolboxTalk[]
  hseWorkPermits            HseWorkPermit[]
  ppeChecks                 PpeCheck[]
  environmentalObservations EnvironmentalObservation[]
  stopWorkRecords           StopWorkRecord[]
  hseApprovals              HseApproval[]

  sessions            Session[]
  authEvents          AuthEvent[]
  auditEvents         AuditEvent[]
  integrationLinks    IntegrationLink[]
  integrationAttempts IntegrationAttempt[]

  notifications      Notification[]
  attentionItems     AttentionItem[]
  notificationOutbox NotificationEventOutbox[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@map("companies")
}

model Department {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  key              String?
  description      String?
  managerMemberId  String?
  status           DepartmentStatus  @default(ACTIVE)
  /// Restore returns the department to the status it held (PRD #14 §125).
  preArchiveStatus DepartmentStatus?

  createdBy  String?
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members CompanyMember[] @relation("DepartmentMembers")

  managerMember CompanyMember? @relation("DepartmentManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@index([companyId])
  @@index([companyId, status])
  @@index([managerMemberId])
  @@index([status])
  @@map("departments")
}

/// One of the 16 predefined V0.1 roles. Stored as a row rather than an enum so
/// company-specific roles can be added later without a migration (PRD #5 §45).
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  members      CompanyMember[]
  permissions  RolePermission[]
  moduleAccess RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  scope        DataScope?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  route       String       @unique
  status      ModuleStatus @default(ACTIVE)

  companyModules CompanyModule[]
  roleAccess     RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

/// The simplified role × module matrix. Combined with RolePermission and
/// CompanyModule it produces the final module context (PRD #6 §129A).
model RoleModuleAccess {
  id          String      @id @default(cuid())
  roleId      String
  moduleId    String
  accessLevel AccessLevel
  scope       DataScope

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
  @@map("role_module_access")
}

/// A module switched off here is unavailable regardless of role (PRD #7 §59).
model CompanyModule {
  id        String  @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

/// The centre of NESTO: user + company + role + department. This is what makes
/// the same person an Architect in one company and a PM in another (PRD #8 §14).
model CompanyMember {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  roleId       String
  departmentId String?
  jobTitle     String?
  status       MembershipStatus @default(ACTIVE)

  /// Bumped whenever role, department, project membership or status changes,
  /// so permission-sensitive caches key off it (PRD #37 §32-§34, PRD #31 §104).
  accessVersion Int @default(1)

  /// Membership lifecycle. Who invited them, when they accepted, and who
  /// removed their access — the questions asked after the fact (PRD #14 §12).
  invitedAt             DateTime?
  invitedByMemberId     String?
  joinedAt              DateTime?
  deactivatedAt         DateTime?
  deactivatedByMemberId String?

  archivedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  managedDepartments Department[]    @relation("DepartmentManager")
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]

  uploadedDocuments Document[]              @relation("DocumentUploadedBy")
  uploadSessions    DocumentUploadSession[] @relation("UploadSessionMember")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreatorMember")

  activityActions Activity[] @relation("ActivityActorMember")

  employeeProfile         EmployeeProfile?  @relation("EmployeeProfileMember")
  managedEmployeeProfiles EmployeeProfile[] @relation("EmployeeProfileManager")
  ownedLeads              Lead[]            @relation("LeadOwner")
  ownedOpportunities      Opportunity[]     @relation("OpportunityOwner")
  ownedContracts          Contract[]        @relation("ContractOwner")

  responsibleContractObligations ContractObligation[] @relation("ContractObligationResponsible")

  requestedPurchases PurchaseRequest[] @relation("PurchaseRequestRequester")
  ownedPurchases     PurchaseRequest[] @relation("PurchaseRequestOwner")
  goodsReceived      GoodsReceipt[]    @relation("GoodsReceiptReceiver")
  qualityRecords     QualityRecord[]   @relation("QualityAssignee")
  hseRecords         HseRecord[]       @relation("HseAssignee")
  supportRequests    SupportRequest[]  @relation("SupportRequester")

  requestedInspections       InspectionRequest[]      @relation("InspectionRequester")
  assignedInspectionRequests InspectionRequest[]      @relation("InspectionRequestInspector")
  assignedInspections        QualityInspection[]      @relation("QualityInspector")
  executedInspections        QualityInspection[]      @relation("QualityInspectionExecutor")
  materialReleases           QualityMaterialRelease[] @relation("QualityReleaser")
  assignedDefects            QualityDefect[]          @relation("QualityDefectAssignee")
  assignedNcrs               NonConformanceReport[]   @relation("NcrAssignee")
  ownedNcrs                  NonConformanceReport[]   @relation("NcrOwner")
  assignedCorrectiveActions  CorrectiveAction[]       @relation("CorrectiveActionAssignee")
  submittedQualityApprovals  QualityApproval[]        @relation("QualityApprovalSubmitter")
  decidedQualityApprovals    QualityApproval[]        @relation("QualityApprovalDecider")

  assignedHseInspections HseInspection[]            @relation("HseInspector")
  executedHseInspections HseInspection[]            @relation("HseInspectionExecutor")
  reportedHazards        HseHazard[]                @relation("HseHazardReporter")
  assignedHazards        HseHazard[]                @relation("HseHazardAssignee")
  reportedIncidents      HseIncident[]              @relation("HseIncidentReporter")
  investigatedIncidents  HseIncident[]              @relation("HseIncidentInvestigator")
  ownedRiskAssessments   HseRiskAssessment[]        @relation("HseRiskAssessmentOwner")
  assignedHseActions     HseAction[]                @relation("HseActionAssignee")
  conductedToolboxTalks  ToolboxTalk[]              @relation("ToolboxConductor")
  toolboxAttendances     ToolboxTalkParticipant[]   @relation("ToolboxParticipant")
  requestedPermits       HseWorkPermit[]            @relation("HsePermitRequester")
  responsiblePermits     HseWorkPermit[]            @relation("HsePermitResponsible")
  performedPpeChecks     PpeCheck[]                 @relation("PpeChecker")
  subjectPpeChecks       PpeCheck[]                 @relation("PpeSubject")
  reportedObservations   EnvironmentalObservation[] @relation("EnvObservationReporter")
  assignedObservations   EnvironmentalObservation[] @relation("EnvObservationAssignee")
  issuedStopWorks        StopWorkRecord[]           @relation("StopWorkIssuer")
  releasedStopWorks      StopWorkRecord[]           @relation("StopWorkReleaser")
  submittedHseApprovals  HseApproval[]              @relation("HseApprovalSubmitter")
  decidedHseApprovals    HseApproval[]              @relation("HseApprovalDecider")

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// Core business objects
// ---------------------------------------------------------------------------

model Project {
  id                     String           @id @default(cuid())
  companyId              String
  code                   String
  name                   String
  description            String?
  clientId               String?
  projectManagerMemberId String?
  status                 ProjectStatus    @default(DRAFT)
  /// Status the project held before archiving, so Restore returns it there
  /// rather than always to ACTIVE (PRD #10 §68).
  preArchiveStatus       ProjectStatus?
  priority               ProjectPriority?
  startDate              DateTime?
  endDate                DateTime?
  address                String?
  city                   String?
  country                String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectManager CompanyMember? @relation("ProjectManager", fields: [projectManagerMemberId], references: [id], onDelete: SetNull)

  members   ProjectMember[]
  tasks     Task[]
  documents Document[]

  invoices          Invoice[]
  expenses          Expense[]
  budgets           ProjectBudget[]
  commitments       Commitment[]
  contracts         Contract[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  rfqs              RFQ[]
  goodsReceipts     GoodsReceipt[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  stockIssues       StockIssue[]
  stockReturns      StockReturn[]
  stockReservations StockReservation[]
  qualityRecords    QualityRecord[]
  hseRecords        HseRecord[]

  inspectionRequests InspectionRequest[]
  qualityInspections QualityInspection[]
  qualityDefects     QualityDefect[]

  hseInspections            HseInspection[]
  hseHazards                HseHazard[]
  hseIncidents              HseIncident[]
  hseRiskAssessments        HseRiskAssessment[]
  hseActions                HseAction[]
  toolboxTalks              ToolboxTalk[]
  hseWorkPermits            HseWorkPermit[]
  ppeChecks                 PpeCheck[]
  environmentalObservations EnvironmentalObservation[]
  stopWorkRecords           StopWorkRecord[]
  nonConformanceReports     NonConformanceReport[]
  correctiveActions         CorrectiveAction[]

  sourceOpportunities Opportunity[] @relation("OpportunityConvertedProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([clientId])
  @@index([projectManagerMemberId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@map("projects")
}

/// How PROJECT and ASSIGNED scope are resolved: user → member → project
/// membership → project (PRD #8 §28).
model ProjectMember {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  companyMemberId String
  projectRole     String?
  isPrimary       Boolean             @default(false)
  status          ProjectMemberStatus @default(ACTIVE)
  joinedAt        DateTime?
  leftAt          DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, companyMemberId])
  @@index([companyId])
  @@index([projectId])
  @@index([companyMemberId])
  @@index([companyId, companyMemberId])
  @@index([status])
  @@map("project_members")
}

model Client {
  id               String        @id @default(cuid())
  companyId        String
  code             String?
  name             String
  legalName        String?
  type             ClientType    @default(COMPANY)
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?
  status           ClientStatus  @default(ACTIVE)
  /// The status to return to on restore, so an archived client comes back
  /// INACTIVE if that is what it was (PRD #12 §70, §75).
  preArchiveStatus ClientStatus?

  /// Lower-cased, punctuation-stripped `name`, maintained by the service and
  /// never edited directly. It exists so duplicate detection is an indexed
  /// lookup rather than a scan (PRD #12 §55, §162).
  normalizedName String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  contacts        Contact[]
  projects        Project[]
  documents       Document[]
  invoices        Invoice[]
  opportunities   Opportunity[]
  proposals       Proposal[]
  convertedLeads  Lead[]          @relation("LeadConvertedClient")
  contracts       Contract[]
  contractParties ContractParty[] @relation("ContractPartyClient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, normalizedName])
  @@index([name])
  @@index([email])
  @@index([country])
  @@index([updatedAt])
  @@map("clients")
}

model Contact {
  id               String         @id @default(cuid())
  companyId        String
  clientId         String
  firstName        String
  lastName         String
  jobTitle         String?
  email            String?
  phone            String?
  isPrimary        Boolean        @default(false)
  status           ContactStatus  @default(ACTIVE)
  /// As on Client: restore returns the contact to the status it held
  /// (PRD #12 §77, §88).
  preArchiveStatus ContactStatus?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([companyId, clientId, status])
  @@index([lastName, firstName])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model Task {
  id                String       @id @default(cuid())
  companyId         String
  projectId         String?
  title             String
  description       String?
  assigneeMemberId  String?
  createdByMemberId String
  status            TaskStatus   @default(TODO)
  /// The status to return to on restore, so an archived task remembers where it
  /// was rather than always coming back as TODO (PRD #11 §73).
  preArchiveStatus  TaskStatus?
  priority          TaskPriority @default(MEDIUM)
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?

  /// Generic parent context, so a later module can hang work off its own record
  /// without inventing a second task table (PRD #11 §171, §252).
  module     String?
  entityType String?
  entityId   String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignee CompanyMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  creator  CompanyMember  @relation("TaskCreatorMember", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, dueDate])
  @@index([companyId, assigneeMemberId, status])
  @@index([companyId, projectId, status])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([module])
  @@index([entityType, entityId])
  @@map("tasks")
}

/// File metadata plus the business context that governs who may see it.
/// A document is reachable only through its parent's permissions (PRD #8 §43).
model Document {
  id               String  @id @default(cuid())
  companyId        String
  name             String
  description      String?
  /// The name the file was uploaded under, kept for display. The storage key
  /// is sanitised separately and never derived from it (PRD #13 §23, §154).
  originalFileName String?
  fileName         String?
  extension        String?
  storageProvider  String?
  /// Deployment metadata only, kept so a bucket rename is a migration rather
  /// than an archaeology exercise. The key stays provider-neutral and the
  /// live bucket comes from configuration (PRD #29 §354, §356, §358).
  storageBucket    String?
  storageKey       String?
  mimeType         String?
  /// What the bytes actually are, read from the object's leading magic bytes
  /// after upload. The browser's declared type is advisory; this is not
  /// (PRD #29 §29, §31, §270).
  detectedMimeType String?
  sizeBytes        BigInt?
  /// SHA-256 of the stored object. Integrity and duplicate diagnostics only —
  /// never authorisation (PRD #13 §32, PRD #29 §88).
  checksum         String?

  /// The storage lifecycle, separate from `status`, which is the *business*
  /// visibility state. A document can be ACTIVE and still not downloadable
  /// because its object has not been verified (PRD #29 §2, §162).
  storageStatus       DocumentStorageStatus @default(PENDING_UPLOAD)
  scanStatus          DocumentScanStatus    @default(NOT_REQUIRED)
  scanProvider        String?
  scanCompletedAt     DateTime?
  previewStatus       DocumentPreviewStatus @default(NOT_REQUIRED)
  previewMimeType     String?
  /// Derived objects live under the original's prefix and are just as private
  /// (PRD #29 §237, §238).
  previewStorageKey   String?
  thumbnailStorageKey String?

  uploadedAt       DateTime?
  verifiedAt       DateTime?
  availableAt      DateTime?
  rejectedAt       DateTime?
  /// A safe code, never scanner internals or a signature name (PRD #29 §211).
  rejectionReason  String?
  projectId        String?
  clientId         String?
  module           String?
  entityType       String?
  entityId         String?
  status           DocumentStatus  @default(ACTIVE)
  /// Archived documents return to ACTIVE, but the field keeps the shape every
  /// other module uses (PRD #13 §114).
  preArchiveStatus DocumentStatus?

  /// Who uploaded it. Records authorship, not ownership: access is decided by
  /// company, parent and permissions (PRD #13 §281).
  uploadedByMemberId String?

  createdBy  String
  updatedBy  String?
  archivedBy String?
  archivedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  uploadedBy CompanyMember? @relation("DocumentUploadedBy", fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  uploadSessions DocumentUploadSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One object, one document. An upload can never be pointed at a key another
  /// row already owns (PRD #29 §179, §180, §349).
  @@unique([storageKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, projectId, status])
  @@index([companyId, clientId, status])
  @@index([companyId, module, status])
  @@index([projectId])
  @@index([clientId])
  @@index([uploadedByMemberId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([mimeType])
  @@index([extension])
  @@index([updatedAt])
  @@index([companyId, storageStatus])
  @@index([checksum])
  @@map("documents")
}

/// One authorised upload attempt (PRD #29 §64, §68).
///
/// The session is the record of what the server agreed to accept: which key,
/// which member, how many bytes, and until when. Completion is checked against
/// it rather than against whatever the browser claims afterwards
/// (PRD #29 §65, §77, §80).
model DocumentUploadSession {
  id         String @id @default(cuid())
  companyId  String
  documentId String
  memberId   String

  storageKey        String
  expectedFileName  String
  expectedMimeType  String?
  expectedSizeBytes BigInt

  status DocumentUploadSessionStatus @default(CREATED)

  /// Bytes held against the company quota while this session is open, so two
  /// concurrent uploads cannot both squeeze under the same headroom
  /// (PRD #29 §149, §150).
  reservedBytes BigInt @default(0)

  expiresAt   DateTime
  completedAt DateTime?

  /// Reserved for the multipart flow the provider interface already allows
  /// (PRD #29 §124, §125). V0.1 uploads are a single PUT.
  multipartUploadId String?

  /// Repeating a create with the same key returns the same session rather than
  /// opening a second one (PRD #29 §261, §262).
  idempotencyKey String?
  attemptCount   Int     @default(0)

  failureReason String?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  member   CompanyMember @relation("UploadSessionMember", fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storageKey])
  @@unique([companyId, memberId, idempotencyKey])
  @@index([companyId])
  @@index([documentId])
  @@index([memberId])
  @@index([status, expiresAt])
  @@map("document_upload_sessions")
}

/// What a company is allowed to store (PRD #29 §142, §144).
///
/// A null `maxStorageBytes` means no hard ceiling: usage is still measured and
/// shown, the deployment simply has not set one (PRD #29 §145, §151).
model CompanyStorageQuota {
  companyId String @id

  maxStorageBytes    BigInt?
  maxSingleFileBytes BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_storage_quotas")
}

/// What a company is actually storing (PRD #29 §147, §148).
///
/// A projection, maintained on successful upload and physical deletion, so the
/// quota check is one row read rather than a sum over every document. Derived
/// previews are deliberately excluded: the customer-facing number counts the
/// bytes they uploaded (PRD #29 §242, §243).
model CompanyStorageUsage {
  companyId String @id

  usedBytes BigInt @default(0)
  fileCount Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("company_storage_usage")
}

/// Business/user-visible activity. Authentication events go to AuthEvent —
/// the two are never combined (PRD #8 §48).
model Activity {
  id            String  @id @default(cuid())
  companyId     String
  module        String
  entityType    String
  entityId      String
  action        String
  message       String?
  actorMemberId String?
  actorUserId   String?
  metadata      Json?

  /// Ties every record written by one logical workflow together, across
  /// modules and background jobs (PRD #37 §47, PRD #23 §38-§40, PRD #32 §30).
  correlationId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  actorMember CompanyMember? @relation("ActivityActorMember", fields: [actorMemberId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation("ActivityActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
  @@index([correlationId])
  @@map("activities")
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

/// An invitation to join a company (PRD #14 §64, §135).
///
/// Its lifecycle is tracked separately from `CompanyMember.status`, because
/// "this invitation was cancelled" and "this person's access was removed" are
/// different facts about different things.
///
/// Only the hash of the token is stored. The raw token exists solely inside the
/// emailed link, so a database leak cannot be replayed into a membership
/// (PRD #14 §67, §237).
model CompanyInvite {
  id                String              @id @default(cuid())
  companyId         String
  email             String
  userId            String?
  companyMemberId   String?
  roleId            String
  departmentId      String?
  jobTitle          String?
  tokenHash         String              @unique
  status            CompanyInviteStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  cancelledAt       DateTime?
  createdByMemberId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([email])
  @@index([expiresAt])
  @@index([companyMemberId])
  @@map("company_invites")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A server-side session record. The signed cookie carries only this row's id,
/// so revoking access is a delete rather than a wait for a token to expire
/// (PRD #6 §51, §113).
model Session {
  id               String   @id @default(cuid())
  sessionToken     String   @unique
  userId           String
  membershipId     String
  currentCompanyId String
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership CompanyMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company       @relation(fields: [currentCompanyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([membershipId])
  @@index([currentCompanyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Only the hash is stored; the raw token exists solely in the emailed link
/// (PRD #6 §57).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  companyId String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

// ---------------------------------------------------------------------------
// Module test records (PRD #9 §67)
// ---------------------------------------------------------------------------
// Minimal shapes that make the Module Shell testable: list, detail, status,
// scope, approval. Each department module replaces its table when its own PRD
// lands; none of these is a final domain model.

/// Per-company finance configuration (PRD #15 §28).
/// Finance-specific settings only (PRD #24 §124).
///
/// Base currency, fiscal year start and payment terms were duplicated here and
/// on CompanySettings. CompanySettings owns them now, so a company cannot hold
/// two different answers to the same question (PRD #24 §41-§43, PRD #37 §320).
model FinanceSettings {
  id             String   @id @default(cuid())
  companyId      String   @unique
  invoicePrefix  String?
  defaultTaxRate Decimal? @db.Decimal(7, 4)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

/// A customer receivable (PRD #15 §38).
///
/// Totals are columns rather than derived at read time because a historical
/// invoice must keep the numbers it was issued with, whatever later happens to
/// its lines. They are recalculated by the server on every write and never
/// accepted from the browser (PRD #15 §52, §220).
model Invoice {
  id            String  @id @default(cuid())
  companyId     String
  invoiceNumber String
  clientId      String
  projectId     String?

  /// The accepted proposal this invoice was drawn from, when it came from
  /// Sales (PRD #35 §180). Nullable and SetNull: an invoice outlives the
  /// proposal that prompted it, and most invoices have no proposal at all.
  sourceProposalId String?

  issueDate DateTime
  dueDate   DateTime
  currency  String   @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           InvoiceStatus  @default(DRAFT)
  preArchiveStatus InvoiceStatus?

  notes  String?
  sentAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sourceProposal Proposal? @relation("InvoiceSourceProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([clientId])
  @@index([projectId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([currency])
  @@index([updatedAt])
  @@index([sourceProposalId])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A cost incurred by the company, with or without a project (PRD #15 §87).
model Expense {
  id            String  @id @default(cuid())
  companyId     String
  expenseNumber String?
  projectId     String?

  expenseDate DateTime
  category    FinanceCostCategory
  description String
  payeeName   String?

  currency    String  @db.VarChar(3)
  netAmount   Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  status           ExpenseStatus  @default(DRAFT)
  preArchiveStatus ExpenseStatus?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, expenseNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
  @@index([projectId])
  @@index([category])
  @@index([currency])
  @@index([updatedAt])
  @@map("expenses")
}

/// Actual cash movement against exactly one invoice or one expense
/// (PRD #15 §70, §74). Voided rather than deleted, so the trail survives.
model Payment {
  id        String @id @default(cuid())
  companyId String

  direction PaymentDirection
  invoiceId String?
  expenseId String?

  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @db.VarChar(3)
  paymentDate DateTime
  method      PaymentMethod

  reference String?
  notes     String?

  status PaymentStatus @default(RECORDED)

  createdByMemberId String
  voidedByMemberId  String?
  voidedAt          DateTime?
  voidReason        String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, paymentDate])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([direction])
  @@index([currency])
  @@map("payments")
}

/// A versioned project budget (PRD #15 §103, §109).
///
/// An approved budget is never edited; a revision is a new version, and exactly
/// one version per project carries `isCurrent` (PRD #15 §111, §115, §201).
model ProjectBudget {
  id        String @id @default(cuid())
  companyId String
  projectId String

  version          Int
  name             String?
  currency         String        @db.VarChar(3)
  status           BudgetStatus  @default(DRAFT)
  preArchiveStatus BudgetStatus?
  isCurrent        Boolean       @default(false)

  totalAmount Decimal @db.Decimal(18, 2)
  notes       String?

  createdByMemberId  String
  updatedByMemberId  String?
  approvedByMemberId String?
  approvedAt         DateTime?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  lineItems ProjectBudgetLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([projectId, isCurrent])
  @@index([currency])
  @@map("project_budgets")
}

model ProjectBudgetLineItem {
  id       String @id @default(cuid())
  budgetId String

  category      FinanceCostCategory
  description   String
  plannedAmount Decimal             @db.Decimal(18, 2)
  sortOrder     Int                 @default(0)

  budget ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([category])
  @@map("project_budget_line_items")
}

/// Approved future spend not yet recognised as an expense (PRD #15 §124).
///
/// The source columns exist so a future Procurement purchase order can claim
/// the commitment it created rather than a second one appearing beside it
/// (PRD #15 §127).
model Commitment {
  id        String  @id @default(cuid())
  companyId String
  projectId String?

  reference        String?
  description      String
  counterpartyName String?
  category         FinanceCostCategory

  currency String  @db.VarChar(3)
  amount   Decimal @db.Decimal(18, 2)

  expectedDate     DateTime?
  status           CommitmentStatus  @default(DRAFT)
  preArchiveStatus CommitmentStatus?

  sourceModule     String?
  sourceEntityType String?
  sourceEntityId   String?

  notes String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([category])
  @@index([expectedDate])
  @@index([currency])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@map("commitments")
}

/// One approval cycle for one finance record (PRD #15 §137).
///
/// A resubmission creates a new row rather than reopening the old one, so the
/// record's approval history stays readable (PRD #15 §64, §145).
model FinanceApproval {
  id        String @id @default(cuid())
  companyId String

  recordType FinanceApprovalRecordType
  recordId   String

  status FinanceApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("finance_approvals")
}

/// The canonical employment record (PRD #16 §25, §26).
///
/// One per company membership. It carries employment facts — dates, type,
/// manager, hours — and deliberately not identity: a person's name, email and
/// phone belong to their `User`, and their role and department to their
/// `CompanyMember` (PRD #16 §2).
model EmployeeProfile {
  id              String @id @default(cuid())
  companyId       String
  companyMemberId String @unique

  employeeNumber   String?
  employmentStatus EmploymentStatus @default(PLANNED)
  employmentType   EmploymentType   @default(FULL_TIME)

  startDate        DateTime?
  probationEndDate DateTime?
  endDate          DateTime?

  managerMemberId String?
  workLocation    String?
  weeklyHours     Decimal? @db.Decimal(6, 2)

  onboardingStatus  HrProgressStatus @default(NOT_STARTED)
  offboardingStatus HrProgressStatus @default(NOT_REQUIRED)

  createdByMemberId String?
  updatedByMemberId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  companyMember CompanyMember  @relation("EmployeeProfileMember", fields: [companyMemberId], references: [id], onDelete: Restrict)
  managerMember CompanyMember? @relation("EmployeeProfileManager", fields: [managerMemberId], references: [id], onDelete: SetNull)

  compensations     Compensation[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([companyId, employmentType])
  @@index([managerMemberId])
  @@index([startDate])
  @@index([endDate])
  @@map("employee_profiles")
}

/// Pay, behind its own permission (PRD #16 §17, §58).
///
/// Effective-dated rather than overwritten: a raise opens a new record and
/// closes the previous one, so what somebody was paid last year survives
/// (PRD #16 §64, §65).
model Compensation {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String

  currency   String              @db.VarChar(3)
  payType    CompensationPayType
  baseAmount Decimal             @db.Decimal(18, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  notes String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeProfileId])
  @@index([employeeProfileId, effectiveFrom])
  @@index([currency])
  @@map("compensations")
}

model LeaveRequest {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  days      Decimal   @db.Decimal(6, 2)
  reason    String?

  status LeaveRequestStatus @default(DRAFT)

  submittedAt DateTime?

  approvedByMemberId String?
  approvedAt         DateTime?

  rejectedByMemberId String?
  rejectedAt         DateTime?

  cancelledByMemberId String?
  cancelledAt         DateTime?

  decisionNote String?

  createdByMemberId String

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([leaveType])
  @@map("leave_requests")
}

/// Entitlement per employee, type and year (PRD #16 §79).
///
/// `usedDays` is maintained transactionally from approved leave, never sent by
/// a browser: it is the number every "do you have enough days" check reads
/// (PRD #16 §80).
model LeaveBalance {
  id                String    @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String
  leaveType         LeaveType
  year              Int

  entitledDays   Decimal @db.Decimal(6, 2)
  usedDays       Decimal @default(0) @db.Decimal(6, 2)
  adjustmentDays Decimal @default(0) @db.Decimal(6, 2)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, leaveType, year])
  @@index([companyId])
  @@index([companyMemberId])
  @@index([year])
  @@map("leave_balances")
}

/// Daily attendance, not biometric timekeeping (PRD #16 §97).
///
/// The source columns let approved leave write `ON_LEAVE` days and, when that
/// leave is cancelled, take exactly those rows back out again — without
/// touching anything a person entered by hand (PRD #16 §109, §110).
model AttendanceRecord {
  id                String @id @default(cuid())
  companyId         String
  employeeProfileId String
  companyMemberId   String

  date   DateTime
  status AttendanceStatus

  checkIn       DateTime?
  checkOut      DateTime?
  workedMinutes Int?

  notes  String?
  source AttendanceSource @default(MANUAL)

  sourceEntityType String?
  sourceEntityId   String?

  createdByMemberId String
  updatedByMemberId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyMemberId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyMemberId])
  @@index([employeeProfileId])
  @@index([status])
  @@index([sourceEntityType, sourceEntityId])
  @@map("attendance_records")
}

/// A prospective contact nobody has qualified yet (PRD #17 §32, §33).
///
/// A Lead is not a Client. It may name a company that does not exist in the
/// system, an email nobody has replied to, and a value somebody guessed. The
/// canonical Client is created at conversion, through the Clients service —
/// never by copying these fields into a second customer table (PRD #17 §4, §54).
model Lead {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  website     String?

  source           LeadSource
  status           LeadStatus  @default(NEW)
  /// The status to return to on restore, so an archived lead comes back
  /// CONTACTED if that is what it was (PRD #17 §58).
  preArchiveStatus LeadStatus?

  ownerMemberId String?
  notes         String?

  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String?  @db.VarChar(3)

  /// Why the lead went nowhere. Free text rather than an enum, so a company can
  /// say what actually happened without a migration (PRD #17 §421).
  disqualifyReason String?

  /// Conversion lineage (PRD #17 §386, §438). `convertedOpportunity` is the
  /// back-reference of `Opportunity.sourceLeadId`, so one column carries the
  /// link and the two records can never disagree about it.
  convertedAt       DateTime?
  convertedClientId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner   CompanyMember? @relation("LeadOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  convertedClient      Client?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity? @relation("OpportunitySourceLead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, ownerMemberId])
  @@index([companyId, source])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("leads")
}

/// A qualified potential deal (PRD #17 §59, §60).
///
/// `stage` is the commercial outcome and keeps WON or LOST forever; archiving
/// is `archivedAt`, a separate fact, so closing the books on a deal never
/// overwrites how it ended (PRD #17 §61, §62).
model Opportunity {
  id            String  @id @default(cuid())
  companyId     String
  name          String
  clientId      String?
  contactId     String?
  ownerMemberId String

  stage           OpportunityStage  @default(PROSPECTING)
  /// Stage the opportunity held before archiving (PRD #17 §60).
  preArchiveStage OpportunityStage?
  /// When the stage last moved, for pipeline aging (PRD #17 §439, §442).
  stageChangedAt  DateTime          @default(now())

  estimatedValue      Decimal  @db.Decimal(18, 2)
  currency            String   @db.VarChar(3)
  /// 0–100, overriding the stage default when the owner knows better
  /// (PRD #17 §28).
  probabilityOverride Decimal? @db.Decimal(5, 2)

  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  description String?
  nextStep    String?

  sourceLeadId String? @unique

  wonReason  String?
  lostReason LostReason?
  lostNote   String?

  convertedProjectId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   CompanyMember @relation("OpportunityOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)

  sourceLead       Lead?    @relation("OpportunitySourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  convertedProject Project? @relation("OpportunityConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)

  proposals Proposal[]
  contracts Contract[] @relation("ContractSourceOpportunity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, stage])
  @@index([companyId, ownerMemberId])
  @@index([clientId])
  @@index([contactId])
  @@index([convertedProjectId])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("opportunities")
}

/// A commercial offer against an Opportunity (PRD #17 §104).
///
/// A Proposal is not an Invoice. It carries no receivable, settles nothing, and
/// the Finance module never reads it as one (PRD #17 §153).
model Proposal {
  id             String @id @default(cuid())
  companyId      String
  proposalNumber String
  opportunityId  String
  clientId       String

  title    String
  currency String @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  validUntil DateTime?

  status           ProposalStatus  @default(DRAFT)
  preArchiveStatus ProposalStatus?

  notes String?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  lineItems ProposalLineItem[]
  contracts Contract[]         @relation("ContractSourceProposal")
  invoices  Invoice[]          @relation("InvoiceSourceProposal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([opportunityId])
  @@index([clientId])
  @@index([validUntil])
  @@index([currency])
  @@index([updatedAt])
  @@map("proposals")
}

model ProposalLineItem {
  id         String @id @default(cuid())
  proposalId String

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId])
  @@map("proposal_line_items")
}

/// One approval cycle on a Proposal (PRD #17 §128, §129).
///
/// Shaped like FinanceApproval and kept separate on purpose: the two modules
/// grant approval authority through different permissions, and a shared table
/// would make "who may decide this?" a question about a row rather than about a
/// module (PRD #17 §19).
model SalesApproval {
  id        String @id @default(cuid())
  companyId String

  recordType SalesApprovalRecordType
  recordId   String

  status SalesApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("sales_approvals")
}

/// The canonical legal agreement record (PRD #18 §35, §528).
///
/// A Contract is not a Document and not a Proposal. The Proposal is the price
/// somebody offered, the Document is the file that was signed, and this is the
/// agreement's metadata and lifecycle — the only one of the three that has a
/// status, an owner and an expiry (PRD #18 §3).
///
/// `contractValue` and `expiryDate` are *current effective* values. Their
/// history is not overwritten but preserved in ContractAmendment, which is why
/// a signed contract is changed by amendment rather than by edit
/// (PRD #18 §330, §331).
model Contract {
  id             String       @id @default(cuid())
  companyId      String
  contractNumber String
  title          String
  contractType   ContractType

  clientId      String?
  projectId     String?
  /// Sales lineage (PRD #18 §56). Real foreign keys rather than loose ids, so
  /// a contract can never point at an opportunity that no longer exists.
  opportunityId String?
  proposalId    String?

  /// The internal business owner of the record. Ownership is not authority: it
  /// says who answers for the contract, never what they may do (PRD #18 §52).
  ownerMemberId String

  status           ContractStatus  @default(DRAFT)
  /// The status to return to on restore (PRD #18 §135).
  preArchiveStatus ContractStatus?

  /// A snapshot of the other side's legal name. Not the Client's name read
  /// live: the entity that signed is a historical fact (PRD #18 §61, §141).
  counterpartyName String?

  currency      String?  @db.VarChar(3)
  contractValue Decimal? @db.Decimal(18, 2)

  sentAt        DateTime?
  signedDate    DateTime?
  effectiveDate DateTime?
  expiryDate    DateTime?

  renewalType             ContractRenewalType @default(NONE)
  renewalNoticeDays       Int?
  autoRenewalPeriodMonths Int?

  governingLaw String?
  jurisdiction String?

  summary         String?
  /// Permission-gated. Visible only with `legal.commercial.view` (PRD #18 §79).
  commercialNotes String?
  /// Permission-gated. Visible only with `legal.confidential_terms.view`
  /// (PRD #18 §80).
  legalNotes      String?

  terminationDate      DateTime?
  terminationReason    String?
  terminatedByMemberId String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner       CompanyMember @relation("ContractOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  opportunity Opportunity?  @relation("ContractSourceOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal    Proposal?     @relation("ContractSourceProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  parties     ContractParty[]
  obligations ContractObligation[]
  amendments  ContractAmendment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, contractNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expiryDate])
  @@index([clientId])
  @@index([projectId])
  @@index([opportunityId])
  @@index([proposalId])
  @@index([ownerMemberId])
  @@index([contractType])
  @@index([effectiveDate])
  @@index([expiryDate])
  @@index([renewalType])
  @@index([currency])
  @@index([updatedAt])
  @@map("contracts")
}

/// A legal party to an agreement, stored as a snapshot (PRD #18 §137, §141).
///
/// `clientId` is traceability only. The name, legal name and address are what
/// the contract said at signing, so renaming the Client later must not rewrite
/// who signed (PRD #18 §329).
model ContractParty {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  partyRole ContractPartyRole
  partyType ContractPartyType

  name               String
  legalName          String?
  registrationNumber String?
  taxId              String?

  clientId String?

  address String?
  city    String?
  country String?

  signatoryName  String?
  signatoryTitle String?

  /// At most one per contract, enforced by a partial unique index in the
  /// migration and inside the transaction that sets it (PRD #18 §144, §236).
  isPrimaryCounterparty Boolean @default(false)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client   Client?  @relation("ContractPartyClient", fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([contractId])
  @@index([clientId])
  @@index([partyRole])
  @@map("contract_parties")
}

/// A contractual requirement with a date (PRD #18 §149).
///
/// An obligation is not a Task. The obligation is what the agreement requires;
/// a Task is work somebody does to satisfy it, and the Task lives in Tasks
/// where every other piece of work lives (PRD #18 §154).
model ContractObligation {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  title          String
  description    String?
  obligationType ContractObligationType

  responsibleMemberId String?
  dueDate             DateTime?

  status      ContractObligationStatus @default(OPEN)
  completedAt DateTime?

  /// Set when an amendment introduced the obligation (PRD #18 §337).
  sourceAmendmentId String?

  createdByMemberId String
  updatedByMemberId String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  responsibleMember CompanyMember?     @relation("ContractObligationResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  sourceAmendment   ContractAmendment? @relation("ObligationSourceAmendment", fields: [sourceAmendmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([contractId])
  @@index([responsibleMemberId])
  @@index([dueDate])
  @@index([obligationType])
  @@map("contract_obligations")
}

/// A legal change to an approved or signed Contract (PRD #18 §160).
///
/// The amendment does not replace the contract; activating it copies the new
/// value and expiry onto the contract and keeps the previous ones here, which
/// is how the contract carries a current figure and a history at the same time
/// (PRD #18 §174, §175).
model ContractAmendment {
  id         String @id @default(cuid())
  companyId  String
  contractId String

  amendmentNumber String
  title           String
  summary         String

  status ContractAmendmentStatus @default(DRAFT)

  effectiveDate DateTime?
  signedDate    DateTime?

  /// The resulting value is authoritative; the delta is derived from it by the
  /// server so the two can never disagree (PRD #18 §167, §332).
  valueDelta       Decimal?  @db.Decimal(18, 2)
  newContractValue Decimal?  @db.Decimal(18, 2)
  newExpiryDate    DateTime?

  /// What the contract held before this amendment was activated, so activation
  /// is reversible evidence rather than an overwrite (PRD #18 §175).
  previousContractValue Decimal?  @db.Decimal(18, 2)
  previousExpiryDate    DateTime?
  activatedAt           DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  obligations ContractObligation[] @relation("ObligationSourceAmendment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, amendmentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([contractId])
  @@index([effectiveDate])
  @@index([newExpiryDate])
  @@map("contract_amendments")
}

/// One approval cycle on a Contract or an Amendment (PRD #18 §181, §182).
///
/// Shaped like FinanceApproval and SalesApproval and kept separate for the same
/// reason: the three modules grant approval authority through different
/// permissions, and a shared table would make "who may decide this?" a question
/// about a row rather than about a module (PRD #18 §526).
model ContractApproval {
  id        String @id @default(cuid())
  companyId String

  recordType ContractApprovalRecordType
  recordId   String

  status ContractApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("contract_approvals")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Procurement (PRD #19)
 */
/**
 * --------------------------------------------------------------------------
 */

/**
 * A supplier is who we buy from (PRD #19 §10, §26).
 * Deliberately its own record rather than a Client with a flag. A Client is who
 * pays us and a Supplier is who we pay, and the two answer different questions
 * even when the same organisation is both — which V0.1 records twice on purpose
 * (PRD #19 §3, §11).
 */
model Supplier {
  id        String @id @default(cuid())
  companyId String

  code         String?
  name         String
  legalName    String?
  supplierType SupplierType @default(COMPANY)

  email   String?
  phone   String?
  website String?

  taxId              String?
  registrationNumber String?

  address String?
  city    String?
  country String?

  status SupplierStatus @default(ACTIVE)

  /**
   * Used to date an invoice due from a receipt (PRD #19 §39).
   */
  paymentTermsDays Int?
  defaultCurrency  String? @db.VarChar(3)

  notes String?

  /**
   * Lower-cased, punctuation-stripped name for duplicate detection (§31).
   */
  normalizedName String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  rfqSuppliers   RFQSupplier[]
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([name])
  @@index([normalizedName])
  @@index([taxId])
  @@index([registrationNumber])
  @@index([country])
  @@index([updatedAt])
  @@map("suppliers")
}

/**
 * A purchase request is somebody asking to buy something (PRD #19 §41).
 * It is a need, not a commitment. Nothing is owed to anybody until a purchase
 * order is issued, which is why the two are separate records rather than one
 * with a status (PRD #19 §3).
 */
model PurchaseRequest {
  id        String @id @default(cuid())
  companyId String

  requestNumber String
  title         String
  description   String?

  projectId    String?
  departmentId String?

  requestedByMemberId String
  ownerMemberId       String?

  requiredDate DateTime?
  priority     ProcurementPriority @default(MEDIUM)

  currency       String? @db.VarChar(3)
  estimatedTotal Decimal @default(0) @db.Decimal(18, 2)

  status           PurchaseRequestStatus  @default(DRAFT)
  preArchiveStatus PurchaseRequestStatus?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  rejectedAt         DateTime?
  rejectedByMemberId String?
  rejectionReason    String?
  cancelledAt        DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  requestedBy CompanyMember  @relation("PurchaseRequestRequester", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  owner       CompanyMember? @relation("PurchaseRequestOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  items          PurchaseRequestItem[]
  rfqs           RFQ[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([projectId])
  @@index([departmentId])
  @@index([requestedByMemberId])
  @@index([ownerMemberId])
  @@index([requiredDate])
  @@index([priority])
  @@index([updatedAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String @id @default(cuid())
  purchaseRequestId String

  description        String
  quantity           Decimal              @db.Decimal(18, 4)
  unit               String
  estimatedUnitPrice Decimal?             @db.Decimal(18, 4)
  estimatedAmount    Decimal              @default(0) @db.Decimal(18, 2)
  category           ProcurementCategory?
  specification      String?

  sortOrder Int @default(0)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseRequestId])
  @@index([category])
  @@map("purchase_request_items")
}

/**
 * A request for quotation: the same ask, sent to several suppliers (§64).
 */
model RFQ {
  id        String @id @default(cuid())
  companyId String

  rfqNumber String
  title     String

  purchaseRequestId String?
  projectId         String?

  currency        String    @db.VarChar(3)
  responseDueDate DateTime?

  status RFQStatus @default(DRAFT)

  issuedAt    DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdByMemberId String
  updatedByMemberId String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  suppliers      RFQSupplier[]
  items          RFQItem[]
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, rfqNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([purchaseRequestId])
  @@index([projectId])
  @@index([responseDueDate])
  @@index([updatedAt])
  @@map("rfqs")
}

model RFQSupplier {
  id         String @id @default(cuid())
  rfqId      String
  supplierId String

  status      RFQSupplierStatus @default(INVITED)
  invitedAt   DateTime?
  respondedAt DateTime?

  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@map("rfq_suppliers")
}

model RFQItem {
  id                  String  @id @default(cuid())
  rfqId               String
  sourceRequestItemId String?

  description   String
  quantity      Decimal @db.Decimal(18, 4)
  unit          String
  specification String?
  sortOrder     Int     @default(0)

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  quoteItems SupplierQuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([sourceRequestItemId])
  @@map("rfq_items")
}

/**
 * What one supplier answered (PRD #19 §78).
 * A quote is commercially confidential to the buying side: one supplier must
 * never be shown another's price, which is why quote reads are gated separately
 * from the RFQ itself (PRD #19 §260).
 */
model SupplierQuote {
  id         String @id @default(cuid())
  companyId  String
  rfqId      String
  supplierId String

  quoteNumber String?
  quoteDate   DateTime
  validUntil  DateTime?

  currency String @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  leadTimeDays Int?
  deliveryDate DateTime?

  status SupplierQuoteStatus @default(DRAFT)

  disqualificationReason String?
  notes                  String?

  createdByMemberId String
  updatedByMemberId String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items          SupplierQuoteItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([rfqId])
  @@index([supplierId])
  @@index([quoteDate])
  @@index([validUntil])
  @@index([currency])
  @@map("supplier_quotes")
}

model SupplierQuoteItem {
  id              String @id @default(cuid())
  supplierQuoteId String
  rfqItemId       String

  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)
  taxRate   Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  notes String?

  supplierQuote SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  rfqItem       RFQItem       @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierQuoteId, rfqItemId])
  @@index([supplierQuoteId])
  @@index([rfqItemId])
  @@map("supplier_quote_items")
}

/**
 * A purchase order is the commitment (PRD #19 §95).
 * Issuing one is the moment the company owes somebody money, which is why it is
 * also the moment a Finance commitment appears (PRD #19 §116).
 */
model PurchaseOrder {
  id        String @id @default(cuid())
  companyId String

  poNumber   String
  supplierId String

  purchaseRequestId String?
  rfqId             String?
  supplierQuoteId   String?

  projectId           String?
  contractId          String?
  financeCommitmentId String?

  orderDate    DateTime
  requiredDate DateTime?
  currency     String    @db.VarChar(3)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  /**
   * True once somebody edited a line the selected quote priced (§107).
   */
  modifiedFromQuote Boolean @default(false)

  status           PurchaseOrderStatus  @default(DRAFT)
  preArchiveStatus PurchaseOrderStatus?

  notes String?

  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByMemberId String?
  rejectedAt         DateTime?
  rejectedByMemberId String?
  rejectionReason    String?
  issuedAt           DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  rfq             RFQ?             @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  supplierQuote   SupplierQuote?   @relation(fields: [supplierQuoteId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract        Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([projectId])
  @@index([purchaseRequestId])
  @@index([rfqId])
  @@index([supplierQuoteId])
  @@index([contractId])
  @@index([financeCommitmentId])
  @@index([orderDate])
  @@index([requiredDate])
  @@index([currency])
  @@index([updatedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String

  sourceRequestItemId String?
  sourceQuoteItemId   String?

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unit        String

  unitPrice Decimal @db.Decimal(18, 4)
  taxRate   Decimal @db.Decimal(7, 4)

  subtotal    Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([sourceRequestItemId])
  @@index([sourceQuoteItemId])
  @@map("purchase_order_items")
}

/**
 * What actually turned up (PRD #19 §132).
 * Receipts are additive: a correction is a new receipt or a void, never an edit
 * of what was recorded as delivered (PRD #19 §143, §144).
 */
model GoodsReceipt {
  id        String @id @default(cuid())
  companyId String

  receiptNumber   String
  purchaseOrderId String
  projectId       String?
  supplierId      String

  receiptDate       DateTime
  deliveryReference String?

  status GoodsReceiptStatus @default(RECORDED)

  receivedByMemberId String
  notes              String?

  createdByMemberId String
  voidedByMemberId  String?
  voidedAt          DateTime?
  voidReason        String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  receivedBy CompanyMember @relation("GoodsReceiptReceiver", fields: [receivedByMemberId], references: [id], onDelete: Restrict)

  items GoodsReceiptItem[]

  inspectionRequests    InspectionRequest[]
  qualityInspections    QualityInspection[]
  nonConformanceReports NonConformanceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([supplierId])
  @@index([receiptDate])
  @@index([receivedByMemberId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String

  receivedQuantity Decimal @db.Decimal(18, 4)
  acceptedQuantity Decimal @db.Decimal(18, 4)
  rejectedQuantity Decimal @db.Decimal(18, 4)

  notes String?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  inspectionRequests    InspectionRequest[]
  qualityInspections    QualityInspection[]
  materialDecisions     MaterialInspectionDecision[]
  materialReleases      QualityMaterialRelease[]
  nonConformanceReports NonConformanceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

/**
 * One approval cycle, on a request or an order (PRD #19 §148).
 */
model ProcurementApproval {
  id        String @id @default(cuid())
  companyId String

  recordType ProcurementApprovalRecordType
  recordId   String

  status ProcurementApprovalStatus @default(PENDING)

  submittedByMemberId String
  submittedAt         DateTime @default(now())

  decidedByMemberId String?
  decidedAt         DateTime?
  decisionNote      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([recordType, recordId])
  @@index([submittedByMemberId])
  @@index([decidedByMemberId])
  @@index([submittedAt])
  @@map("procurement_approvals")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Inventory (PRD #20)
 */
/**
 * --------------------------------------------------------------------------
 */

/**
 * An inventory item is a *kind* of thing, not a quantity of it (PRD #20 §25).
 * How much exists lives in InventoryBalance, one row per item per location, and
 * every change to it is a row in StockMovement. Putting a `quantity` column on
 * the item is what makes stock figures that nobody can explain.
 */
model InventoryItem {
  id        String @id @default(cuid())
  companyId String

  sku         String
  name        String
  description String?

  category InventoryItemCategory
  /// The unit every movement of this item is measured in. Immutable once stock
  /// exists: changing it would silently reinterpret history (PRD #20 §46).
  baseUnit String

  status InventoryItemStatus @default(ACTIVE)

  minimumStock Decimal? @db.Decimal(18, 4)
  reorderPoint Decimal? @db.Decimal(18, 4)

  defaultWarehouseId String?
  defaultLocationId  String?

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  balances        InventoryBalance[]
  movements       StockMovement[]
  receiptLines    InventoryReceiptLine[]
  issueLines      StockIssueLine[]
  returnLines     StockReturnLine[]
  transferLines   StockTransferLine[]
  adjustmentLines StockAdjustmentLine[]
  reservations    StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, status])
  @@index([category])
  @@index([name])
  @@index([updatedAt])
  @@map("inventory_items")
}

/**
 * Where stock is held (PRD #20 §49).
 */
model Warehouse {
  id        String @id @default(cuid())
  companyId String

  code        String
  name        String
  description String?

  warehouseType WarehouseType
  projectId     String?

  address String?
  city    String?
  country String?

  status WarehouseStatus @default(ACTIVE)

  createdByMemberId  String
  updatedByMemberId  String?
  archivedByMemberId String?
  archivedAt         DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  locations InventoryLocation[]
  balances  InventoryBalance[]
  movements StockMovement[]

  inventoryReceipts InventoryReceipt[]
  stockIssues       StockIssue[]
  stockReturns      StockReturn[]

  transfersFrom StockTransfer[] @relation("StockTransferFromWarehouse")
  transfersTo   StockTransfer[] @relation("StockTransferToWarehouse")

  adjustments  StockAdjustment[]
  reservations StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseType])
  @@index([projectId])
  @@index([city])
  @@map("warehouses")
}

/**
 * A bin, bay or yard inside a warehouse (PRD #20 §61).
 * Balances hang off the location rather than the warehouse, so "where is it"
 * has one answer. Every warehouse gets a default location, because a warehouse
 * with no location has nowhere to put stock (PRD #20 §64).
 */
model InventoryLocation {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String

  code        String
  name        String?
  description String?

  status InventoryLocationStatus @default(ACTIVE)

  /// The one location a warehouse uses when nobody picks another (§64).
  isDefault Boolean @default(false)

  createdByMemberId String
  updatedByMemberId String?
  archivedAt        DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  balances     InventoryBalance[]
  movements    StockMovement[]
  receiptLines InventoryReceiptLine[]
  issueLines   StockIssueLine[]
  returnLines  StockReturnLine[]

  transferFromLines StockTransferLine[] @relation("StockTransferFromLocation")
  transferToLines   StockTransferLine[] @relation("StockTransferToLocation")

  adjustmentLines StockAdjustmentLine[]
  reservations    StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@map("inventory_locations")
}

/**
 * What is where, right now (PRD #20 §79–§83).
 * A projection of the movement ledger, never a source of truth. It exists
 * because summing every movement ever recorded to answer "how many bags of
 * cement are on site" does not scale — but it can always be rebuilt from the
 * ledger, and a repair that disagrees with the ledger is a bug in the
 * projection, never a correction to history (PRD #20 §82, §83).
 * `availableQuantity` is `onHand - reserved`, stored so it can be indexed and
 * filtered on (PRD #20 §76).
 */
model InventoryBalance {
  id              String @id @default(cuid())
  companyId       String
  inventoryItemId String
  warehouseId     String
  locationId      String

  onHandQuantity    Decimal @default(0) @db.Decimal(18, 4)
  reservedQuantity  Decimal @default(0) @db.Decimal(18, 4)
  availableQuantity Decimal @default(0) @db.Decimal(18, 4)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([inventoryItemId, locationId])
  @@index([companyId])
  @@index([warehouseId])
  @@index([inventoryItemId])
  @@index([availableQuantity])
  @@map("inventory_balances")
}

/**
 * The stock ledger (PRD #20 §67, §70, §71).
 * Append-only. A movement is never edited or deleted: a mistake is corrected by
 * a REVERSAL row that points at the one it undoes, so the history of what
 * somebody believed at the time survives the correction.
 * `signedQuantity` carries the direction — negative for anything leaving — so
 * a balance is the sum of a single column rather than a case statement over
 * movement types (PRD #20 §71).
 */
model StockMovement {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  warehouseId     String
  locationId      String

  movementType StockMovementType

  quantity       Decimal @db.Decimal(18, 4)
  signedQuantity Decimal @db.Decimal(18, 4)
  unit           String

  projectId String?

  /// Where this came from, so a movement can always be traced back to the
  /// document that caused it (PRD #20 §179, §291, §292).
  sourceModule     String
  sourceEntityType String
  sourceEntityId   String
  sourceLineId     String?

  reversalOfMovementId String?

  occurredAt       DateTime
  postedByMemberId String

  notes String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  reversalOf StockMovement?  @relation("StockMovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: Restrict)
  reversals  StockMovement[] @relation("StockMovementReversal")

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, occurredAt])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([projectId])
  @@index([movementType])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@index([sourceLineId])
  @@index([reversalOfMovementId])
  @@map("stock_movements")
}

/**
 * Stock coming in, usually from a Procurement delivery (PRD #20 §84).
 */
model InventoryReceipt {
  id        String @id @default(cuid())
  companyId String

  receiptNumber  String
  /// The Procurement goods receipt this was posted from, when there is one.
  /// Unique so one delivery cannot be booked into stock twice (PRD #20 §91).
  goodsReceiptId String?

  warehouseId String

  status InventoryTransactionStatus @default(DRAFT)

  receiptDate DateTime
  postedAt    DateTime?
  reversedAt  DateTime?

  createdByMemberId  String
  postedByMemberId   String?
  reversedByMemberId String?

  notes String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines InventoryReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, receiptNumber])
  @@unique([goodsReceiptId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([warehouseId])
  @@index([postedAt])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id                 String @id @default(cuid())
  inventoryReceiptId String

  goodsReceiptItemId String?

  inventoryItemId String
  locationId      String

  quantity Decimal @db.Decimal(18, 4)
  unit     String

  movementId String?

  notes String?

  inventoryReceipt InventoryReceipt  @relation(fields: [inventoryReceiptId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryReceiptId])
  @@index([goodsReceiptItemId])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([movementId])
  @@map("inventory_receipt_lines")
}

/**
