/// The life of a stored object, from authorised intent to archived
/// (PRD #29 §12, §14). `AVAILABLE` is the only state a download is served in,
/// and nothing reaches it before the object has been verified (PRD #29 §162,
/// §233).
enum DocumentStorageStatus {
  PENDING_UPLOAD
  UPLOADED
  VERIFYING
  SCANNING
  AVAILABLE
  REJECTED
  FAILED
  ARCHIVED
}

/// Malware scan outcome (PRD #29 §56). `NOT_REQUIRED` is what a deployment
/// with no scanner configured records — deliberately distinct from `CLEAN`,
/// which claims a scanner actually looked (PRD #29 §55, §59).
enum DocumentScanStatus {
  NOT_REQUIRED
  PENDING
  SCANNING
  CLEAN
  INFECTED
  ERROR
}

/// Derived-preview state (PRD #29 §50). A failed preview never invalidates the
/// original file (PRD #29 §235, §277).
enum DocumentPreviewStatus {
  NOT_REQUIRED
  PENDING
  GENERATING
  READY
  FAILED
}

/// One authorised upload attempt (PRD #29 §67).
enum DocumentUploadSessionStatus {
  CREATED
  UPLOADING
  COMPLETED
  EXPIRED
  ABORTED
  FAILED
}

