<?xml version="1.0" encoding="utf-8"?>
<!-- MOB-11 §153, §155: nothing NESTO keeps on the device is copied to a cloud or adb backup. The WebView cookie jar,
     IndexedDB (the sealed offline database) and the Keystore-wrapped preferences must never be restored onto another
     device. allowBackup is also false; these rules cover the platforms that read them anyway. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
