# NESTO V0.1 — copy to .env and fill in.
# Secrets never belong in the repository (PRD #6 §106).

# PostgreSQL. Use a separate database per environment; integration tests must
# never run against development, staging or production data (PRD #9 §125).
DATABASE_URL="postgresql://USER@localhost:5432/nesto_erp?schema=public"

# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_NAME="NESTO"

# Public origin — used by metadata, sitemap.xml, robots.txt and reset links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The shared password for the 16 seeded demo accounts (PRD #9 §25).
# Development and test only — production must never carry demo credentials.
NESTO_DEMO_PASSWORD="nesto1234"

# Required alongside a non-development NODE_ENV before the demo seed will run
# at all. Both guards must be satisfied (PRD #9 §6).
# ALLOW_DEMO_SEED=true
