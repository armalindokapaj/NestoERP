# NESTO V0.1 — copy to .env and fill in.
# Secrets never belong in the repository (PRD #6 §106).

# PostgreSQL. Use a separate database per environment; integration tests must
# never run against development, staging or production data (PRD #9 §125).
DATABASE_URL="postgresql://USER@localhost:5432/nesto_erp?schema=public"

# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_NAME="NESTO"

# Public origin — used by metadata, sitemap.xml, robots.txt and reset links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The shared password for the 16 seeded demo accounts (PRD #9 §25).
# Development and test only — production must never carry demo credentials.
NESTO_DEMO_PASSWORD="nesto1234"

# Required alongside a non-development NODE_ENV before the demo seed will run
# at all. Both guards must be satisfied (PRD #9 §6).
# ALLOW_DEMO_SEED=true

# Documents and file storage (PRD #13, PRD #29)
#
# All of it is deployment configuration. Storage credentials must never live in
# the database, and no company administrator configures a bucket (PRD #29 §113,
# §246).

# local  filesystem, for development, test and CI. Refused in production.
# s3     any private S3-compatible bucket: AWS S3, Cloudflare R2, MinIO,
#        Backblaze B2, DigitalOcean Spaces.
STORAGE_DRIVER=local

# --- local driver ----------------------------------------------------------
# Where objects are written. Outside the web root and never served statically:
# the only way to read one is a short-lived signed URL that the download or
# preview service issues after the full permission check (PRD #29 §8).
DOCUMENT_STORAGE_ROOT=.storage

# Signs those short-lived URLs. Falls back to AUTH_SECRET; set it separately to
# rotate storage grants without invalidating every session (PRD #29 §113).
# STORAGE_URL_SECRET="run: openssl rand -base64 32"

# --- s3 driver -------------------------------------------------------------
# The bucket must block public access and anonymous listing, enforce TLS, and
# encrypt at rest. Use a separate bucket per environment — never share one with
# development content (PRD #29 §8, §110, §115, §182, §309).
# STORAGE_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
# STORAGE_REGION="eu-central-1"
# STORAGE_BUCKET="nesto-production-documents"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_SESSION_TOKEN=""
# MinIO and some gateways need path-style addressing. Default: true.
# STORAGE_FORCE_PATH_STYLE=true

# --- malware scanning ------------------------------------------------------
# none   no scanner. Files record NOT_REQUIRED — deliberately not CLEAN,
#        because nothing looked at them (PRD #29 §13, §56).
# eicar  recognises the standard antivirus test signature. Real, and what the
#        malware tests run against; not a substitute for an engine (§373).
# When a scanner is configured, a file does not become downloadable until the
# verdict is CLEAN, and an unreachable scanner leaves it pending (§55, §59).
STORAGE_SCANNER=none

# Mail (PRD #38 §10-§12) — see docs/runbooks/mail-delivery.md
#
# memory    captures messages in process memory (default; development and tests)
# console   prints them to the log
# resend    Resend's HTTPS API
# postmark  Postmark's HTTPS API
# Production refuses memory and console. Staging with a real provider must set
# MAIL_ALLOWED_RECIPIENTS; anyone else is recorded as SUPPRESSED, never mailed.
MAIL_PROVIDER=memory
# MAIL_FROM="NESTO <no-reply@mail.example.com>"
# MAIL_API_KEY=""
# MAIL_ALLOWED_RECIPIENTS="qa@example.com,@example.com"
# Postmark only. Default: outbound.
# MAIL_POSTMARK_STREAM=outbound

# Team (PRD #14)
# The origin every emailed link is built from — invitations, reset links and
# notification emails. Taken from configuration, never from a request Host
# header, so a spoofed host cannot redirect a link to somebody else's site.
# Falls back to NEXT_PUBLIC_APP_URL, then NEXT_PUBLIC_SITE_URL.
# APP_URL="http://localhost:3000"
# How long an invitation stays valid. Default: 7 days.
# TEAM_INVITE_EXPIRY_DAYS=7

# Finance (PRD #15)
# Nothing is required: the company's finance settings — base currency, payment
# terms, fiscal year start — live in the database and are edited at
# /finance/settings.
