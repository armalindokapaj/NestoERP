{
  "name": "nesto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --turbopack",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db/destructive.ts migrate",
    "db:deploy": "prisma migrate deploy",
    "db:push": "tsx scripts/db/destructive.ts push",
    "db:seed": "prisma db seed",
    "seed:armaar": "tsx prisma/seed/armaar/index.ts",
    "db:studio": "prisma studio",
    "db:reset:demo": "tsx scripts/db/destructive.ts reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:security": "vitest run tests/security",
    "test:security:links": "SECURITY_DESTRUCTIVE=1 vitest run tests/security/foreign-links.test.ts",
    "test:architecture": "vitest run tests/architecture",
    "test:state": "vitest run tests/integration/transactions/transitions.test.ts",
    "test:workers": "vitest run tests/api/jobs tests/architecture/workers.test.ts",
    "test:auth": "vitest run tests/unit/auth tests/integration/auth tests/integration/security/throttle.test.ts",
    "test:transactions": "vitest run tests/integration/transactions",
    "test:e2e": "playwright test",
    "test:e2e:prod": "NEXT_DIST_DIR=.next-e2e next build --turbopack && NEXT_DIST_DIR=.next-e2e E2E_PORT=3100 playwright test",
    "test:e2e:all-browsers": "E2E_ALL_BROWSERS=1 playwright test",
    "verify:roles": "tsx scripts/verify-roles.ts",
    "verify:authorization": "tsx scripts/verify-authorization.ts",
    "verify:ownership": "tsx scripts/verify-ownership.ts",
    "verify:state": "tsx scripts/verify-state.ts",
    "verify:workers": "tsx scripts/verify-workers.ts",
    "verify:company-integrity": "tsx scripts/verify-company-integrity.ts",
    "verify:organization": "tsx scripts/verify-organization.ts",
    "verify:employment": "tsx scripts/verify-employment.ts",
    "verify:employee-integrity": "tsx scripts/verify-employee-integrity.ts",
    "verify:demo": "tsx scripts/verify-demo.ts",
    "verify:workflows": "tsx scripts/verify-workflow-consistency.ts",
    "repair:employment": "tsx scripts/repair-employment.ts",
    "security:matrix": "tsx scripts/security/api-matrix.ts",
    "perf:d10": "tsx scripts/perf/d10-generate.ts",
    "security:access-manifest": "tsx scripts/security/access-manifest.ts",
    "security:access-manifest:check": "tsx scripts/security/access-manifest.ts --check",
    "postinstall": "prisma generate",
    "db:drift": "tsx scripts/db/drift.ts",
    "verify:production-guards": "tsx scripts/verify-production-guards.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "retention:dry-run": "tsx scripts/retention.ts --dry-run",
    "storage:maintenance": "tsx scripts/storage-maintenance.ts",
    "storage:maintenance:apply": "tsx scripts/storage-maintenance.ts --apply",
    "notifications:dispatch": "tsx scripts/notifications.ts",
    "worker": "tsx scripts/worker.ts",
    "access:sync": "tsx scripts/access-sync.ts",
    "company:bootstrap": "tsx scripts/company-bootstrap.ts",
    "native:sync": "tsx scripts/native/configure.ts && cap sync",
    "native:ios": "pnpm native:sync && cap open ios",
    "native:android": "pnpm native:sync && cap open android",
    "native:assets": "tsx scripts/native/make-assets.ts && capacitor-assets generate --assetPath native/assets --iconBackgroundColor \"#15171c\" --splashBackgroundColor \"#15171c\" && rm -rf icons public/manifest.webmanifest"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/privacy-screen": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.1.0",
    "@date-fns/tz": "^1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.44.0",
    "mapbox-gl": "^3.27.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^6.2.108",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "19.1.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "fake-indexeddb": "^6.2.5",
    "prisma": "^6",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "pnpm": ">=9.15.4 <10"
  }
}
