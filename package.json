{
  "name": "nesto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --turbopack",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "seed:armaar": "tsx prisma/seed/armaar/index.ts",
    "db:studio": "prisma studio",
    "db:reset:demo": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:security": "vitest run tests/security",
    "test:security:links": "SECURITY_DESTRUCTIVE=1 vitest run tests/security/foreign-links.test.ts",
    "test:architecture": "vitest run tests/architecture",
    "test:state": "vitest run tests/integration/transactions/transitions.test.ts",
    "test:workers": "vitest run tests/api/jobs tests/architecture/workers.test.ts",
    "test:auth": "vitest run tests/unit/auth tests/integration/auth tests/integration/security/throttle.test.ts",
    "test:transactions": "vitest run tests/integration/transactions",
    "test:e2e": "playwright test",
    "test:e2e:prod": "NEXT_DIST_DIR=.next-e2e next build --turbopack && NEXT_DIST_DIR=.next-e2e E2E_PORT=3100 playwright test",
    "test:e2e:all-browsers": "E2E_ALL_BROWSERS=1 playwright test",
    "verify:roles": "tsx scripts/verify-roles.ts",
    "verify:authorization": "tsx scripts/verify-authorization.ts",
    "verify:ownership": "tsx scripts/verify-ownership.ts",
    "verify:state": "tsx scripts/verify-state.ts",
    "verify:workers": "tsx scripts/verify-workers.ts",
    "verify:company-integrity": "tsx scripts/verify-company-integrity.ts",
    "verify:organization": "tsx scripts/verify-organization.ts",
    "verify:employment": "tsx scripts/verify-employment.ts",
    "verify:demo": "tsx scripts/verify-demo.ts",
    "repair:employment": "tsx scripts/repair-employment.ts",
    "security:matrix": "tsx scripts/security/api-matrix.ts",
    "postinstall": "prisma generate",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$DATABASE_URL\" --exit-code && echo 'no drift'",
    "verify:production-guards": "tsx scripts/verify-production-guards.ts",
    "retention:dry-run": "tsx scripts/retention.ts --dry-run",
    "storage:maintenance": "tsx scripts/storage-maintenance.ts",
    "storage:maintenance:apply": "tsx scripts/storage-maintenance.ts --apply",
    "notifications:dispatch": "tsx scripts/notifications.ts",
    "worker": "tsx scripts/worker.ts",
    "access:sync": "tsx scripts/access-sync.ts",
    "company:bootstrap": "tsx scripts/company-bootstrap.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4",
    "lucide-react": "^1.44.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
